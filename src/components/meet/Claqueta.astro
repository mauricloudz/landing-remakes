---
// Etiqueta tipo claqueta: texto mono en mayúsculas con una tira rayada delante.
// Solo se usa sobre fondos oscuros (menta sobre espresso); nunca sobre crema ni ámbar.
// "pastilla" le da borde y fondo (la etiqueta se vuelve una forma que puede viajar como ancla).
// "sale" y "entra" marcan el número del ancla de salida y de llegada en el mazo.
interface Props { class?: string; pastilla?: boolean; sale?: number; entra?: number }
const { class: clase = '', pastilla = false, sale, entra } = Astro.props;
---
<p class:list={['claqueta', { pastilla }, clase]} data-ancla-sale={sale} data-ancla-entra={entra}><span class="rotulo"><slot /></span></p>
<style>
  .claqueta { display: inline-flex; align-items: center; gap: 12px; font: 700 12px/1.3 "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase; color: var(--acento); }
  .claqueta::before { content: ""; flex: none; width: 26px; height: 14px; border: 1px solid currentColor; background: repeating-linear-gradient(135deg, currentColor 0 4px, transparent 4px 8px); }
  .claqueta.pastilla { border: 1px solid var(--linea); border-radius: 999px; padding: 8px 16px 8px 12px; background: rgb(31 25 20 / .85); }
</style>
