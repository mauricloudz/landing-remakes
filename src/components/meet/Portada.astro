---
// Portada generada en SVG para cada evento, según su motivo.
import type { Motivo } from '../../data/meet';
interface Props { motivo: Motivo; colores: [string, string]; class?: string; titulo: string }
const { motivo, colores: [c1, c2], class: clase = '', titulo } = Astro.props;
const id = `g-${motivo}`;
---
<svg viewBox="0 0 400 260" class:list={['portada', clase]} role="img" aria-label={`Portada de ${titulo}`} preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color={c1} /><stop offset="1" stop-color={c2} /></linearGradient>
    <pattern id={`${id}-p`} width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.4" fill="#fff" opacity=".18" /></pattern>
  </defs>
  <rect width="400" height="260" fill={`url(#${id})`} />
  <rect width="400" height="260" fill={`url(#${id}-p)`} />
  {motivo === 'base-datos' && (
    <g fill="none" stroke="#fff" stroke-width="5" class="flota">
      {[0, 1, 2].map((i) => (
        <g transform={`translate(${130 + i * 70} ${150 - i * 26})`} opacity={1 - i * 0.22}>
          <ellipse cx="0" cy="0" rx="42" ry="14" /><path d="M-42 0v56c0 8 19 14 42 14s42-6 42-14V0" /><path d="M-42 28c0 8 19 14 42 14s42-6 42-14" />
        </g>
      ))}
    </g>
  )}
  {motivo === 'red' && (
    <g class="flota">
      {[[90, 70], [90, 130], [90, 190], [200, 95], [200, 165], [310, 130]].map(([x, y], i, arr) => (
        <>
          {i < 3 && [3, 4].map((j) => <line x1={x} y1={y} x2={arr[j][0]} y2={arr[j][1]} stroke="#fff" stroke-width="2.5" opacity=".55" class="pulso" style={`animation-delay:${(i + j) * 0.25}s`} />)}
          {(i === 3 || i === 4) && <line x1={x} y1={y} x2="310" y2="130" stroke="#fff" stroke-width="2.5" opacity=".55" />}
          <circle cx={x} cy={y} r="16" fill="#fff" />
        </>
      ))}
    </g>
  )}
  {motivo === 'tablero' && (
    <g class="flota">
      {[0, 1, 2].map((c) => (
        <g transform={`translate(${70 + c * 92} 50)`}>
          <rect width="78" height="170" rx="12" fill="#fff" opacity=".16" />
          {Array.from({ length: 3 - c + 1 }).map((_, r) => <rect x="9" y={12 + r * 40} width="60" height="30" rx="7" fill="#fff" opacity={0.9 - r * 0.15} />)}
        </g>
      ))}
    </g>
  )}
</svg>
<style>
  .portada .flota { animation: flota-p 7s ease-in-out infinite; transform-box: fill-box; }
  .portada .pulso { stroke-dasharray: 6 8; animation: datos 1.6s linear infinite; }
  @keyframes flota-p { 50% { translate: 0 -8px; } }
  @keyframes datos { to { stroke-dashoffset: -28; } }
</style>
