---
// Cabecera compartida por el índice y las páginas de evento: los enlaces apuntan a `${raiz}#id`.
import { enlaces } from '../../data/meet';
const base = import.meta.env.BASE_URL;
const raiz = `${base}meet-and-coffee/`;
---
<header class="cab">
  <nav class="cab-nav" aria-label="Principal">
    <a href={raiz} class="cab-logo">
      <img src={`${base}favicon-meet.svg`} alt="" width="30" height="30" /> Meet &amp; Coffee
    </a>
    <div class="lw cab-lw">
      <ul class="cab-enlaces" role="list">
        {enlaces.map(([t, h]) => <li><a href={`${raiz}#${h}`}>{t}</a></li>)}
      </ul>
    </div>
    <a href={`${raiz}#proxima`} class="cab-cta">Reservar mi lugar</a>
    <button class="cab-menu" popovertarget="menu-meet">Menú</button>
    <div id="menu-meet" popover class="menu-meet">
      <button popovertarget="menu-meet" popovertargetaction="hide" class="menu-cerrar">Cerrar ✕</button>
      <ul role="list">
        {enlaces.map(([t, h]) => <li><a href={`${raiz}#${h}`}>{t}</a></li>)}
      </ul>
    </div>
  </nav>
</header>
<style>
  /* Altura fija de 64px: las escenas fijas de la portada reservan ese hueco arriba */
  .cab { position: sticky; top: 0; z-index: 50; height: 64px; background: rgb(20 16 13 / .94); border-bottom: 1px solid rgb(246 237 227 / .08); }
  .cab-nav { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: 20px; padding: 0 clamp(18px, 5vw, 72px); }
  .cab-logo { display: flex; align-items: center; gap: 10px; font-family: var(--fuente-display); font-size: 19px; font-weight: 800; letter-spacing: -.02em; }
  .cab-logo img { border-radius: 9px; }
  /* Los enlaces llevan 14 px de relleno a cada lado y el contenedor lo compensa con margen: el texto queda donde estaba
     y la píldora (que se desliza detrás del enlace activo) tiene cuerpo alrededor de cada palabra */
  .cab-lw { display: none; margin-inline: -14px; --pill-bg: var(--marca); --pill-fg: var(--espresso); }
  .cab-enlaces { display: flex; align-items: center; gap: 0; font-size: 14px; font-weight: 500; color: var(--suave); }
  .cab-enlaces a { display: block; padding: 8px 14px; border-radius: 999px; transition: color .3s var(--friccion); }
  .cab-enlaces a:hover { color: var(--tinta); }
  .cab-cta { display: none; border-radius: 999px; background: var(--marca); padding: 10px 20px; font-size: 14px; font-weight: 600; color: var(--espresso); transition: background-color .3s var(--friccion), transform .3s var(--friccion); }
  .cab-cta:hover { background: var(--marca-fuerte); transform: translateY(-2px); }
  .cab-menu { border: 1px solid #7a6a5c; border-radius: 999px; padding: 8px 18px; font-size: 14px; font-weight: 500; color: var(--tinta); cursor: pointer; }
  @media (min-width: 1024px) {
    .cab-lw { display: block; }
    .cab-cta { display: inline-flex; }
    .cab-menu { display: none; }
  }
  .menu-meet { margin: 0 0 0 auto; height: 100dvh; width: min(84vw, 320px); background: var(--superficie); padding: 24px; color: var(--tinta); border: 0; }
  .menu-meet::backdrop { background: rgb(0 0 0 / .6); }
  .menu-meet:popover-open { animation: entrar-m .4s var(--friccion); }
  .menu-cerrar { margin-bottom: 32px; font-size: 14px; color: var(--suave); cursor: pointer; }
  .menu-meet ul { display: grid; gap: 20px; font-family: var(--fuente-display); font-size: 26px; font-weight: 700; }
  @keyframes entrar-m { from { transform: translateX(100%); } }
  /* Safari 16 y anteriores no tienen Popover API: sin ella el panel se vería siempre. Se oculta, y el script de abajo
     alterna la clase "abierto" (el panel se coloca a mano porque aquí no hay capa superior ni ::backdrop) */
  @supports not selector(:popover-open) {
    #menu-meet { display: none; }
    #menu-meet.abierto { display: block; position: fixed; inset: 0 0 0 auto; z-index: 100; overflow-y: auto; box-shadow: 0 0 0 100vmax rgb(0 0 0 / .6); animation: entrar-m .4s var(--friccion); }
  }
  /* Controles nativos y barras de desplazamiento oscuros (la cabecera está en el índice y en cada evento) */
  :global(html.tema-meet) { color-scheme: dark; }
</style>
<script>
  // Al elegir una sección en el menú móvil, se cierra para no quedar tapando la página
  let sinPopover: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    const menu = document.getElementById('menu-meet');
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover?.()));

    // Sin Popover API (Safari 16): el panel se abre y se cierra con la clase "abierto"; con la API nativa no se toca nada
    sinPopover?.abort();
    if (!menu || Object.prototype.hasOwnProperty.call(HTMLElement.prototype, 'popover')) return;
    sinPopover = new AbortController();
    const { signal } = sinPopover;
    const abrir = document.querySelector<HTMLElement>('.cab-menu');
    const poner = (on: boolean) => {
      menu.classList.toggle('abierto', on);
      abrir?.setAttribute('aria-expanded', String(on));
    };
    poner(false);
    document.querySelectorAll<HTMLElement>('[popovertarget="menu-meet"]').forEach((b) =>
      b.addEventListener('click', () => poner(b.getAttribute('popovertargetaction') === 'hide' ? false : !menu.classList.contains('abierto')), { signal }),
    );
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => poner(false), { signal }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') poner(false); }, { signal });
  });
</script>
