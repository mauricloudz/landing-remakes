  @keyframes onda { from { transform: scale(.4); opacity: .9; } to { transform: scale(2.6); opacity: 0; } }
  /* Bucle infinito: única excepción permitida a linear (movimiento continuo, sin aceleración).
     Periodo del patrón = 12 + 10 = 22 unidades del viewBox; el ciclo desplaza 3 periodos (66)
     para que el reinicio caiga exactamente en la misma posición visual. */
  .metro { animation: metro 3s linear infinite; }
  @keyframes metro { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -66; } }
  .pin { position: absolute; left: 50%; top: 50%; width: 46px; height: 46px; translate: -50% -50%; border-radius: 50%; background: var(--marca); border: 2.5px solid var(--crema); display: grid; place-items: center; }
  .pin svg { position: static; width: 26px; height: 26px; }
  .vig { position: absolute; inset: 0; background: radial-gradient(ellipse 70% 70% at 50% 50%, transparent 40%, rgb(13 10 8 / .82)); pointer-events: none; }
  .m-tit { padding: 70px var(--pad) 28px; }
  .donde-plano { padding: 70px var(--pad) 40px; }
  .donde h2 { margin-top: 14px; max-width: 14ch; font-size: clamp(40px, min(8vw, 13svh), 132px); line-height: .88; }
  .m-card { position: relative; z-index: 2; max-width: 760px; margin-top: 24px; border: 1px solid var(--linea); border-radius: 24px; background: rgb(31 25 20 / .94); padding: 26px 30px; }
  .m-card h3 { margin-top: 14px; font-size: clamp(30px, 4vw, 56px); }
  .m-card p { max-width: 46ch; margin: 16px 0 0; font-size: 18px; color: var(--claro); }
  .m-card dl { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 520px; margin: 24px 0 0; }
  .m-card dl div { border: 1px solid var(--linea); border-radius: 14px; background: rgb(31 25 20 / .92); padding: 16px 18px; }
  .m-card dt { font: 500 11px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase; color: var(--suave); }
  .m-card dd { margin: 4px 0 0; font: 700 21px var(--fuente-display); letter-spacing: -.02em; }
  @media (max-width: 820px) { .m-card dl { grid-template-columns: 1fr; } }

  /* ---------- 6 · Eventos anteriores ---------- */
  .eventos { background: var(--fondo); border-top: 1px solid var(--linea); }
  .eventos-plano { padding: clamp(40px, 6svh, 70px) var(--pad); }
  .e-head h2 { max-width: 22ch; margin-top: 12px; font-size: clamp(34px, 4.6vw, 68px); }
  .pasos-grid { display: grid; gap: 20px; margin: clamp(20px, 4svh, 40px) auto 0; width: 100%; max-width: 1360px; }
  .evento-paso { min-width: 0; }
  .card { position: relative; display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); height: 100%; min-height: 340px; overflow: clip; border: 1px solid #4a3e33; border-radius: 20px; background: var(--superficie); transition: border-color .3s var(--friccion); }
