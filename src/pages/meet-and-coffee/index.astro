  .card a:focus-visible { outline: 0; }
  .cov { position: relative; overflow: clip; background: var(--espresso); }
  .cov .cv { position: absolute; inset: 0; width: 100%; height: 100%; transition: scale .7s var(--friccion); }
  .fig { position: absolute; left: 14px; top: 12px; border-radius: 4px; background: var(--crema); padding: 4px 9px; font: 700 11px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--espresso); }
  .inf { display: flex; flex-direction: column; min-height: 0; padding: clamp(22px, 3vw, 44px); }
  .reg { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin: 0; font: 500 12px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--suave); }
  .contador { display: inline-flex; border: 1px solid var(--linea); border-radius: 999px; background: var(--espresso); padding: 6px 12px; }
  .contador b { font-weight: 700; color: var(--acento); }
  .inf h3 { margin-top: clamp(12px, 3svh, 26px); font-size: clamp(30px, min(4vw, 7svh), 58px); }
  .inf h3 a::after, .abierta h3 a::after { content: ""; position: absolute; inset: 0; z-index: 1; }
  .baj { max-width: 34ch; margin: 14px 0 0; font-size: clamp(16px, 1.35vw, 19px); color: var(--claro); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; padding: 0; list-style: none; }
  .tags li { border: 1px solid var(--linea); border-radius: 999px; padding: 4px 12px; font: 500 12px "JetBrains Mono Variable", ui-monospace, monospace; color: var(--tinta); }
  .tags li::before { content: "#"; color: var(--marca); }
  .by { margin: auto 0 0; padding-top: 14px; font-size: 14px; color: var(--claro); }
  .by b { color: var(--tinta); }
  .go { margin: 10px 0 0; font-size: 14px; font-weight: 600; color: var(--marca); }
  .abierta { grid-template-rows: 1fr; display: grid; place-items: center; border: 2px dashed #7a6a5c; background: var(--fondo); padding: 30px; text-align: center; }
  .abierta .mas { margin: 0; font: 800 clamp(64px, 10vw, 120px)/.8 var(--fuente-display); color: var(--marca); }
  .abierta h3 { margin-top: 14px; font-size: clamp(28px, 4vw, 54px); }
  .reg-a { margin: 12px 0 0; font: 500 12px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--acento); }
  .abierta:hover, .abierta:has(a:focus-visible) { border-color: var(--marca); }
  @media (hover: hover) {
    .card:hover { border-color: var(--marca); }
    .card:hover .cv { scale: 1.05; }
  }
  @media (max-width: 900px) {
    .card { grid-template-columns: 1fr; min-height: 0; }
    .cov { aspect-ratio: 400 / 260; }
    .inf { padding: 18px 18px 20px; }
    .inf h3 { font-size: 30px; margin-top: 12px; }
    .baj { margin-top: 8px; font-size: 15px; }
    .tags, .by span { display: none; }
  }

  /* ---------- 7 · Propón una charla ---------- */
  .propon { background: var(--espresso); }
  .propon .plano { padding: clamp(60px, 10vw, 140px) var(--pad); }
  .p-in { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(30px, 6vw, 96px); align-items: center; max-width: 1280px; margin: 0 auto; }
  .p-texto h2 { margin-top: 18px; font-size: clamp(44px, min(7vw, 14svh), 112px); line-height: .88; }
  .p-texto h2 em { font-style: normal; color: var(--marca); }
  .p-texto .l { max-width: 42ch; margin: 24px 0 0; font-size: 18px; color: var(--claro); }
  .form { display: grid; gap: 16px; border: 1px solid var(--linea); border-radius: 24px; background: var(--superficie); padding: clamp(22px, 3vw, 40px); }
  .form .two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form label, .form legend { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; }
  .form input[type=text], .form input[type=email] { width: 100%; border: 1px solid var(--borde); border-radius: 14px; background: var(--espresso); padding: 13px 15px; font-size: 15px; color: var(--tinta); }
  .form input[type=text]:focus, .form input[type=email]:focus { border-color: var(--marca); }
  .form fieldset { min-width: 0; margin: 0; border: 0; padding: 0; }
  .form .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .form .chips label { margin: 0; cursor: pointer; border: 1px solid var(--borde); border-radius: 999px; padding: 9px 16px; transition: background-color .25s var(--friccion), color .25s var(--friccion); }
  .form .chips label:has(:checked) { border-color: var(--marca); background: var(--marca); color: var(--espresso); }
  .form .chips label:has(:focus-visible) { outline: 3px solid var(--acento); outline-offset: 3px; }
  .form .btn { width: 100%; }
  .form small { text-align: center; font-size: 12.5px; color: var(--suave); }
  .p-error { margin: 0; font-size: 14px; font-weight: 600; color: var(--marca-fuerte); }
  .p-gracias { padding: 48px 0 6px; text-align: center; font: 800 32px/1.1 var(--fuente-display); letter-spacing: -.03em; }
  .p-demo { text-align: center; color: var(--suave); }

  /* ---------- 8 · Preguntas (maestro-detalle en escritorio; acordeón en el móvil) ---------- */
  .preguntas { background: var(--fondo); }
  .preguntas .plano { padding: clamp(40px, 6vw, 90px) var(--pad); }
  .f-plano { max-width: 1280px; margin: 0 auto; width: 100%; }
  .f-plano h2 { font-size: clamp(40px, 5.6vw, 92px); line-height: .9; margin: 0 0 clamp(16px, 4svh, 40px); }
  .faq { position: relative; border-top: 1px solid var(--tinta); }
  .pregunta { border-bottom: 1px solid var(--linea); }
  .pregunta summary { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; cursor: pointer; list-style: none; padding: 1.6rem 1.25rem; font-family: var(--fuente-display); font-weight: 300; font-size: clamp(1.3rem, 2.4vw, 1.9rem); letter-spacing: -.02em; line-height: 1.15; }
  .pregunta summary::-webkit-details-marker { display: none; }
  .pregunta summary::before { content: ""; position: absolute; inset: 0; border-radius: 16px; background: color-mix(in srgb, var(--marca) 8%, transparent); clip-path: inset(0 100% 0 0 round 16px); transition: clip-path .5s var(--friccion); }
  .pregunta[open] summary::before { clip-path: inset(0 0 0 0 round 16px); }
  .pregunta summary .mask, .pregunta summary .icono { position: relative; }
  .pregunta summary .mask { flex: 1; transition: color .4s var(--friccion); }
  .pregunta[open] summary .mask { color: var(--marca-fuerte); font-weight: 400; }
  .barra-activa { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; border-radius: 4px 0 0 4px; background: var(--marca); transform: scaleY(0); transform-origin: 50% 0; transition: transform .5s var(--friccion); }
  .pregunta[open] .barra-activa { transform: scaleY(1); }
  .pregunta .icono { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: color-mix(in srgb, var(--marca) 12%, transparent); color: var(--marca-fuerte); font-size: 1.6rem; line-height: 1; transition: background-color .4s var(--friccion), color .4s var(--friccion), transform .6s var(--friccion); }
  .pregunta[open] .icono { background: var(--marca); color: #fff; transform: rotate(45deg); }
  .respuesta { color: var(--suave); font-size: clamp(.9rem, 1vw, 1rem); line-height: 1.6; }
  .respuesta p { margin: 0; }
  .respuesta .resp-num { margin: 0 0 .9rem; color: var(--marca-fuerte); }
  .respuesta .mask { display: block; overflow: hidden; padding-block: .14em .22em; margin-block: -.14em -.22em; }
  .pregunta .respuesta .sube { transform: translateY(-170%); transition: transform .25s var(--encastre); }
  .pregunta[open] .respuesta .sube { transform: none; transition: transform .6s var(--friccion); }
  details.pregunta::details-content { transition: content-visibility .3s allow-discrete, block-size .5s var(--friccion); overflow: clip; }
  details.pregunta[open]::details-content { block-size: auto; }
  details.pregunta:not([open])::details-content { block-size: 0; }
  @starting-style { details.pregunta[open]::details-content { block-size: 0; } }
  .pregunta .respuesta { padding: 0 3.5rem 1.8rem 0; }
  @media (min-width: 900px) {
    .faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); column-gap: var(--hueco-faq); min-height: 18rem; }
    .f-plano h2 { grid-column: 1 / -1; }
    .pregunta { grid-column: 1; }
    /* Panel de respuesta: columna derecha, sobre la lista (todas las respuestas ocupan el mismo sitio; solo se ve la abierta) */
    .pregunta .respuesta {
      position: absolute; top: 0; bottom: 0;
      left: calc((100% - var(--hueco-faq)) / 2.2 + var(--hueco-faq));
      width: calc((100% - var(--hueco-faq)) * 1.2 / 2.2);
      padding: clamp(.6rem, 1.8svh, 1.2rem) 0 0 2.2rem;
      border-left: 1px solid color-mix(in srgb, var(--tinta) 35%, transparent);
    }
    .respuesta .resp-num { margin-bottom: 1.1rem; }
    .respuesta .resp-texto { font-family: var(--fuente-display); font-weight: 300; font-size: clamp(1.35rem, 2vw, 1.9rem); line-height: 1.3; letter-spacing: -.015em; color: var(--tinta); max-width: 30ch; }
    .pregunta::details-content { block-size: auto; }
    .pregunta:not([open])::details-content { block-size: auto; }
    .pregunta summary::after { content: ""; position: absolute; left: 100%; top: 50%; width: var(--hueco-faq); height: 1px; background: var(--marca); transform: scaleX(0); transform-origin: 0 50%; transition: transform .5s var(--friccion); }
    .pregunta[open] summary::after { transform: scaleX(1); }
  }

  /* ---------- 9 · Créditos (Pie) ---------- */
  .fin-escena { background: var(--espresso); }
  .vinetas { display: flex; justify-content: center; gap: 16px; margin-top: 30px; }
  .vinetas i { width: 14px; height: 14px; border-radius: 50%; background: var(--marca); }

  /* ---------- Cabecera y puntos (solo en el modo mazo) ---------- */
  .puntos-nav { display: none; }

  /* ---------- Base: móvil y tableta ---------- */
  @media (max-width: 1023px) {
    .c-grid { grid-template-columns: minmax(0, 1fr); }
    .g1, .g2 { display: flex; flex-direction: column; gap: 22px; }
    .poster, .ticket, .c-slate, .cred, .bio, .resumen, .llevar { grid-column: auto; grid-row: auto; }
    .poster { width: min(100%, 340px); height: auto; margin: 0 auto; }
    .c-slate { justify-self: center; }
    .llevar { margin-top: 0; }
    .ticket { max-width: 420px; width: 100%; margin: 0 auto; }
  }
  @media (max-width: 820px) {
    .stage { grid-template-columns: minmax(0, 1fr); align-items: start; min-height: 0; padding: 40px var(--pad) 48px; }
    .taza-caja { grid-column: 1; grid-row: 2; justify-self: center; margin: 32px 0; width: min(60vw, 40svh); }
    .hl { white-space: normal; font-size: clamp(26px, 7.6vw, 52px); }
    .chip { padding: 8px 12px; font-size: 11px; }
    .ctas { width: 100%; flex-direction: column; }
    .ctas .btn { width: 100%; }
    .p-in { grid-template-columns: 1fr; }
    .form .two { grid-template-columns: 1fr; }
  }
  @media (min-width: 1024px) {
    .c-grid { grid-template-columns: auto minmax(0, 1fr) minmax(300px, 360px); }
  }

  /* =====================================================================
     MODO MAZO · html.escenas
     Una escena a la vez, a pantalla completa. Tres fases por cambio:
     1 despedida (los textos suben y se cierran) → 2 morph (anclas) → 3 llegada (los textos suben).
     ===================================================================== */

  html.escenas, html.escenas body { overflow: hidden; height: 100%; overscroll-behavior: none; }
  html.escenas .cab { position: fixed; inset: 0 0 auto 0; view-transition-name: cabecera; }
  html.escenas .diapo { position: fixed; inset: 0; overflow: hidden auto; overscroll-behavior: contain; padding: var(--nav) 0 0; box-sizing: border-box; margin: 0; display: none; background: var(--fondo); }
  html.escenas .diapo.activa { display: block; }
  html.escenas .diapo > .plano { height: 100%; box-sizing: border-box; display: flex; flex-direction: column; justify-content: safe center; gap: clamp(.8rem, 2.6svh, 2rem); max-width: none; padding: clamp(12px, 3svh, 36px) calc(var(--pad) + 40px) clamp(18px, 4svh, 44px) var(--pad); }
  html.escenas .diapo h1[tabindex="-1"], html.escenas .diapo h2[tabindex="-1"] { outline: none; }
  html.escenas .puntos-nav { display: block; position: fixed; z-index: 40; right: clamp(10px, 1.6vw, 22px); top: 50%; translate: 0 -50%; view-transition-name: puntos; background: var(--fondo); border: 1px solid var(--linea); border-radius: 999px; padding: 10px 6px; box-shadow: 0 6px 20px rgb(0 0 0 / .4); }
  html.escenas .puntos-nav ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  html.escenas .puntos-nav a { position: relative; display: block; width: 24px; height: 24px; border-radius: 50%; }
  html.escenas .puntos-nav a::before { content: ""; position: absolute; inset: 6px; border-radius: 50%; border: 1.5px solid var(--tinta); transition: background-color .4s var(--friccion), transform .4s var(--friccion); }
  html.escenas .puntos-nav a:hover::before { transform: scale(1.2); }
  html.escenas .puntos-nav a[aria-current="true"]::before { background: var(--tinta); transform: scale(1.25); }
  html.escenas .puntos-nav a:focus-visible { outline: 2px solid var(--marca); outline-offset: 3px; }
  html.escenas .puntos-nav a:focus-visible { outline-color: var(--marca); }
  html.escenas .cuenta { background: var(--cafe); }
  html.escenas .cafe-capa { position: absolute; inset: 0; }
  html.escenas .cuenta-plano { padding-right: var(--pad); }
  html.escenas .cafe-sup { display: block; }

  /* ---- Fase 1 · despedida ---- */
  /* Los .sube salen hacia arriba dentro de su máscara; los .revela se cierran; los rótulos se borran.
     Las anclas no tienen texto suelto: se quedan como formas. 240 ms en total, con 12 ms entre textos. */
  html.escenas .diapo.saliendo .sube { transform: translateY(-170%); transition: transform calc(240ms - min(var(--k, 0), 8) * 12ms) var(--encastre) calc(min(var(--k, 0), 8) * 12ms); }
  html.escenas .diapo.saliendo .revela { clip-path: inset(0 0 100% 0); transition: clip-path .24s var(--encastre); }
  html.escenas .diapo.saliendo .rotulo { clip-path: inset(0 100% 0 0); transition: clip-path .24s var(--encastre); }
  html.escenas .rotulo { clip-path: inset(0 0 0 0); }
  html.escenas .diapo.saliendo .lbl { visibility: hidden; }

  /* ---- Fase 2 · morph: la escena que llega queda en "llegando" (solo formas, sin texto en la captura) ---- */
  html.escenas .diapo.llegando .sube { transform: translateY(170%); }
  html.escenas .diapo.llegando .revela { clip-path: inset(100% 0 0 0); }
  html.escenas .diapo.llegando .rotulo { clip-path: inset(0 100% 0 0); }
  html.escenas .diapo.llegando .lbl { visibility: hidden; }

  /* ---- Fase 3 · llegada: los textos suben desde sus máscaras; los rótulos se abren ---- */
  html.escenas .diapo.entrando .sube { animation: sube .9s var(--friccion) both; animation-delay: calc(var(--k, 0) * 30ms); }
  html.escenas .diapo.entrando .revela { animation: revela .9s var(--friccion) both; animation-delay: calc(var(--k, 0) * 30ms); }
  html.escenas .diapo.entrando .rotulo { animation: rotulo-abre .6s var(--friccion) both; }
  html.escenas[data-dir="atras"] .diapo.entrando .rotulo { animation-name: rotulo-abre-der; }
  html.escenas .diapo.entrando .lbl { animation: revela .9s var(--friccion) both; }
  @keyframes sube { from { transform: translateY(170%); } }
  @keyframes revela { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rotulo-abre { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rotulo-abre-der { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0 0 0 0); } }

  /* ---- Apertura de la portada (solo carga directa en #inicio): sin retraso en el titular ---- */
  @keyframes abre-sube { from { transform: translateY(170%); } }
  @keyframes abre-cafe { from { clip-path: inset(100% 0 0 0 round 0); } }
  html.escenas.abriendo .hero .h1 .mask > .sube { animation: abre-sube .62s var(--friccion) both; }
  html.escenas.abriendo .hero .h1 .hl:nth-child(2) .mask > .sube { animation-delay: 40ms; }
  html.escenas.abriendo .hero .h1 .hl:nth-child(3) .mask > .sube { animation-delay: 80ms; }
  html.escenas.abriendo .hero .chip .rotulo { animation: rotulo-abre .6s var(--friccion) .24s both; }
  html.escenas.abriendo .hero .ctas .btn { animation: revela .6s var(--friccion) .3s both; }
  html.escenas.abriendo .hero .taza-caja { animation: abre-taza .9s var(--friccion) .3s both; }
  html.escenas.abriendo .cab { animation: abre-cabecera .8s var(--friccion) both; }
  html.escenas.abriendo .puntos-nav { animation: abre-puntos .8s var(--friccion) .15s both; }
  @keyframes abre-taza { from { transform: translateY(40%); } }
  @keyframes abre-cabecera { from { transform: translateY(-110%); } }
  @keyframes abre-puntos { from { transform: translateX(160%); } }

  /* ---- Morph: raíz y anclas ---- */
  html.escenas::view-transition-group(root), html.escenas::view-transition-image-pair(root) { animation: none; inset: 0; width: 100%; height: 100%; }
  html.escenas::view-transition-old(root) { animation: none; opacity: 1; transform: none; inset: 0; width: 100%; height: 100%; mix-blend-mode: normal; }
  html.escenas::view-transition-new(root) { animation: funde-raiz .45s var(--encastre) both; inset: 0; width: 100%; height: 100%; mix-blend-mode: normal; }
  /* Sin figuras: el fondo del destino se funde bajo las anclas (ambas capturas ya no tienen texto) */
  @keyframes funde-raiz { from { opacity: 0; } }

  /* Cuatro pares de anclas, con 45 ms de desfase entre parejas */
  html.escenas { --escalon: 45ms; }
  html.escenas::view-transition-group(ancla-1) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: 0ms; z-index: 5; }
  html.escenas::view-transition-group(ancla-2) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: var(--escalon); z-index: 5; }
  html.escenas::view-transition-group(ancla-3) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: calc(2 * var(--escalon)); z-index: 5; }
  html.escenas::view-transition-group(ancla-4) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: calc(3 * var(--escalon)); z-index: 5; }
  html.escenas::view-transition-image-pair(ancla-1) { isolation: isolate; overflow: hidden; animation: radio-1 .8s var(--friccion) both; }
  html.escenas::view-transition-image-pair(ancla-2) { isolation: isolate; overflow: hidden; animation: radio-2 .8s var(--friccion) both; }
  html.escenas::view-transition-image-pair(ancla-3) { isolation: isolate; overflow: hidden; animation: radio-3 .8s var(--friccion) both; }
  html.escenas::view-transition-image-pair(ancla-4) { isolation: isolate; overflow: hidden; animation: radio-4 .8s var(--friccion) both; }
  @keyframes radio-1 { from { border-radius: var(--ar-sale-1, 0px); } to { border-radius: var(--ar-entra-1, 0px); } }
  @keyframes radio-2 { from { border-radius: var(--ar-sale-2, 0px); } to { border-radius: var(--ar-entra-2, 0px); } }
  @keyframes radio-3 { from { border-radius: var(--ar-sale-3, 0px); } to { border-radius: var(--ar-entra-3, 0px); } }
  @keyframes radio-4 { from { border-radius: var(--ar-sale-4, 0px); } to { border-radius: var(--ar-entra-4, 0px); } }
  html.escenas::view-transition-old(ancla-1), html.escenas::view-transition-new(ancla-1),
  html.escenas::view-transition-old(ancla-2), html.escenas::view-transition-new(ancla-2),
  html.escenas::view-transition-old(ancla-3), html.escenas::view-transition-new(ancla-3),
  html.escenas::view-transition-old(ancla-4), html.escenas::view-transition-new(ancla-4) { animation: none; height: 100%; width: 100%; object-fit: cover; mix-blend-mode: normal; }
  html.escenas::view-transition-old(ancla-1), html.escenas::view-transition-old(ancla-2),
  html.escenas::view-transition-old(ancla-3), html.escenas::view-transition-old(ancla-4) { opacity: 0; }
  html.escenas::view-transition-new(ancla-1), html.escenas::view-transition-new(ancla-2),
  html.escenas::view-transition-new(ancla-3), html.escenas::view-transition-new(ancla-4) { opacity: 1; }
  html.escenas::view-transition-group(cabecera), html.escenas::view-transition-group(puntos) { animation: none; z-index: 10; }
  html.escenas::view-transition-old(cabecera), html.escenas::view-transition-new(cabecera),
  html.escenas::view-transition-old(puntos), html.escenas::view-transition-new(puntos) { animation: none; }
  /* La captura nueva de la cabecera es en vivo (la píldora se desliza en ella); la vieja se oculta para que no se transparente su píldora */
  html.escenas::view-transition-old(cabecera) { opacity: 0; }

  /* ---- Escena 1 · Inicio ---- */
  html.escenas .hero .stage { position: absolute; inset: 0; min-height: 0; display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); align-content: center; align-items: center; padding: calc(var(--nav) + 20px) max(var(--pad), calc((100% - 1280px) / 2)) 40px; }
  html.escenas .hero .taza-caja { width: min(30vw, 46svh); }
  html.escenas .hero .h1 { font-size: clamp(32px, min(4.6vw, 8.4svh), 84px); }
  html.escenas .hero .bajo { margin-top: clamp(16px, 4svh, 28px); }
  /* Teléfono: los puntos van abajo, al centro, y cada escena deja sitio para ellos */
  @media (max-width: 820px) {
    html.escenas .puntos-nav { top: auto; bottom: 10px; left: 50%; right: auto; translate: -50% 0; padding: 4px 8px; }
    html.escenas .puntos-nav ol { display: flex; gap: 0; }
    html.escenas .diapo > .plano { padding-bottom: 74px; padding-right: var(--pad); }
    html.escenas .hero .stage { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto auto; align-content: start; padding: calc(var(--nav) + 14px) var(--pad) 70px; gap: clamp(10px, 2.4svh, 22px); }
    html.escenas .hero .taza-caja { grid-column: 1; grid-row: 2; justify-self: center; margin: 0; width: min(54vw, 30svh); }
    html.escenas .hero .h-text { grid-column: 1; grid-row: 1; }
    html.escenas .hero .h1 { font-size: clamp(26px, min(8.4vw, 6.4svh), 44px); }
    html.escenas .hero .hl { white-space: normal; }
    html.escenas .hero .bajo { grid-column: 1; grid-row: 3; margin-top: 0; width: 100%; }
