  .rotador { display: block; height: 1.2em; margin: 6px 0; overflow: hidden; white-space: nowrap; font: 800 clamp(26px, 3.4vw, 44px)/1.2 var(--fuente-display); letter-spacing: -.03em; color: var(--marca-fuerte); }
