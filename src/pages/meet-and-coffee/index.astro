  /* ---------- 5 · Dónde ---------- */
  .donde { background: var(--espresso); }
  .mapa { position: relative; width: 100%; aspect-ratio: 8 / 5; overflow: clip; background: #1c1611; }
  .mapa svg { position: absolute; inset: 0; width: 100%; height: 100%; }
