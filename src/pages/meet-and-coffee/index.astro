  html.escenas #proxima .g1.sale.atras, html.escenas #proxima .g2.sale.atras { animation-name: paso-sale-atras; }

  /* ---- Escena 4 · La noche: un panel por hora ---- */
  html.escenas .noche-plano { padding-right: calc(var(--pad) + 40px); justify-content: center; }
  html.escenas .noche .n-slate { align-self: flex-start; justify-self: start; }
