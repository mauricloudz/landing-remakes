  .palabra-r.saliendo { transform: translateY(-100%); opacity: 0; }
  .palabra-r.entrando { transform: translateY(100%); opacity: 0; transition: none; }

  /* ---------- 3 · Próxima charla ---------- */
  .charla { background: var(--espresso); }
  .charla .plano { overflow: clip; padding: 70px var(--pad); }
  .foco { position: absolute; inset: -10% -10% 20% -10%; background: radial-gradient(ellipse 45% 55% at 30% 20%, rgb(242 154 74 / .28), transparent 70%); pointer-events: none; }
  .c-grid { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(300px, 360px); grid-template-rows: auto auto auto auto auto; column-gap: clamp(28px, 4vw, 64px); align-items: center; max-width: 1380px; margin: 0 auto; }
  .g1, .g2 { display: contents; }
  .poster { grid-column: 1; grid-row: 1 / span 5; position: relative; display: flex; flex-direction: column; justify-content: space-between; height: min(68svh, 590px); aspect-ratio: 2 / 3; overflow: hidden; border-radius: 6px; padding: 24px 22px 22px; background: linear-gradient(170deg, #7a3a14 0, #2a170d 48%, #0d0a08 100%); box-shadow: 0 30px 80px rgb(0 0 0 / .6), 0 0 0 1px rgb(246 237 227 / .18); }
  .poster::after { content: ""; position: absolute; inset: 10px; border: 1px solid rgb(246 237 227 / .28); border-radius: 3px; pointer-events: none; }
  .poster .pre { margin: 0; text-align: center; font: 700 11px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .22em; text-transform: uppercase; color: var(--tinta); }
  .poster svg { flex: 1; min-height: 0; width: 100%; margin: 10px 0; }
  .poster-txt { text-align: center; }
  .poster h2 { font-size: clamp(34px, min(3.6vw, 6svh), 56px); line-height: .88; text-align: center; }
  .poster .por, .poster .pie { margin: 0; font: 700 11px "JetBrains Mono Variable", ui-monospace, monospace; text-transform: uppercase; letter-spacing: .2em; color: var(--tinta); }
  .poster .por { margin-top: 12px; }
  .poster .pie { margin-top: 12px; font-size: 10.5px; letter-spacing: .12em; color: var(--claro2); }
  .c-slate { grid-column: 2; grid-row: 1; justify-self: start; }
