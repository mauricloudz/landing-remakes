  .h1 { margin: 0; font-family: var(--fuente-display); font-size: clamp(32px, min(4.6vw, 8.4svh), 84px); line-height: .92; letter-spacing: -.045em; }
  .hl { display: block; white-space: nowrap; }
  .bajo { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; margin-top: 28px; }
  .chip { display: inline-flex; align-items: center; gap: 10px; margin: 0; border: 1px solid var(--linea); border-radius: 999px; background: rgb(31 25 20 / .8); padding: 9px 16px; font: 500 12px "JetBrains Mono Variable", ui-monospace, monospace; color: var(--suave); }
