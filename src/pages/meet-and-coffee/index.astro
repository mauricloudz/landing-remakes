    html.escenas .noche .programa { display: flex; grid-area: prog; flex-direction: column; justify-content: center; min-width: 0; }
    /* Pantallas bajas: la hora del panel más pequeña, para que la escena entera quepa sin desplazarse */
    html.escenas .pn .hora { font-size: clamp(56px, min(10vw, 15svh), 150px); }
  }
  .programa { --fila: 76px; }
  .programa-tit { margin: 0 0 14px; font: 700 12px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .2em; text-transform: uppercase; color: var(--suave); }
  .programa-lista { position: relative; margin: 0; padding: 0; list-style: none; }
  /* La barra ámbar viaja a la fila actual: solo transform, con la curva de llegada */
  .programa-lista::before { content: ""; position: absolute; left: -22px; top: 0; width: 4px; height: var(--fila); border-radius: 4px; background: var(--marca); transform: translateY(calc(var(--paso, 0) * var(--fila))); transition: transform .8s var(--friccion); }
  .programa-lista li { margin: 0; }
  .pr-fila { box-sizing: border-box; display: flex; align-items: center; gap: clamp(14px, 1.6vw, 22px); width: 100%; height: var(--fila); padding: 0 6px 0 4px; border: 0; border-top: 1px solid var(--linea); background: transparent; text-align: left; cursor: pointer; }
  .programa-lista li:last-child .pr-fila { border-bottom: 1px solid var(--linea); }
  .pr-fila:focus-visible { outline: 3px solid var(--acento); outline-offset: -3px; border-radius: 6px; }
  .pr-hora, .pr-tit { position: relative; display: block; min-width: 0; }
  .pr-hora { flex: none; width: 3.6em; font: 700 clamp(20px, 2vw, 26px)/1.1 "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: -.02em; }
  .pr-tit { flex: 1; font: 700 clamp(17px, 1.6vw, 21px)/1.15 var(--fuente-display); letter-spacing: -.02em; }
  /* Cada fila tiene el texto atenuado (--suave, AA) y debajo, el mismo texto encendido; el encendido se revela con clip-path */
  .pr-dim { display: block; color: var(--suave); }
  .pr-lit { position: absolute; inset: 0; display: block; clip-path: inset(0 100% 0 0); transition: clip-path .6s var(--friccion); }
  .pr-hora .pr-lit { color: var(--marca); }
  .pr-tit .pr-lit { color: var(--tinta); }
  .pr-fila[aria-current="step"] .pr-lit { clip-path: inset(0 0 0 0); }
  .pr-tit .pr-dim, .pr-tit .pr-lit { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 1023px) { html.escenas .programa { display: none; } }
  @media (max-width: 820px) {
