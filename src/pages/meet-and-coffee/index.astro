  .cafe-capa::before { content: ""; position: absolute; inset: 0; background: repeating-radial-gradient(circle at 50% 118%, rgb(246 237 227 / .07) 0 2px, transparent 2px 46px); }
  .cuenta-plano { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 90px var(--pad); }
  .cd-caja { margin-top: 26px; border: 1px solid rgb(246 237 227 / .14); border-radius: 28px; background: rgb(20 16 13 / .45); padding: clamp(14px, 3svh, 28px) clamp(18px, 4vw, 48px); }
  .cd { display: flex; align-items: flex-start; justify-content: center; gap: clamp(6px, 2vw, 28px); font-family: "JetBrains Mono Variable", ui-monospace, monospace; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--tinta); }
  .cd .g { display: flex; flex-direction: column; align-items: center; }
