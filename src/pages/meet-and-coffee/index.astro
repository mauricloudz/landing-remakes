  /* Pasos del móvil: el paso que sale se cierra con clip y el que llega se abre desde su borde superior */
  @keyframes paso-entra { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes paso-entra-atras { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes paso-sale { to { clip-path: inset(0 0 100% 0); } }
  @keyframes paso-sale-atras { to { clip-path: inset(100% 0 0 0); } }
  html.escenas #proxima .g1.llega, html.escenas #proxima .g2.llega { animation: paso-entra .6s var(--friccion) both; }
  html.escenas #proxima .g1.llega.atras, html.escenas #proxima .g2.llega.atras { animation-name: paso-entra-atras; }
