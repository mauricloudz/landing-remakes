  html.escenas .pn { padding: clamp(14px, 3svh, 30px) clamp(18px, 3vw, 40px); max-width: 720px; }
  html.escenas .pn .hora { font-size: clamp(56px, min(12vw, 22svh), 170px); }
  html.escenas .pn h3 { font-size: clamp(26px, min(3.4vw, 6svh), 52px); }
