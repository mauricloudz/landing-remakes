  .stage { position: relative; display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); align-items: center; column-gap: clamp(28px, 4vw, 64px); min-height: calc(100svh - var(--nav)); padding: 96px max(var(--pad), calc((100% - 1280px) / 2)) 72px; }
