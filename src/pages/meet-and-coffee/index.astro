  .revela[hidden] { display: none; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; border-radius: 999px; padding: 15px 26px; font-size: 15px; font-weight: 600; line-height: 1.2; cursor: pointer; transition: transform .3s var(--friccion), background-color .3s var(--friccion), border-color .3s var(--friccion); }
  .btn-a { background: var(--marca); color: var(--espresso); border: 0; }
  .btn-a:hover { background: var(--marca-fuerte); transform: translateY(-2px); }
  .btn-o { border: 1px solid #7a6a5c; color: var(--tinta); }
  .btn-o:hover { border-color: var(--tinta); }
  .diapo h1[tabindex="-1"]:focus, .diapo h2[tabindex="-1"]:focus { outline: none; }
  .solo-mov, .pista-hint, .rail, .calor, .n-slate-fijo, .programa { display: none; }

  /* ---------- 1 · Inicio ---------- */
  .hero { background: var(--fondo); }
