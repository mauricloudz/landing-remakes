  html.escenas .noche .pn.llega.atras h3 .sube, html.escenas .noche .pn.llega.atras p .sube { animation-name: paso-sube-atras; }
  html.escenas .noche .pn.sale h3 .sube, html.escenas .noche .pn.sale p .sube { animation: paso-sale-t .22s var(--encastre) both; }
  html.escenas .noche .pn.sale.atras h3 .sube, html.escenas .noche .pn.sale.atras p .sube { animation-name: paso-sale-t-atras; }
  @keyframes odo-entra { from { transform: translateY(100%); } }
  @keyframes odo-entra-atras { from { transform: translateY(-100%); } }
