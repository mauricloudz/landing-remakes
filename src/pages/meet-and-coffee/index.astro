  .tk-b input { flex: 1; min-width: 0; border: 0; border-radius: 999px; background: var(--crema); padding: 13px 16px; font-size: 15px; color: var(--espresso); }
  .tk-b input::placeholder { color: #6b5a4c; }
  .tk-b button { border: 0; border-radius: 999px; background: var(--espresso); padding: 0 18px; font-size: 14px; font-weight: 600; color: var(--crema); cursor: pointer; }
  .tk-b small { display: block; margin-top: 12px; font-size: 12.5px; font-weight: 500; }
  /* Lámina holográfica (src/scripts/holo.ts): una capa dentro de cada mitad, para respetar las muescas del ticket.
     Es la mitad de intensa que en la maqueta: en reposo el ticket sigue siendo ámbar y solo toma color al inclinarse.
     pointer-events: none, así el correo y el botón siguen operables. */
  .ticket { --px: .5; --py: .5; --act: 0; }
  .ticket.activo { will-change: transform; }
  .holo { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .holo::before, .holo::after, .holo i { content: ""; position: absolute; inset: 0; }
  .holo::before { /* lámina iridiscente: su posición sigue al puntero */
    background: linear-gradient(115deg, #f29a4a 0%, #7fd1b9 18%, #b79cff 36%, #f29a4a 54%, #7fd1b9 72%, #b79cff 90%, #f29a4a 100%);
    background-size: 240% 240%; background-position: calc(var(--px) * 100%) calc(var(--py) * 100%);
    mix-blend-mode: color; opacity: calc(.1 + .18 * var(--act));
  }
  .holo::after { /* brillo especular en el punto del puntero */
    background: radial-gradient(circle 130px at calc(var(--sx, 50) * 1px) calc(var(--sy, 50) * 1px), rgb(255 255 255 / .85), rgb(255 255 255 / .2) 45%, transparent 72%);
    mix-blend-mode: soft-light; opacity: calc(.5 * var(--act));
  }
  .holo i { /* grano fino */
    background: radial-gradient(circle at 1px 1px, rgb(255 255 255 / .95) .5px, transparent .95px) 0 0 / 3px 3px, radial-gradient(circle at 2px 3px, rgb(0 0 0 / .9) .5px, transparent .95px) 1px 1px / 5px 5px;
    mix-blend-mode: overlay; opacity: .12;
  }

  /* ---------- 4 · La noche ---------- */
  .noche { background: var(--fondo); border-block: 1px solid var(--linea); }
