  html.escenas .rail { display: block; position: relative; left: 0; right: 0; height: 28px; margin-top: clamp(10px, 3svh, 30px); }
  html.escenas .rail .ln, html.escenas .rail .fill { position: absolute; left: 0; right: 0; top: 13px; height: 2px; background: var(--linea); }
  html.escenas .rail .fill { background: var(--marca); transform-origin: 0 50%; transform: scaleX(calc(var(--paso, 0) / (var(--n) - 1))); transition: transform .8s var(--friccion); }
  html.escenas .rail .tk { position: absolute; top: 0; left: calc(var(--i) / (var(--n) - 1) * 100%); width: 0; display: flex; flex-direction: column; align-items: center; font: 500 11px "JetBrains Mono Variable", ui-monospace, monospace; color: var(--suave); }
  html.escenas .rail .tk::before { content: ""; width: 2px; height: 10px; margin-bottom: 22px; background: var(--linea); }
  html.escenas .rail .tk .rotulo { transform: translateX(calc((1 - 2 * var(--i) / (var(--n) - 1)) * 50%)); white-space: nowrap; }
  html.escenas .rail .marker { position: absolute; left: calc(var(--paso, 0) / (var(--n) - 1) * 100%); top: -4px; z-index: 2; width: 30px; height: 30px; margin-left: -15px; transition: left .8s var(--friccion); }
  html.escenas .rail .ln, html.escenas .rail .fill { translate: 0 0; }
  html.escenas .noche .pn { grid-area: 1 / 1; visibility: hidden; }
  html.escenas .noche .pn.actual, html.escenas .noche .pn.sale, html.escenas .noche .pn.llega { visibility: visible; z-index: 1; }
