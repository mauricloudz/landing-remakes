---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/jetbrains-mono';
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/meet/Cabecera.astro';
import Pie from '../../components/meet/Pie.astro';
import Taza from '../../components/meet/Taza.astro';
import Portada from '../../components/meet/Portada.astro';
import Claqueta from '../../components/meet/Claqueta.astro';
import { proxima, agenda, eventos, iniciales as sacarIniciales } from '../../data/meet';

const base = import.meta.env.BASE_URL;
const rotativos = ['IA', 'Big Data', 'Cloud', 'Frontend', 'Seguridad'];
const preguntas = [
  { p: '¿Cuánto cuesta?', r: 'Nada. Solo pedimos que reserves tu lugar para saber cuánto café preparar.' },
  { p: '¿Necesito saber programar?', r: 'No. Las charlas parten desde cero y siempre hay alguien dispuesto a explicar lo que no se entendió.' },
  { p: '¿Puedo ir con alguien?', r: 'Claro. Cada reserva es por persona, así que pídele que reserve la suya.' },
  { p: '¿Cómo propongo una charla?', r: 'Con el formulario de esta página. Respondemos todas las propuestas, aunque no queden en la agenda.' },
];
const niveles = ['Principiante', 'Intermedio', 'Avanzado'];
// Escenas del mazo, en orden. El nombre lo lee el lector de pantalla en el navegador de escenas.
const escenas = [
  ['inicio', 'Portada'], ['cuenta', 'Cuenta atrás'], ['proxima', 'Próxima charla'], ['noche', 'La noche'], ['donde', 'Dónde'],
  ['eventos', 'Eventos anteriores'], ['propon', 'Propón una charla'], ['preguntas', 'Preguntas'], ['fin', 'Créditos'],
];
const iniciales = sacarIniciales(proxima.orador.nombre);
const dosDigitos = (n: number) => String(n).padStart(2, '0');
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'Meet & Coffee',
  description: 'Comunidad de charlas y encuentros sobre tecnología en Santiago.',
  url: new URL(`${base}meet-and-coffee/`, Astro.site).toString(),
  address: { '@type': 'PostalAddress', streetAddress: 'Calle Baker 133', addressLocality: 'Providencia', addressRegion: 'Santiago', addressCountry: 'CL' },
};
---
<Base titulo="Meet & Coffee · Charlas de tecnología con café" descripcion="Charlas, eventos y simposios sobre tecnología, martes y viernes de 19:00 a 22:00 en Providencia, Santiago. Gratis y para todos los niveles." tema="meet" jsonLd={jsonLd}>
  <Fragment slot="head">
    <!-- Decide el modo mazo antes del primer pintado (mismas condiciones que el script del módulo).
         Sin hash y con movimiento permitido, la portada se abre con su entrada (clase abriendo, 1,5 s). -->
    <script is:inline>
      (function () {
        var h = document.documentElement;
        var hash = location.hash.slice(1);
        h.dataset.inicio = hash;
        var mazo = !!document.startViewTransition && matchMedia('(prefers-reduced-motion: no-preference)').matches && innerHeight >= 560;
        if (!mazo) return;
        h.classList.add('escenas');
        if (!hash) {
          h.classList.add('abriendo');
          setTimeout(function () { h.classList.remove('abriendo'); }, 1500);
        }
      })();
    </script>
  </Fragment>
  <Cabecera />
  <main id="contenido">
    <!-- 1 · INICIO: titular a la izquierda y taza a la derecha. La superficie del café es el ancla que se zambulle -->
    <section id="inicio" class="diapo hero activa" aria-labelledby="t-hero">
      <div class="plano">
        <div class="stage">
          <div class="h-text">
            <Claqueta class="h-slate" pastilla>Escena 00 — Apertura</Claqueta>
            <h1 id="t-hero" class="h1" tabindex="-1">
              <span class="hl l1"><span class="mask"><span class="sube">Lo último en tecnología,</span></span></span>
              <span class="hl l2"><span class="mask"><span class="sube">con un <span class="enf">café</span></span></span></span>
              <span class="hl l3"><span class="mask"><span class="sube">en la mano.</span></span></span>
            </h1>
            <div class="bajo">
              <p class="chip" data-ancla-sale="2"><i aria-hidden="true"></i><span class="rotulo">Martes y viernes · 19:00 a 22:00 · Providencia</span></p>
              <div class="ctas">
                <a href="#proxima" class="btn btn-a" data-ancla-sale="3"><span class="rotulo">Reservar mi lugar <span aria-hidden="true">→</span></span></a>
                <a href="#eventos" class="btn btn-o"><span class="rotulo">Ver eventos anteriores</span></a>
              </div>
            </div>
          </div>
          <div class="taza-caja" aria-hidden="true">
            <Taza />
            <span class="cafe-sup" data-ancla-sale="1"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · CUENTA ATRÁS: capa de café a pantalla completa; el cronómetro y la fecha vienen de proximaSesion() -->
    <section id="cuenta" class="diapo cuenta" aria-label="Cuenta atrás para la próxima sesión">
      <div class="cafe-capa" data-ancla-entra="1" aria-hidden="true"></div>
      <div class="plano cuenta-plano" id="cuenta-caja">
        <Claqueta pastilla entra={2} sale={2}>Próxima sesión en</Claqueta>
        <div class="cd-caja" data-ancla-sale="1">
          <div class="cd" role="timer" aria-live="off">
            {['días', 'horas', 'min', 'seg'].map((u, i) => (
              <Fragment>
                {i > 0 && <span class="sep rotulo" aria-hidden="true">:</span>}
                <span class="g"><span class="mask"><span class="sube"><b data-u={u}>--</b></span></span><i class="mask"><span class="sube">{u}</span></i></span>
              </Fragment>
            ))}
          </div>
        </div>
        <p class="cuando" data-cuando-caja data-ancla-entra="3" data-ancla-sale="3"><span class="rotulo" data-cuando>Calculando…</span></p>
        <div class="sub revela">
          Charlas, eventos y simposios sobre
          <span class="sr-only">{rotativos.join(', ')},</span>
          <span class="rotador" aria-hidden="true" data-palabras={JSON.stringify(rotativos)}><span class="palabra-r">{rotativos[0]}</span></span>
          para quien recién empieza y para quien lleva años en esto. Gratis.
        </div>
      </div>
    </section>

    <!-- 3 · PRÓXIMA CHARLA: en escritorio, una pantalla (póster, créditos, lista y entrada); en móvil, dos pasos -->
    <section id="proxima" class="diapo charla" aria-labelledby="t-charla" data-pasos=".grupo-paso">
      <div class="plano">
        <div class="foco" aria-hidden="true"></div>
        <div class="c-grid">
          <div class="grupo-paso g1">
            <article class="poster" data-ancla-entra="1" data-ancla-sale="2">
              <p class="pre revela">Meet &amp; Coffee presenta</p>
              <svg viewBox="0 0 300 250" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
                <defs><pattern id="poster-puntos" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.3" fill="#f6ede3" opacity=".22" /></pattern></defs>
                <rect width="300" height="250" fill="url(#poster-puntos)" />
                <circle cx="150" cy="120" r="96" fill="#f29a4a" opacity=".16" />
                <g fill="none" stroke="#f6ede3" stroke-width="4">
                  <g transform="translate(150 60)"><ellipse rx="62" ry="17" fill="#2a170d" /><path d="M-62 0v34c0 9 28 17 62 17s62-8 62-17V0" /><path d="M-62 17c0 9 28 17 62 17s62-8 62-17" opacity=".55" /></g>
                  <g transform="translate(150 118)" opacity=".85"><ellipse rx="62" ry="17" fill="#2a170d" /><path d="M-62 0v34c0 9 28 17 62 17s62-8 62-17V0" /><path d="M-62 17c0 9 28 17 62 17s62-8 62-17" opacity=".55" /></g>
                  <g transform="translate(150 176)" opacity=".7"><ellipse rx="62" ry="17" fill="#2a170d" /><path d="M-62 0v34c0 9 28 17 62 17s62-8 62-17V0" /><path d="M-62 17c0 9 28 17 62 17s62-8 62-17" opacity=".55" /></g>
                </g>
                <g fill="#7fd1b9"><circle cx="38" cy="40" r="3" /><circle cx="262" cy="70" r="3" /><circle cx="52" cy="150" r="3" /><circle cx="252" cy="190" r="3" /><circle cx="28" cy="214" r="2" /><circle cx="270" cy="124" r="2" /></g>
              </svg>
              <div class="poster-txt">
                <h2 id="t-charla"><span class="mask"><span class="sube">{proxima.titulo}</span></span></h2>
                <p class="por revela">Una charla de {proxima.orador.nombre}</p>
                <p class="pie revela">Martes y viernes · 19:00 · Calle Baker 133</p>
              </div>
            </article>
            <Claqueta class="c-slate" pastilla entra={2} sale={3}>Escena 01 — Próxima charla</Claqueta>
            <div class="cred revela">
              <span class="av" aria-hidden="true">{iniciales}</span>
              <div><small>Protagonista</small><strong>{proxima.orador.nombre}</strong><span>{proxima.orador.cargo}</span></div>
            </div>
            <p class="bio revela">{proxima.orador.bio}</p>
            <p class="resumen revela">{proxima.resumen}</p>
          </div>
          <div class="grupo-paso g2">
            <div class="llevar">
              <h3 class="etq-llevar revela">Te vas a llevar</h3>
              <ul role="list">
                {proxima.aprenderas.map((a, i) => <li style={`--i:${i}`}><span class="revela">{a}</span></li>)}
              </ul>
            </div>
            <form id="form-reserva" class="ticket" data-ancla-entra="3" data-ancla-sale="1" aria-label="Reserva tu lugar">
              <div class="tk-a">
                <p class="k"><span class="mask"><span class="sube">Entrada liberada · Gratis</span></span></p>
                <h3><span class="mask"><span class="sube">Reserva tu lugar</span></span></h3>
                <p class="tk-dato"><span class="mask"><span class="sube">Mar y vie · 19:00 · Baker 133</span></span></p>
                <span class="holo" aria-hidden="true"><i></i></span>
              </div>
              <div class="tk-b">
                <label for="r-correo" class="revela">Tu correo</label>
                <div class="f"><input id="r-correo" name="correo" type="email" required autocomplete="email" placeholder="tu@correo.cl" size="1" /><button type="submit"><span class="rotulo">Reservar</span></button></div>
                <small data-estado aria-live="polite" class="revela">Demo: no se envía ningún dato.</small>
                <span class="holo" aria-hidden="true"><i></i></span>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · LA NOCHE: un panel por hora; la barra con la taza marca el paso. El título no se mueve -->
    <section id="noche" class="diapo noche" aria-labelledby="t-noche" data-pasos=".pn" style={`--n:${agenda.length}`}>
      <div class="plano noche-plano">
        <Claqueta class="n-slate" pastilla entra={3} sale={3}>Escena 02 — La noche</Claqueta>
        <div class="n-intro">
          <h2 id="t-noche" tabindex="-1"><span class="mask"><span class="sube">Tres horas que se pasan volando</span></span></h2>
          <p class="n-hint revela">19:00 → 22:00<span class="solo-mov"> · usa la rueda o las flechas</span></p>
        </div>
        <ol class="agenda" role="list">
          {agenda.map((a, i) => (
            <li class="pn" style={`--i:${i}`} data-ancla-entra="1" data-ancla-sale="2">
              <span class="no"><span class="rotulo">{dosDigitos(i + 1)} / {dosDigitos(agenda.length)}</span></span>
              <span class="hora"><span class="rotulo">{a.hora}</span></span>
              <h3><span class="mask"><span class="sube">{a.titulo}</span></span></h3>
              <p><span class="mask"><span class="sube">{a.texto}</span></span></p>
            </li>
          ))}
        </ol>
        <!-- Programa de la noche (solo escritorio en el modo mazo): cada fila es un paso; la barra ámbar sigue al paso actual.
             Título y filas son .revela: salen en la fase 1, se ocultan al llegar y suben en la fase 3, como el resto de la escena -->
        <div class="programa">
          <p class="programa-tit revela" id="t-programa">Programa de la noche</p>
          <ol class="programa-lista" aria-labelledby="t-programa">
            {agenda.map((a, i) => (
              <li>
                <button type="button" class="pr-fila" data-paso={i} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="pr-hora revela"><span class="pr-dim">{a.hora}</span><span class="pr-lit" aria-hidden="true">{a.hora}</span></span>
                  <span class="pr-tit revela"><span class="pr-dim">{a.titulo}</span><span class="pr-lit" aria-hidden="true">{a.titulo}</span></span>
                </button>
              </li>
            ))}
          </ol>
        </div>
        <div class="rail" aria-hidden="true" data-ancla-entra="2">
          <span class="ln"></span><span class="fill"></span>
          {agenda.map((a, i) => <span class="tk" style={`--i:${i}`}><span class="rotulo">{a.hora}</span></span>)}
          <svg class="marker" viewBox="0 0 30 30" data-ancla-sale="1"><circle cx="15" cy="15" r="14" fill="#14100d" stroke="#f29a4a" stroke-width="2" /><path d="M9 13h12l-1.2 6.4a3.4 3.4 0 0 1-3.3 2.6h-3a3.4 3.4 0 0 1-3.3-2.6z" fill="#f29a4a" /><path d="M21 14h1.2a2.2 2.2 0 0 1 0 4.4H20" fill="none" stroke="#f29a4a" stroke-width="1.6" /></svg>
        </div>
      </div>
    </section>

    <!-- 5 · DÓNDE: mapa a pantalla completa; el pasador del centro es el ancla; la tarjeta de dirección va abajo -->
    <section id="donde" class="diapo donde" aria-labelledby="t-donde">
      <div class="mapa" aria-hidden="true">
        <svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice">
          <rect width="800" height="500" fill="#1c1611" />
          <path d="M-10 430C150 400 300 462 450 432S700 410 810 440V510H-10z" fill="#12212a" />
          <rect x="24" y="30" width="170" height="130" rx="14" fill="#14241d" />
          <g fill="#1d3a2d"><circle cx="60" cy="64" r="11" /><circle cx="96" cy="96" r="13" /><circle cx="140" cy="62" r="10" /><circle cx="160" cy="118" r="12" /><circle cx="70" cy="128" r="9" /></g>
          <g fill="#251c14"><rect x="214" y="30" width="90" height="62" rx="5" /><rect x="320" y="30" width="60" height="62" rx="5" /><rect x="214" y="128" width="64" height="40" rx="5" /><rect x="300" y="190" width="60" height="38" rx="5" /><rect x="450" y="36" width="70" height="60" rx="5" /><rect x="540" y="36" width="64" height="60" rx="5" /><rect x="640" y="50" width="120" height="50" rx="5" /><rect x="450" y="120" width="66" height="60" rx="5" /><rect x="540" y="130" width="90" height="46" rx="5" /><rect x="660" y="124" width="100" height="60" rx="5" /><rect x="450" y="204" width="80" height="52" rx="5" /><rect x="560" y="206" width="70" height="60" rx="5" /><rect x="674" y="214" width="86" height="54" rx="5" /><rect x="214" y="260" width="76" height="30" rx="5" /><rect x="40" y="206" width="80" height="62" rx="5" /><rect x="450" y="330" width="90" height="46" rx="5" /><rect x="580" y="320" width="70" height="40" rx="5" /></g>
          <g stroke="#2e241a" stroke-width="16" fill="none" stroke-linecap="round"><path d="M-10 110H810M-10 300H810M-10 392H810M210 -10V440M420 -10V440M640 -10V440" /></g>
          <g stroke="#35291d" stroke-width="5" fill="none"><path d="M-10 205H810M310 -10V440M540 -10V440" /></g>
          <path d="M-20 560L820 180" stroke="#3a2d21" stroke-width="28" />
          <path class="metro" d="M-20 560L820 180" stroke="#7fd1b9" stroke-width="3" stroke-dasharray="12 10" fill="none" opacity=".75" />
          <g class="lbl" font-family="JetBrains Mono Variable,monospace" font-size="10" fill="#b9a999" letter-spacing="2">
            <text x="356" y="436">METRO</text><text x="446" y="294">CALLE BAKER</text>
            <text transform="translate(600 262) rotate(-24.3)" fill="#d7c6b4">AV. PROVIDENCIA</text>
          </g>
          <rect x="371" y="224" width="58" height="52" rx="6" fill="#3a2a1c" stroke="#f29a4a" stroke-width="1.5" />
          <circle class="ring" cx="400" cy="250" r="22" fill="#f29a4a" opacity=".5" />
          <circle class="ring" cx="400" cy="250" r="22" fill="#f29a4a" opacity=".5" style="animation-delay:-1.1s" />
          <text class="lbl" x="436" y="243" font-family="JetBrains Mono Variable,monospace" font-size="9" font-weight="700" fill="#f6ede3" letter-spacing="1">MEET &amp; COFFEE</text>
        </svg>
        <span class="pin" data-ancla-entra="1" data-ancla-sale="2"><svg viewBox="0 0 30 30" aria-hidden="true"><path d="M9 13h12l-1.2 6.4a3.4 3.4 0 0 1-3.3 2.6h-3a3.4 3.4 0 0 1-3.3-2.6z" fill="#14100d" /><path d="M21 14h1.2a2.2 2.2 0 0 1 0 4.4H20" fill="none" stroke="#14100d" stroke-width="1.6" /></svg></span>
        <div class="vig"></div>
      </div>
      <div class="plano donde-plano">
        <div class="d-top">
          <Claqueta class="d-slate" pastilla entra={3} sale={3}>Escena 03 — Dónde</Claqueta>
          <h2 id="t-donde" tabindex="-1"><span class="mask"><span class="sube">Nos juntamos en Providencia</span></span></h2>
        </div>
        <div class="m-card" data-ancla-entra="2" data-ancla-sale="1">
          <Claqueta pastilla>Locación</Claqueta>
          <h3><span class="mask"><span class="sube">Calle Baker 133, Providencia</span></span></h3>
          <p class="revela">A pasos del metro. Hay estacionamiento para bicicletas, enchufes en todas las mesas y wifi que sí funciona.</p>
          <dl class="revela"><div><dt>Días</dt><dd>Martes y viernes</dd></div><div><dt>Horario</dt><dd>19:00 a 22:00</dd></div></dl>
        </div>
      </div>
    </section>

    <!-- 6 · EVENTOS ANTERIORES: una tarjeta grande por paso (tres eventos y el hueco para tu charla) -->
    <section id="eventos" class="diapo eventos" aria-labelledby="t-eventos" data-pasos=".evento-paso">
      <div class="plano eventos-plano">
        <div class="e-head">
          <Claqueta class="e-slate" pastilla entra={3} sale={3}>Escena 04 — Eventos anteriores</Claqueta>
          <h2 id="t-eventos" tabindex="-1"><span class="mask"><span class="sube">Lo que ya pasó por la cafetera</span></span></h2>
        </div>
        <div class="pasos-grid">
          {eventos.map((e, i) => (
            <div class="evento-paso" style={`--i:${i}`}>
              <article class="card" data-ancla-sale="1">
                <div class="cov" data-ancla-entra="1">
                  <Portada motivo={e.motivo} colores={e.colores} titulo={e.titulo} class="cv" />
                  <span class="fig"><span class="rotulo">Fotograma {dosDigitos(i + 1)}</span></span>
                </div>
                <div class="inf">
                  <p class="reg">
                    <span class="contador" data-ancla-entra="2" data-ancla-sale="2"><span class="rotulo"><b>{dosDigitos(i + 1)}</b> / {dosDigitos(eventos.length)}</span></span>
                    <span class="revela">{e.fecha}</span>
                  </p>
                  <h3><span class="mask"><span class="sube"><a href={`${base}meet-and-coffee/eventos/${e.slug}/`}>{e.titulo}</a></span></span></h3>
                  <p class="baj revela">{e.bajada}</p>
                  <ul class="tags revela" role="list">{e.temas.map((t) => <li>{t}</li>)}</ul>
                  <p class="by revela"><b>{e.orador.nombre}</b><span> · {e.orador.cargo}</span></p>
                  <p class="go" aria-hidden="true"><span class="rotulo">Ver el resumen →</span></p>
                </div>
              </article>
            </div>
          ))}
          <div class="evento-paso" style={`--i:${eventos.length}`}>
            <article class="card abierta" data-ancla-sale="1">
              <div>
                <p class="mas" aria-hidden="true"><span class="rotulo">+</span></p>
                <h3><span class="mask"><span class="sube"><a href="#propon">Tu charla podría ir aquí</a></span></span></h3>
                <p class="reg-a revela">Fotograma {dosDigitos(eventos.length + 1)} · Próximamente</p>
                <p class="go" aria-hidden="true"><span class="rotulo">Propón un tema →</span></p>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- 7 · PROPÓN UNA CHARLA: texto y formulario; los niveles y el envío son los puntos de salida hacia las preguntas -->
    <section id="propon" class="diapo propon" aria-labelledby="t-propon">
      <div class="plano p-in">
        <div class="p-texto">
          <Claqueta class="p-slate" pastilla entra={3} sale={3}>Escena 05 — Call for speakers</Claqueta>
          <h2 id="t-propon" tabindex="-1"><span class="mask"><span class="sube">¿Tienes algo <em>que contar?</em></span></span></h2>
          <p class="l revela">No hace falta ser experto. Las mejores charlas son las de alguien que resolvió un problema de verdad y quiere contar cómo.</p>
        </div>
        <div class="p-form">
          <p id="p-estado" class="sr-only" role="status"></p>
          <form id="form-propuesta" class="form" novalidate data-ancla-entra="1">
            <div class="two">
              <div><label for="p-nombre" class="revela">Nombre</label><input id="p-nombre" name="nombre" type="text" required autocomplete="name" /></div>
              <div><label for="p-correo" class="revela">Correo</label><input id="p-correo" name="correo" type="email" required autocomplete="email" /></div>
            </div>
            <div><label for="p-titulo" class="revela">Título de la charla</label><input id="p-titulo" name="titulo" type="text" required /></div>
            <fieldset>
              <legend class="revela">Nivel</legend>
              <div class="chips">
                {niveles.map((n, i) => (
                  <label class="nivel" data-ancla-sale={i + 1}>
                    <input type="radio" name="nivel" value={n} class="sr-only" checked={i === 0} /><span class="rotulo">{n}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <p id="p-error" class="p-error revela" role="alert" hidden>Completa nombre, correo y título.</p>
            <button type="submit" class="btn btn-a" data-ancla-entra="2" data-ancla-sale="4"><span class="rotulo">Enviar propuesta</span></button>
            <small class="revela">Sitio de demostración: este formulario no envía datos.</small>
          </form>
        </div>
      </div>
    </section>

    <!-- 8 · PREGUNTAS: maestro-detalle en escritorio; acordeón en el móvil. El panel abierto es el ancla de salida -->
    <section id="preguntas" class="diapo preguntas" aria-labelledby="t-faq">
      <div class="plano f-plano">
        <h2 id="t-faq" tabindex="-1"><span class="mask"><span class="sube">Preguntas frecuentes</span></span></h2>
        <div class="faq">
          {preguntas.map((q, i) => (
            <details class="pregunta" name="faq-meet" open={i === 0}>
              <summary>
                <span class="barra-activa" aria-hidden="true"></span>
                <span class="mask"><span class="sube">{q.p}</span></span>
                <span class="icono" aria-hidden="true" data-ancla-entra={i + 1} data-ancla-sale={i < 3 ? i + 2 : undefined}><span class="rotulo">+</span></span>
              </summary>
              <div class="respuesta" data-ancla-sale={i === 0 ? 1 : undefined}>
                <p class="resp-num mini"><span class="mask"><span class="sube">Respuesta {dosDigitos(i + 1)}</span></span></p>
                <p class="resp-texto"><span class="mask"><span class="sube">{q.r}</span></span></p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 9 · CRÉDITOS: el pie de la página, como escena final. Las viñetas son los puntos de llegada de las preguntas -->
    <section id="fin" class="diapo fin-escena" aria-label="Créditos">
      <Pie escena>
        <div class="vinetas" aria-hidden="true"><i data-ancla-entra="2"></i><i data-ancla-entra="3"></i><i data-ancla-entra="4"></i></div>
      </Pie>
    </section>
  </main>

  <script is:inline>
    (function () {
      var h = document.documentElement;
      if (!h.classList.contains('escenas') || !h.dataset.inicio) return;
      var sec = null;
      try {
        var el = document.getElementById(decodeURIComponent(h.dataset.inicio));
        sec = el && el.closest('main > section.diapo');
      } catch (e) { sec = null; }
      if (!sec) return;
      document.querySelectorAll('main > section.diapo.activa').forEach(function (s) { s.classList.remove('activa'); });
      sec.classList.add('activa');
    })();
  </script>

  <nav class="puntos-nav" aria-label="Escenas">
    <ol>
      {escenas.map(([id, nombre]) => (
        <li><a href={`#${id}`}><span class="sr-only">{nombre}</span></a></li>
      ))}
    </ol>
  </nav>
</Base>

<style is:global>
  /* =====================================================================
     Función de noche · Meet & Coffee
     Orden: base (documento normal, legible con scroll) → modo mazo (html.escenas).
