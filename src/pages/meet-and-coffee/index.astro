  html.escenas .noche .pn.llega.atras .hora .rotulo { animation-name: odo-entra-atras; }
  html.escenas .noche .pn.sale .hora .rotulo { animation: odo-sale .4s var(--encastre) both; }
  html.escenas .noche .pn.sale.atras .hora .rotulo { animation-name: odo-sale-atras; }
