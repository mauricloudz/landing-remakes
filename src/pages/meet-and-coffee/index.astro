  .n-hint { margin: 18px 0 0; font: 500 13px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--suave); }
  .agenda { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 20px; margin: 40px 0 0; padding: 0; list-style: none; }
  .pn { border: 1px solid var(--linea); border-radius: 24px; background: var(--superficie); padding: 22px 24px; }
  .pn .no { font: 500 11px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .2em; color: var(--suave); }
  .pn .hora { display: block; margin: 6px 0 10px; font: 700 clamp(48px, 6vw, 80px)/.95 "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: -.06em; color: var(--marca); }
