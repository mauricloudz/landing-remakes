  .cred .av { display: grid; place-items: center; flex: none; width: 60px; height: 60px; border-radius: 50%; background: var(--marca); font: 800 22px var(--fuente-display); color: var(--espresso); }
  .cred small { display: block; font: 500 11px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .2em; text-transform: uppercase; color: var(--suave); }
  .cred strong { display: block; margin-top: 2px; font: 700 24px var(--fuente-display); letter-spacing: -.02em; }
  .cred span { font-size: 14px; color: var(--marca-fuerte); }
  .bio { grid-column: 2; grid-row: 3; margin: 6px 0 0; font-size: 14px; color: var(--suave); }
  .resumen { grid-column: 2; grid-row: 4; max-width: 44ch; margin: 22px 0 0; font: 500 clamp(18px, 1.7vw, 24px)/1.4 var(--fuente-cuerpo); color: var(--tinta); }
  .llevar { grid-column: 2; grid-row: 5; margin-top: 24px; }
  .etq-llevar { margin: 0 0 12px; font: 700 12px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .2em; text-transform: uppercase; color: var(--suave); }
  .llevar ul { margin: 0; padding: 0; list-style: none; }
  .llevar li { display: flex; gap: 14px; border-top: 1px solid var(--linea); padding: 12px 0; font-size: 16px; }
  .llevar li::before { content: "✓"; flex: none; display: grid; place-items: center; width: 22px; height: 22px; margin-top: 2px; border-radius: 50%; background: rgb(127 209 185 / .16); font-size: 12px; color: var(--acento); }
  .ticket { position: relative; grid-column: 3; grid-row: 1 / span 5; align-self: center; color: var(--espresso); touch-action: pan-y; }
  .ticket :focus-visible { outline-color: var(--espresso); }
  .tk-a, .tk-b { position: relative; background: var(--marca); padding: 26px; }
  .tk-a { border-radius: 16px 16px 0 0; padding-bottom: 24px; -webkit-mask: radial-gradient(circle 12px at 0 100%, #0000 11px, #000 12px), radial-gradient(circle 12px at 100% 100%, #0000 11px, #000 12px); -webkit-mask-composite: source-in; mask: radial-gradient(circle 12px at 0 100%, #0000 11px, #000 12px), radial-gradient(circle 12px at 100% 100%, #0000 11px, #000 12px); mask-composite: intersect; }
  .tk-b { border-radius: 0 0 16px 16px; border-top: 2px dashed rgb(13 10 8 / .45); padding-top: 24px; -webkit-mask: radial-gradient(circle 12px at 0 0, #0000 11px, #000 12px), radial-gradient(circle 12px at 100% 0, #0000 11px, #000 12px); -webkit-mask-composite: source-in; mask: radial-gradient(circle 12px at 0 0, #0000 11px, #000 12px), radial-gradient(circle 12px at 100% 0, #0000 11px, #000 12px); mask-composite: intersect; }
  .tk-a .k { margin: 0; font: 700 11px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .2em; text-transform: uppercase; }
  .tk-a h3 { margin-top: 10px; font-size: 34px; }
  .tk-dato { margin: 10px 0 0; font: 500 13px "JetBrains Mono Variable", ui-monospace, monospace; }
