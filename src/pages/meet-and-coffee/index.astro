  @keyframes odo-sale-atras { to { transform: translateY(100%); } }
  @keyframes paso-sube { from { transform: translateY(170%); } }
  @keyframes paso-sube-atras { from { transform: translateY(-170%); } }
  @keyframes paso-sale-t { to { transform: translateY(-170%); } }
  @keyframes paso-sale-t-atras { to { transform: translateY(170%); } }
  html.escenas .noche .pn.llega .hora, html.escenas .noche .pn.sale .hora { overflow: hidden; padding-block: .1em .2em; margin-block: -.1em -.2em; }
  /* Escritorio: dos columnas. Izquierda, el momento actual (título fijo, panel y rail); derecha, el programa completo */
  @media (min-width: 1024px) {
    html.escenas .diapo > .noche-plano { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, 380px); grid-template-areas: "slate prog" "intro prog" "agenda prog" "rail prog"; column-gap: clamp(32px, 5vw, 96px); row-gap: clamp(.5rem, 1.6svh, 2rem); align-content: center; padding-bottom: clamp(10px, 2.4svh, 30px); }
    html.escenas .noche .n-hint { margin-top: clamp(8px, 1.4svh, 18px); }
    html.escenas .noche .rail { margin-top: clamp(2px, 1svh, 16px); }
    html.escenas .noche .n-intro h2 { font-size: clamp(32px, min(5.6vw, 10svh), 96px); }
    html.escenas .noche .n-slate { grid-area: slate; }
    html.escenas .noche .n-intro { grid-area: intro; }
    html.escenas .noche .agenda { grid-area: agenda; }
