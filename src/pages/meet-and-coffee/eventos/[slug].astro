---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/jetbrains-mono';
import Base from '../../../layouts/Base.astro';
import Cabecera from '../../../components/meet/Cabecera.astro';
import Pie from '../../../components/meet/Pie.astro';
import Portada from '../../../components/meet/Portada.astro';
import Claqueta from '../../../components/meet/Claqueta.astro';
import { eventos, iniciales as sacarIniciales, type Evento } from '../../../data/meet';

export function getStaticPaths() {
  return eventos.map((e, i) => ({ params: { slug: e.slug }, props: { evento: e, siguiente: eventos[(i + 1) % eventos.length] } }));
}
interface Props { evento: Evento; siguiente: Evento }
const { evento: e, siguiente } = Astro.props;
const base = import.meta.env.BASE_URL;
const iniciales = sacarIniciales(e.orador.nombre);
---
<Base titulo={`${e.titulo} · Meet & Coffee`} descripcion={`${e.bajada} Resumen del evento de Meet & Coffee con ${e.orador.nombre}.`} tema="meet">
  <Cabecera />
  <main id="contenido" class="ev">
    <a href={`${base}meet-and-coffee/#eventos`} class="volver">← Todos los eventos</a>
    <div class="portada-ev" transition:name={`portada-${e.slug}`}>
      <Portada motivo={e.motivo} colores={e.colores} titulo={e.titulo} class="size-full" />
    </div>
    <div class="claq rev"><Claqueta>Función · {e.fecha} · 19:00</Claqueta></div>
    <h1 transition:name={`titulo-${e.slug}`}>{e.titulo}</h1>
    <p class="bajada rev">{e.bajada}</p>

    <div class="cred rev">
      <span class="av" style={`background:linear-gradient(135deg, ${e.colores[0]}, ${e.colores[1]})`} aria-hidden="true">{iniciales}</span>
      <div><small>Protagonista</small><strong>{e.orador.nombre}</strong><span>{e.orador.cargo}</span></div>
    </div>

    <h2 class="rev">De qué se trató</h2>
    <p class="texto rev">{e.resumen}</p>

    <h2 class="rev">Lo que aprendimos</h2>
    <ol class="aprendimos" role="list">
      {e.aprendimos.map((a, i) => <li class="rev" data-n={`0${i + 1}`}><p>{a}</p></li>)}
    </ol>

    <ul class="temas rev" role="list" aria-label="Temas">
      {e.temas.map((t) => <li>#{t}</li>)}
    </ul>

    <a href={`${base}meet-and-coffee/eventos/${siguiente.slug}/`} class="siguiente rev">
      <span><span class="etq">Siguiente evento</span><span class="tit">{siguiente.titulo}</span></span>
      <span class="flecha" aria-hidden="true">→</span>
    </a>
  </main>
  <Pie />
</Base>

<style>
  .ev { max-width: 64rem; margin: 0 auto; padding: 40px clamp(18px, 5vw, 40px) 96px; }
  .volver { font-size: 14px; font-weight: 600; color: var(--suave); transition: color .3s; }
  .volver:hover { color: var(--tinta); }
  .portada-ev { view-transition-class: portada; margin-top: 24px; aspect-ratio: 400 / 260; max-height: 56svh; width: 100%; overflow: clip; border: 1px solid #4a3e33; border-radius: 20px; }
  .claq { margin-top: 40px; }
  h1 { margin-top: 14px; font-size: clamp(40px, min(8vw, 14svh), 104px); font-weight: 800; letter-spacing: -.045em; line-height: .92; }
  h2 { margin-top: 64px; font-size: clamp(28px, 4vw, 48px); font-weight: 800; letter-spacing: -.035em; line-height: .95; }
  .bajada { margin: 18px 0 0; max-width: 34ch; font-size: clamp(20px, 2.4vw, 28px); line-height: 1.3; color: #e5d6c6; }
  .cred { margin-top: 40px; display: flex; align-items: center; gap: 16px; border: 1px solid var(--linea); border-radius: 20px; background: var(--superficie); padding: 20px 24px; }
  .av { display: grid; place-items: center; flex: none; width: 60px; height: 60px; border-radius: 50%; font: 800 22px var(--fuente-display); color: var(--espresso); }
  .cred small { display: block; font: 500 11px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .2em; text-transform: uppercase; color: var(--suave); }
  .cred strong { display: block; margin-top: 2px; font: 700 24px var(--fuente-display); letter-spacing: -.02em; }
  .cred span:not(.av) { font-size: 14px; color: var(--marca-fuerte); }
  .texto { margin: 20px 0 0; max-width: 60ch; font-size: 19px; line-height: 1.6; color: #e5d6c6; }
  .aprendimos { display: grid; gap: 14px; margin: 28px 0 0; padding: 0; }
  .aprendimos li { position: relative; overflow: clip; border: 1px solid var(--linea); border-radius: 20px; padding: 26px 26px 26px 110px; }
  /* El numeral gigante es decorativo: vive en un pseudo-elemento, fuera del árbol de texto */
  .aprendimos li::before { content: attr(data-n); position: absolute; left: 26px; top: 50%; translate: 0 -50%; font: 700 56px/1 "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: -.06em; color: var(--marca); }
  .aprendimos p { margin: 0; font-size: 19px; line-height: 1.45; }
  .temas { display: flex; flex-wrap: wrap; gap: 8px; margin: 40px 0 0; padding: 0; }
  .temas li { border: 1px solid var(--linea); border-radius: 999px; padding: 8px 16px; font: 500 13px "JetBrains Mono Variable", ui-monospace, monospace; color: var(--suave); }
  .siguiente { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 64px; border: 1px solid var(--linea); border-radius: 24px; background: var(--superficie); padding: 32px; transition: border-color .3s; }
  .siguiente:hover { border-color: var(--marca); }
  .etq { display: block; font: 500 11px "JetBrains Mono Variable", ui-monospace, monospace; letter-spacing: .2em; text-transform: uppercase; color: var(--suave); }
  .tit { display: block; margin-top: 8px; font: 800 clamp(26px, 3.6vw, 40px)/1 var(--fuente-display); letter-spacing: -.03em; }
  .flecha { font-size: 32px; color: var(--marca); transition: translate .3s; }
  .siguiente:hover .flecha { translate: 8px 0; }
  @media (max-width: 560px) { .aprendimos li { padding: 84px 20px 22px; } .aprendimos li::before { top: 22px; translate: 0; } }

  /* Entradas suaves: solo con scroll-driven animation y sin "reducir movimiento" */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .rev { animation-name: sube; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: view(); animation-range: entry 0% entry 65%; }
      @keyframes sube { from { opacity: 0; transform: translateY(36px); } }
    }
  }
</style>
