---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/jetbrains-mono';
import Base from '../../../layouts/Base.astro';
import Cabecera from '../../../components/meet/Cabecera.astro';
import Pie from '../../../components/meet/Pie.astro';
import Portada from '../../../components/meet/Portada.astro';
import { eventos, type Evento } from '../../../data/meet';

export function getStaticPaths() {
  return eventos.map((e, i) => ({ params: { slug: e.slug }, props: { evento: e, siguiente: eventos[(i + 1) % eventos.length] } }));
}
interface Props { evento: Evento; siguiente: Evento }
const { evento: e, siguiente } = Astro.props;
const base = import.meta.env.BASE_URL;
const iniciales = e.orador.nombre.split(' ').map((w) => w[0]).join('');
---
<Base titulo={`${e.titulo} · Meet & Coffee`} descripcion={`${e.bajada} Resumen del evento de Meet & Coffee con ${e.orador.nombre}.`} tema="meet">
  <Cabecera />
  <main id="contenido" class="mx-auto max-w-4xl px-5 pb-24 pt-10">
    <a href={`${base}meet-and-coffee/#eventos`} class="text-sm font-semibold text-suave transition hover:text-tinta">← Todos los eventos</a>
    <div class="mt-6 aspect-[400/260] overflow-hidden rounded-[32px] border border-linea" transition:name={`portada-${e.slug}`}>
      <Portada motivo={e.motivo} colores={e.colores} titulo={e.titulo} class="size-full" />
    </div>
    <p class="mt-10 font-mono text-sm text-acento">{e.fecha} · 19:00</p>
    <h1 class="mt-2 text-5xl font-extrabold tracking-tight sm:text-6xl" transition:name={`titulo-${e.slug}`}>{e.titulo}</h1>
    <p data-reveal class="mt-4 text-2xl text-suave">{e.bajada}</p>

    <div data-reveal class="mt-10 flex items-center gap-4 rounded-3xl border border-linea bg-superficie p-6">
      <span class="grid size-14 place-items-center rounded-2xl font-display text-xl font-bold text-[var(--espresso)]" style={`background:linear-gradient(135deg, ${e.colores[0]}, ${e.colores[1]})`} aria-hidden="true">{iniciales}</span>
      <div><p class="font-display text-lg font-bold">{e.orador.nombre}</p><p class="text-sm text-suave">{e.orador.cargo}</p></div>
    </div>

    <h2 data-reveal class="mt-14 text-3xl font-bold">De qué se trató</h2>
    <p data-reveal class="mt-4 text-lg leading-relaxed text-suave">{e.resumen}</p>

    <h2 data-reveal class="mt-14 text-3xl font-bold">Lo que aprendimos</h2>
    <ol class="mt-6 space-y-4">
      {e.aprendimos.map((a, i) => (
        <li data-reveal="izq" style={`--d:${i}`} class="flex gap-5 rounded-3xl border border-linea p-6">
          <span class="font-mono text-2xl font-bold text-marca">0{i + 1}</span><p class="text-lg">{a}</p>
        </li>
      ))}
    </ol>

    <div data-reveal class="mt-10 flex flex-wrap gap-2">
      {e.temas.map((t) => <span class="rounded-full border border-linea px-4 py-2 font-mono text-sm text-suave">#{t}</span>)}
    </div>

    <a href={`${base}meet-and-coffee/eventos/${siguiente.slug}/`} data-reveal class="group mt-16 flex items-center justify-between gap-6 rounded-[32px] border border-linea bg-superficie p-8 transition hover:border-suave/50">
      <span><span class="font-mono text-xs uppercase tracking-[.2em] text-suave">Siguiente evento</span><span class="mt-2 block font-display text-3xl font-bold">{siguiente.titulo}</span></span>
      <span class="text-3xl text-marca transition group-hover:translate-x-2">→</span>
    </a>
  </main>
  <Pie />
</Base>
