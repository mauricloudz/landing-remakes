    html.escenas .tarjeta-form { padding: .8rem 1.1rem .9rem; border-radius: 22px; }
    html.escenas .tarjeta-form form > * + * { margin-top: .5rem; }
    html.escenas .campo input, html.escenas .campo select, html.escenas .campo textarea { padding: .3rem 0; }
    html.escenas .campo textarea { height: 3.2rem; }
    html.escenas .btn-enviar { padding: .6rem 1rem; }
    /* Escenas que pueden desplazarse: el plano crece con su contenido y deja libre la píldora de puntos (alto + 12 px) */
    html.escenas .equipo, html.escenas .preguntas, html.escenas .cierre { padding-bottom: 0; }
    html.escenas .equipo .plano, html.escenas .preguntas .plano, html.escenas .cierre .plano { height: auto; min-height: 100%; padding-bottom: 66px; }
    html.escenas .preguntas .plano { justify-content: flex-start; }
    html.escenas .preguntas-grid { gap: 1rem; }
    html.escenas .pista-hint { display: none; }
    html.escenas .puntos-nav { top: auto; bottom: 12px; left: 50%; right: auto; translate: -50% 0; width: max-content; padding: 8px 12px; }
    html.escenas .puntos-nav ol { display: flex; gap: 2px; }
  }
  /* Teléfono bajo (≤ 700 px de alto, p. ej. 375×667): la personalidad se corta a 2 líneas y la ficha se compacta */
  @media (max-width: 819px) and (max-height: 700px) {
    html.escenas .portada .plano { gap: .6rem; }
    html.escenas .portada-texto { gap: .55rem; }
    html.escenas .portada h1 { font-size: 2.15rem; }
    html.escenas .cta-portada { gap: .5rem; }
    html.escenas .cta-portada .btn { padding: .65rem 1.3rem; }
    html.escenas .escenario { width: min(56vw, calc(26svh * .8)); }
    html.escenas .galeria .cab { display: none; }
    html.escenas .galeria h2 { font-size: 1.9rem; }
    html.escenas .galeria .plano { gap: .4rem; }
    html.escenas .ficha { grid-template-rows: min(12svh, 90px) minmax(0, 1fr); }
    html.escenas .ficha .retrato-ficha { height: 92%; }
    html.escenas .ficha .num { top: .5rem; left: 1rem; font-size: 1rem; }
    html.escenas .ficha .dat { padding: .45rem .9rem .5rem; gap: .2rem; }
    html.escenas .ficha h3 { font-size: 1.7rem; }
    html.escenas .ficha .desc .sube { -webkit-line-clamp: 2; }
    html.escenas .ficha dl { padding-top: .25rem; }
    html.escenas .ficha .chip { margin-top: .2rem; }
    html.escenas .ficha .btn { margin-top: .3rem; padding: .5rem .9rem; }
    html.escenas .test .plano { grid-template-columns: 1fr; gap: .8rem; }
    html.escenas .test .secc-h { font-size: 2.3rem; }
    /* El test por pasos (indicador, pregunta o resultado y "Volver") cabe en la pantalla baja sin desplazarse: se quitan el
       rótulo y la bajada, y el ícono se achica */
    html.escenas .test-texto .eyebrow, html.escenas .test .lead { display: none; }
    html.escenas .badge-test { width: 2.6rem; margin-bottom: .4rem; }
    html.escenas .testform { gap: .9rem; }
    html.escenas .st-etapa { min-height: calc(15svh + 6.2rem); }
    html.escenas .resultados { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    html.escenas .resultado svg { width: min(100%, 15svh); }
