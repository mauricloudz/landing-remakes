    html.escenas .ayuda .secc-h, html.escenas .equipo .secc-h, html.escenas .preguntas .secc-h { font-size: 2.3rem; }
    html.escenas .ayuda .secc-h { font-size: 1.7rem; }
    html.escenas .ayuda-lista { margin-top: .4rem; }
    html.escenas .ayuda-lista li { padding: .6rem .6rem .65rem; }
    html.escenas .icono-ayuda { width: 2rem; height: 2rem; }
    html.escenas .ayuda-lista h3 { font-size: 1.15rem; margin-top: .45rem; }
    html.escenas .ayuda-lista p { font-size: .78rem; line-height: 1.35; margin-top: .25rem; }
    html.escenas .ayuda-lista p .sube { -webkit-line-clamp: 2; }
    html.escenas .equipo-lista { margin-top: .6rem; gap: .9rem .8rem; }
    html.escenas .equipo .avatar { width: 3rem; height: 3rem; font-size: 1.1rem; }
    html.escenas .equipo-lista h3 { margin-top: .5rem; font-size: 1.15rem; }
    html.escenas .equipo-lista .rol { margin-top: .2rem; font-size: .8rem; }
    html.escenas .equipo-lista .texto { margin-top: .3rem; font-size: .78rem; line-height: 1.35; }
  }
  @media (min-width: 820px) {
    html.escenas .galeria .galeria-cab { grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); grid-template-areas: "cab cab" "titulo bajada" "filtros bajada"; column-gap: clamp(2rem, 4vw, 4rem); align-items: end; }
    html.escenas .galeria .cab { grid-area: cab; }
    html.escenas .galeria h2 { grid-area: titulo; }
    html.escenas .galeria .bajada { grid-area: bajada; align-self: end; }
    html.escenas .galeria .filtros { grid-area: filtros; }
    html.escenas .ayuda-lista { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    html.escenas .ayuda-lista h3 { font-size: clamp(1.3rem, min(2vw, 3.4svh), 1.9rem); }
    html.escenas .campos-fila { grid-template-columns: 1fr 1fr; gap: 0 1.5rem; }
    html.escenas .cierre-grid { grid-template-columns: 1fr 1.25fr; }
    html.escenas .cierre-texto p { max-width: 20ch; }
    html.escenas .diapo > .plano { padding-inline: clamp(24px, 5vw, 64px); }
  }
  @media (min-width: 1024px) {
    html.escenas .test .plano { grid-template-columns: 1fr 1.1fr; align-items: center; gap: clamp(2rem, 5vw, 5rem); }
    html.escenas .test .plano > * { min-width: 0; }
  }
  @media (min-width: 820px) and (max-height: 700px) {
    html.escenas .galeria .bajada { display: none; }
    html.escenas .ficha .desc { display: none; }
    html.escenas .ficha .chip { display: none; }
  }

  /* ---------- Movimiento reducido: el modo mazo nunca se activa; aquí solo se quita lo que moleste ---------- */
  @media (prefers-reduced-motion: reduce) {
    .btn, .opcion, .filtros label, .st-relleno, .st-dot, .st-pt, .st-chk, .st-et { transition: none; }
  }
</style>

<script>
  // Modo mazo: una escena a pantalla completa, cambiada con View Transitions en tres fases
  // (despedida, morph con anclas y llegada). Sin dependencias. Si el navegador no cumple los requisitos,
  // la página se queda como página normal.

  import { crearPildora, type Pildora } from '../../scripts/pildora';
  import { iniciarFoco } from '../../scripts/foco';

  type VT = { finished: Promise<unknown> };
  type DocVT = Document & { startViewTransition?: (cb: () => void) => VT };

  // Distancia en píxeles para contar un gesto como paso de escena
  const UMBRAL = 50;
  // Tras el morph, la entrada queda libre a los 150 ms (la llegada de textos sigue en marcha); los eventos de rueda
  // se ignoran hasta entonces, para no contar la inercia del trackpad como un paso nuevo
  const ESPERA_RUEDA = 150;
  // Duración de la despedida (fase 1, 240 ms) antes de empezar el morph
  const DESPEDIDA = 240;
  // Tiempo tras el morph hasta liberar la entrada de nuevo
  const LIBERA = 150;
  // Número de pares de anclas (ancla-1 … ancla-4)
  const PARES = 4;

  let cancelar: AbortController | null = null;
  const esperar = (ms: number) => new Promise<void>((resolver) => setTimeout(resolver, ms));

  // Test «¿Qué peludo es para ti?» (Stepper): una pregunta a la vez con indicador de pasos; el cuarto paso es el resultado.
  // Salida por máscara (240 ms, --encastre) y entrada (900 ms, --friccion, opciones en cascada de 30 ms); «Volver» es la reversa.
  // Teclado: las flechas solo cambian la opción marcada; se avanza con clic, Enter o Espacio.
  function iniciarTest(form: HTMLFormElement) {
    const datos = JSON.parse(form.dataset.peludos!) as { id: string; especie: string; energia: string; espacio: string }[];
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const etapa = form.querySelector<HTMLElement>('.st-etapa');
    const prog = form.querySelector<HTMLElement>('.st-prog');
    const volver = form.querySelector<HTMLButtonElement>('[data-volver]');
    const info = form.querySelector<HTMLElement>('[data-info]');
    if (!etapa || !prog || !volver || !info) return;
    const paneles = [...etapa.querySelectorAll<HTMLElement>('.st-pane')];
    const items = [...form.querySelectorAll<HTMLElement>('.st-paso')];
    const PREGUNTAS = 3; // el paso 3 (cuarto) es el resultado
    let paso = 0;
    let ocupado = false;
    let porTeclado = false;

    // Con el test por pasos ya no hay campos obligatorios ocultos que bloqueen el envío; la lógica es la del botón de antes
    form.querySelectorAll<HTMLInputElement>('input[required]').forEach((i) => { i.required = false; });
    form.classList.add('st-on');
    form.addEventListener('submit', (e) => e.preventDefault());

    // Mismo puntaje de siempre: espacio, energía y especie
    const calcular = () => {
      const f = new FormData(form);
      const puntaje = (p: (typeof datos)[number]) =>
        (p.espacio === f.get('espacio') || f.get('espacio') === 'casa' ? 2 : 0) +
        (p.energia === f.get('energia') ? 2 : 0) +
        (f.get('especie') === 'cualquiera' || p.especie === f.get('especie') ? 3 : -5);
      const mejores = [...datos].sort((a, b) => puntaje(b) - puntaje(a)).slice(0, 2).map((p) => p.id);
      form.querySelectorAll<HTMLElement>('[data-resultado]').forEach((el) => {
        const pos = mejores.indexOf(el.dataset.resultado!);
        el.classList.toggle('hidden', pos < 0);
        el.style.order = String(pos);
        el.style.setProperty('--s', String(pos + 1));
      });
    };

    // Indicador: estado de cada punto, línea que se llena y el punto actual como ancla de la escena (se mueve con el paso)
    const estado = () => {
      items.forEach((li, k) => {
        li.dataset.estado = k < paso ? 'hecho' : k === paso ? 'actual' : 'pendiente';
        if (k === paso) li.setAttribute('aria-current', 'step'); else li.removeAttribute('aria-current');
        const dot = li.querySelector<HTMLElement>('.st-dot');
        if (k === paso) dot?.setAttribute('data-ancla-sale', '1'); else dot?.removeAttribute('data-ancla-sale');
      });
      prog.style.setProperty('--p', String(paso / PREGUNTAS));
      volver.disabled = paso === 0;
      info.textContent = paso < PREGUNTAS ? `Paso ${paso + 1} de ${PREGUNTAS}` : 'Listo';
    };
    const mostrar = () => paneles.forEach((p, k) => p.classList.toggle('st-actual', k === paso));
    // Tras avanzar, el foco va al nuevo enunciado (legend) o al título del resultado
    const enfocar = () => paneles[paso]?.querySelector<HTMLElement>('legend, .eyebrow')?.focus({ preventScroll: true });
    const animados = () => etapa.querySelectorAll<HTMLElement>('.rise');

    const ir = (nuevo: number) => {
      if (ocupado || nuevo < 0 || nuevo > PREGUNTAS || nuevo === paso) return;
      if (nuevo === PREGUNTAS) calcular();
      const adelante = nuevo > paso;
      ocupado = true;
      paso = nuevo;
      estado();
      etapa.dataset.dir = adelante ? 'adelante' : 'atras';
      if (quieto) { mostrar(); enfocar(); ocupado = false; return; }
      animados().forEach((e) => e.classList.add('activo'));
      etapa.dataset.fase = 'sale';
      window.setTimeout(() => {
        mostrar();
        etapa.dataset.fase = 'llega';
        void etapa.offsetWidth;
        etapa.dataset.fase = 'reposo';
        enfocar();
        window.setTimeout(() => { animados().forEach((e) => e.classList.remove('activo')); ocupado = false; }, 1000);
      }, 300);
    };

    // Un clic con ratón o dedo en una opción avanza (tras dejar ver la opción marcada). Con teclado no: las flechas
    // disparan "click" al cambiar de opción y no deben avanzar; para eso están Enter y Espacio.
    etapa.addEventListener('pointerdown', () => { porTeclado = false; });
    etapa.addEventListener('click', (e) => {
      const inp = e.target instanceof Element ? e.target.closest<HTMLInputElement>('input[type="radio"]') : null;
      if (!inp || porTeclado || ocupado) return;
      window.setTimeout(() => ir(paso + 1), 260);
    });
    form.addEventListener('keydown', (e) => {
      porTeclado = true;
      const inp = e.target instanceof Element ? e.target.closest<HTMLInputElement>('input[type="radio"]') : null;
      if (!inp || (e.key !== 'Enter' && e.key !== ' ')) return;
      e.preventDefault();
      if (ocupado) return;
      inp.checked = true;
      ir(paso + 1);
    });
    volver.addEventListener('click', () => ir(paso - 1));
    estado();
    mostrar();
  }

  function iniciarPeludo() {
    // El controlador es de esta página: otras páginas con "main > section.diapo" (la galería) tienen el suyo
    if (!document.documentElement.classList.contains('tema-peludo')) return;
    const main = document.getElementById('contenido');
    const escenas = [...document.querySelectorAll<HTMLElement>('main > section.diapo')];
    if (!main || escenas.length === 0) return;

    cancelar?.abort();
    cancelar = new AbortController();
    const señal = { signal: cancelar.signal };
    const html = document.documentElement;
    const doc = document as DocVT;
    const pistaPasos = escenas.find((e) => e.id === 'adopta') ?? null;
    const procesoEl = escenas.find((e) => e.id === 'proceso') ?? null;
    // Semillas de la división: van sobre la insignia del paso actual (todos los pasos comparten la misma posición)
    const semillas = [...(procesoEl?.querySelectorAll<HTMLElement>('.semilla') ?? [])];
    const colocarSemillas = () => {
      const plano = procesoEl?.querySelector<HTMLElement>('.plano');
      const insignia = procesoEl?.querySelector<HTMLElement>('.paso.actual .numeral');
      if (!plano || !insignia) return;
      const r = insignia.getBoundingClientRect();
      const p = plano.getBoundingClientRect();
      for (const s of semillas) {
        s.style.left = `${r.left - p.left}px`;
        s.style.top = `${r.top - p.top}px`;
        s.style.width = `${r.width}px`;
        s.style.height = `${r.height}px`;
      }
    };
    // Mientras las semillas son las anclas, la insignia (y su dígito) no debe estar en ninguna captura
    const ocultarInsignia = () => procesoEl?.querySelectorAll<HTMLElement>('.numeral').forEach((n) => { n.style.visibility = 'hidden'; });
    const mostrarInsignia = () => procesoEl?.querySelectorAll<HTMLElement>('.numeral').forEach((n) => { n.style.visibility = ''; });
    const nav = document.querySelector<HTMLElement>('.puntos-nav');
    const menu = document.getElementById('menu-movil') as (HTMLElement & { hidePopover?: () => void }) | null;

    // Respaldo del menú sin Popover API (Safari 16): el botón alterna la clase .abierto
    const botonMenu = document.querySelector<HTMLElement>('button[popovertarget="menu-movil"]:not([popovertargetaction])');
    const cerrarRespaldo = () => { menu?.classList.remove('abierto'); botonMenu?.setAttribute('aria-expanded', 'false'); };
    if (menu && !Object.prototype.hasOwnProperty.call(HTMLElement.prototype, 'popover')) {
      botonMenu?.setAttribute('aria-expanded', 'false');
      botonMenu?.addEventListener('click', () => {
        const abierto = menu.classList.toggle('abierto');
        botonMenu.setAttribute('aria-expanded', String(abierto));
      }, señal);
      menu.querySelector('[popovertargetaction="hide"]')?.addEventListener('click', cerrarRespaldo, señal);
      addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarRespaldo(); }, señal);
    }

    // Pulsar un enlace del menú lo cierra, con o sin modo escenas (el popover nativo no se cierra solo al navegar con #)
    menu?.addEventListener('click', (e) => { if ((e.target as Element | null)?.closest('a[href]')) cerrarMenu(); }, señal);

    let modo = false;
    let ocupado = false;
    let acumulado = 0;
    let ultimaRueda = 0;
    let finVT = 0;
    let temporizadorEntrada = 0;
    let tacto: { x: number; y: number } | null = null;
    let multitoque = false;
    let tactoScroll: { el: HTMLElement; top: number; enTope: boolean; enFondo: boolean } | null = null;
    let rafagaInterna = false;
    // Cambio de paso en #proceso: tras cada paso, la rueda espera 450 ms (la animación dura 600-700 ms)
    let bloqueoPaso = false;
    let temporizadorPaso = 0;

    const indiceDe = (id: string): number => {
      const el = id ? document.getElementById(id) : null;
      const sec = el?.closest('main > section.diapo') ?? null;
      return sec ? escenas.indexOf(sec as HTMLElement) : -1;
    };
    let indice = Math.max(0, indiceDe(decodeURIComponent(location.hash.slice(1))));

    const cercano = (t: EventTarget | null, sel: string) => (t instanceof Element ? t.closest(sel) : null);

    // Sub-pasos: tarjetas visibles de adopta, o pasos de proceso
    const subpasosDe = (sec: HTMLElement): number => {
      if (sec.dataset.subpasos === 'tarjetas') return sec.querySelectorAll('#lista-peludos > li:not([hidden])').length;
      if (sec.dataset.subpasos === 'pasos') return sec.querySelectorAll('.paso').length;
      return 1;
    };
    const pasoDe = (sec: HTMLElement) => Number(sec.dataset.paso ?? 0);

    // Fija el sub-paso. Sin animar (al entrar a la escena) la pista salta sin deslizarse.
    const fijarPaso = (sec: HTMLElement, n: number, animar: boolean) => {
      const total = subpasosDe(sec);
      const k = Math.min(Math.max(n, 0), Math.max(total - 1, 0));
      const pista = sec.querySelector<HTMLElement>('.pista-fichas');
      if (pista && !animar) pista.classList.add('quieta');
      sec.dataset.paso = String(k);
      sec.style.setProperty('--paso', String(k));
      if (pista && !animar) {
        void pista.offsetWidth;
        pista.classList.remove('quieta');
      }
      sec.querySelectorAll<HTMLElement>('.paso').forEach((p, i) => {
        p.classList.remove('sale', 'llega', 'atras');
        p.classList.toggle('actual', i === k);
      });
      sec.querySelectorAll<HTMLElement>('.barras i').forEach((b, i) => b.classList.toggle('hecha', i <= k));
    };

    // Cambio de paso en #proceso: el paso saliente sale, el entrante llega; el título de la sección no se toca.
    // Hacia atrás todo va en sentido vertical contrario (clase "atras").
    const cambiarPaso = (sec: HTMLElement, k: number) => {
      const pasos = [...sec.querySelectorAll<HTMLElement>('.paso')];
      const previo = pasos.findIndex((p) => p.classList.contains('actual'));
      const atras = k < previo;
      pasos.forEach((p, i) => {
        p.classList.remove('sale', 'llega', 'atras', 'actual');
        if (i === k) p.classList.add('actual', 'llega');
        else if (i === previo) p.classList.add('sale');
        p.classList.toggle('atras', atras && (i === k || i === previo));
      });
      sec.dataset.paso = String(k);
      sec.querySelectorAll<HTMLElement>('.barras i').forEach((b, i) => b.classList.toggle('hecha', i <= k));
      clearTimeout(temporizadorPaso);
      temporizadorPaso = window.setTimeout(() => {
        pasos.forEach((p) => p.classList.remove('sale', 'llega', 'atras'));
      }, 700);
    };
    const limpiarPasos = () => {
      clearTimeout(temporizadorPaso);
      document.querySelectorAll<HTMLElement>('#proceso .paso').forEach((p) => p.classList.remove('sale', 'llega', 'atras'));
    };

    // Ancla N de una escena: el primer elemento visible con data-ancla-{tipo}="N"; si hay una pastilla marcada, esa
    const anclaDe = (sec: HTMLElement, tipo: 'entra' | 'sale', n: number): HTMLElement | null => {
      let primero: HTMLElement | null = null;
      for (const el of sec.querySelectorAll<HTMLElement>(`[data-ancla-${tipo}="${n}"]`)) {
        const r = el.getBoundingClientRect();
        const visible = r.width > 0 && r.height > 0 && r.right > 0 && r.left < innerWidth && r.bottom > 0 && r.top < innerHeight;
        // Los pasos de #proceso fuera de turno ocupan su celda con visibility: hidden: no son ancla
        if (!visible || getComputedStyle(el).visibility === 'hidden') continue;
        if (el.querySelector('input:checked')) return el;
        primero ??= el;
      }
      return primero;
    };
    const existeAncla = (sec: HTMLElement, tipo: 'entra' | 'sale', n: number) =>
      sec.querySelector(`[data-ancla-${tipo}="${n}"]`) !== null;

    const cabeceraCta = (): HTMLElement | null => {
      const el = document.getElementById('cta-cabecera');
      return el && el.getClientRects().length > 0 ? el : null;
    };

    // Radios de las cuatro esquinas de un ancla (medidas simples en px; si no, 0px). Se devuelven las cuatro, no solo la superior
    // izquierda: el arco de la portada tiene la base recta y, con un único radio, la captura ganaba esquinas inferiores redondeadas
    const radioDe = (el: HTMLElement | null) => {
      if (!el) return '0px';
      const cs = getComputedStyle(el);
      return [cs.borderTopLeftRadius, cs.borderTopRightRadius, cs.borderBottomRightRadius, cs.borderBottomLeftRadius]
        .map((v) => (/^\d+(\.\d+)?px$/.test(v) ? v : '0px')).join(' ');
    };

    // Píldora de la cabecera: se desliza al enlace de la escena activa (en escenas sin enlace se recoge)
    const lwCab = document.querySelector<HTMLElement>('.cab-lw');
    const pildora: Pildora | null = lwCab ? crearPildora(lwCab) : null;
    señal.signal.addEventListener('abort', () => pildora?.destruir());
    // Foco que sigue al puntero en las tarjetas de «Cómo ayudar»
    const escenaAyuda = document.getElementById('ayuda');
    if (escenaAyuda) iniciarFoco(escenaAyuda, [...escenaAyuda.querySelectorAll<HTMLElement>('.ayuda-lista .spot')], señal.signal);

    const actualizarPuntos = (animarPildora = false) => {
      nav?.querySelectorAll('a').forEach((a, i) => {
        if (i === indice) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      pildora?.marcar(escenas[indice].id, animarPildora);
    };

    // Desplazamiento interno: si la escena puede scrollear en esa dirección, la rueda no cambia de escena
    const scrollInterno = (sec: HTMLElement, dy: number) => {
      if (sec.scrollHeight <= sec.clientHeight + 1) return false;
      return dy > 0 ? sec.scrollTop + sec.clientHeight < sec.scrollHeight - 1 : sec.scrollTop > 0;
    };

    const cerrarMenu = () => {
      if (menu?.matches(':popover-open')) menu.hidePopover?.();
      if (menu?.classList.contains('abierto')) cerrarRespaldo();
    };

    // Marca la escena que se activa para que sus textos suban (fase 3, o cambio de sub-paso en proceso)
    const animarEntrada = (sec: HTMLElement) => {
      sec.classList.add('entrando');
      clearTimeout(temporizadorEntrada);
      // 2 s: el formulario de contacto encadena su construcción (hasta ~1,9 s); quitar la clase antes la cortaría
      temporizadorEntrada = window.setTimeout(() => sec.classList.remove('entrando'), 2000);
    };

    // Cambia a la escena destino en tres fases. Las anclas solo viajan entre vecinas; un salto largo revela desde el centro.
    const ir = async (destino: number) => {
      if (!modo || ocupado || destino === indice || destino < 0 || destino >= escenas.length) return;
      ocupado = true;
      // Si el usuario sigue durante la llegada (fase 3), esa llegada se corta limpiamente
      clearTimeout(temporizadorEntrada);
      escenas.forEach((s) => s.classList.remove('entrando'));
      limpiarPasos();
      const origen = indice;
      const origenSec = escenas[origen];
      const sec = escenas[destino];
      const adelante = destino > origen;
      const adyacente = Math.abs(destino - origen) === 1;
      const cabeceraSale = adelante && origenSec.id === 'preguntas' && sec.id === 'contacto';
      const cabeceraEntra = !adelante && origenSec.id === 'contacto' && sec.id === 'preguntas';
      const tipoSale = adelante ? 'sale' : 'entra';
      const tipoEntra = adelante ? 'entra' : 'sale';
      // División (#proceso → #ayuda) y unión (#ayuda → #proceso): la insignia se cambia por las cuatro semillas
      const dividir = origenSec.id === 'proceso' && sec.id === 'ayuda';
      const unir = origenSec.id === 'ayuda' && sec.id === 'proceso';

      // Sub-paso de destino: primero (al entrar hacia delante, el primero; hacia atrás, el último)
      fijarPaso(sec, adelante ? 0 : subpasosDe(sec) - 1, false);

      // Fase 1 · despedida: la escena de origen sale; sus anclas quedan como formas
      origenSec.classList.remove('entrando');
      html.dataset.fase = 'salida';
      if (cabeceraSale || cabeceraEntra) html.dataset.cabecera = '1';
      origenSec.classList.add('saliendo');
      await esperar(DESPEDIDA);
      if (dividir) colocarSemillas();

      // Pares: solo los números presentes en ambos lados; el origen se mide ya sin movimiento de textos
      const origenEls: (HTMLElement | null)[] = [];
      const destinoEls: (HTMLElement | null)[] = [];
      const pares: number[] = [];
      for (let n = 1; n <= PARES && adyacente; n++) {
        const hayDestino = (cabeceraEntra && n === 1) || existeAncla(sec, tipoEntra, n);
        if (!hayDestino) continue;
        const el = cabeceraSale && n === 1 ? cabeceraCta() : anclaDe(origenSec, tipoSale, n);
        if (el) { origenEls[n] = el; pares.push(n); }
      }
      // La insignia sale de la captura vieja: las semillas ya son el mismo círculo en su sitio
      if (dividir) ocultarInsignia();
      if (dividir || unir) html.dataset.division = '1';
      html.dataset.dir = adelante ? 'adelante' : 'atras';
      for (const n of pares) {
        const el = origenEls[n]!;
        el.style.viewTransitionName = `ancla-${n}`;
        html.style.setProperty(`--ar-sale-${n}`, radioDe(el));
      }

      // Fase 2 · morph: la escena de destino llega en "llegando" (solo formas en la captura)
      const actualizar = () => {
        // El nombre de origen se quita aquí (la captura vieja ya está hecha): así el botón de cabecera no duplica el nombre del destino
        for (const n of pares) origenEls[n]!.style.viewTransitionName = '';
        origenSec.classList.remove('activa', 'saliendo');
        sec.classList.add('activa', 'llegando');
        html.dataset.fase = 'morph';
        // Al unirse, las semillas (ya visibles) reciben a los iconos; la insignia no entra en la captura nueva
        if (unir) { colocarSemillas(); ocultarInsignia(); }
        indice = destino;
        for (const n of pares) {
          const el = cabeceraEntra && n === 1 ? cabeceraCta() : anclaDe(sec, tipoEntra, n);
          if (!el) continue;
          el.style.viewTransitionName = `ancla-${n}`;
          destinoEls[n] = el;
          html.style.setProperty(`--ar-entra-${n}`, radioDe(el));
        }
        actualizarPuntos(true);
        history.replaceState(history.state, '', `#${sec.id}`);
      };

      // Fase 3 · llegada: los textos de la escena nueva suben; luego se libera la entrada
      const llegada = () => {
        for (const el of [...origenEls, ...destinoEls]) if (el) el.style.viewTransitionName = '';
        html.dataset.fase = 'llegada';
        sec.classList.remove('llegando');
        delete html.dataset.division;
        mostrarInsignia();
        // Al volver a #proceso, la insignia llega con su dígito rodando desde arriba
        if (unir) {
          const actual = procesoEl?.querySelector<HTMLElement>('.paso.actual') ?? null;
          if (actual) {
            actual.classList.add('llega', 'atras');
            window.setTimeout(() => actual.classList.remove('llega', 'atras'), 700);
          }
        }
        animarEntrada(sec);
        finVT = performance.now();
        setTimeout(() => {
          ocupado = false;
          acumulado = 0;
          delete html.dataset.fase;
          delete html.dataset.cabecera;
        }, LIBERA);
        sec.querySelector<HTMLElement>('h1[tabindex="-1"], h2[tabindex="-1"]')?.focus({ preventScroll: true });
      };

      if (!doc.startViewTransition) {
        actualizar();
        llegada();
        return;
      }
      let t: VT;
      try {
        t = doc.startViewTransition(actualizar);
      } catch {
        actualizar();
        llegada();
        return;
      }
      t.finished.then(llegada, llegada);
    };

    // Un paso hacia delante o atrás: primero el sub-paso de la escena actual, luego la escena vecina
    const avanzar = (dir: 1 | -1) => {
      if (!modo || ocupado || bloqueoPaso) return;
      const sec = escenas[indice];
      const siguiente = pasoDe(sec) + dir;
      if (siguiente >= 0 && siguiente < subpasosDe(sec)) {
        // En proceso solo cambian los pasos (la sección no se anima); en adopta se desliza la pista
        if (sec.dataset.subpasos === 'pasos') {
          cambiarPaso(sec, siguiente);
          bloqueoPaso = true;
          setTimeout(() => { bloqueoPaso = false; }, 450);
        } else {
          fijarPaso(sec, siguiente, true);
        }
        return;
      }
      void ir(indice + dir);
    };

    // ¿Puede moverse la rueda en esa dirección? (sub-paso o escena vecina)
    const puedeAvanzar = (dir: 1 | -1) => {
      const sec = escenas[indice];
      const sig = pasoDe(sec) + dir;
      return (sig >= 0 && sig < subpasosDe(sec)) || (indice + dir >= 0 && indice + dir < escenas.length);
    };

    // Rueda: acumula el desplazamiento; ignora inercia tras una transición
    addEventListener('wheel', (e) => {
      if (!modo || e.ctrlKey || e.metaKey) return;
      // Firefox con rueda de ratón envía líneas (deltaMode 1) o páginas (2), no píxeles
      const px = e.deltaMode === 1 ? e.deltaY * 40 : e.deltaMode === 2 ? e.deltaY * innerHeight : e.deltaY;
      const ahora = performance.now();
      if (ahora - ultimaRueda > 200) rafagaInterna = false;
      // Solo un textarea con scroll propio, en esa dirección, retiene la rueda; un select cerrado no
      const ta = cercano(e.target, 'textarea') as HTMLTextAreaElement | null;
      const taScroll = !!ta && (px > 0 ? ta.scrollTop + ta.clientHeight < ta.scrollHeight - 1 : ta.scrollTop > 0);
      if (ocupado || ahora - finVT < ESPERA_RUEDA || taScroll) {
        acumulado = 0;
        ultimaRueda = ahora;
        return;
      }
      if (scrollInterno(escenas[indice], px)) {
        // La ráfaga que desplazó el contenido no cambia de escena: hace falta otra que empiece en el tope
        rafagaInterna = true;
        acumulado = 0;
        ultimaRueda = ahora;
        return;
      }
      if (rafagaInterna) {
        acumulado = 0;
        ultimaRueda = ahora;
        return;
      }
      // (c) pausa de más de 200 ms: empieza un gesto nuevo
      if (ahora - ultimaRueda > 200) acumulado = 0;
      // (b) cambio de sentido: descarta lo acumulado en el sentido anterior
      if (acumulado !== 0 && Math.sign(acumulado) !== Math.sign(px)) acumulado = 0;
      ultimaRueda = ahora;
      acumulado += px;
      if (Math.abs(acumulado) < UMBRAL) return;
      const dir = acumulado > 0 ? 1 : -1;
      acumulado = 0;
      // (a) no se puede mover (primera/última escena y sub-paso): se descarta
      if (!puedeAvanzar(dir)) return;
      avanzar(dir);
    }, { passive: true, ...señal });

    // Teclado: flechas, AvPág, espacio, inicio y fin; no actúa dentro de campos ni sobre botones con espacio
    addEventListener('keydown', (e) => {
      if (!modo || e.ctrlKey || e.metaKey || e.altKey) return;
      const t = e.target as HTMLElement;
      if (cercano(t, 'input, textarea, select, [contenteditable]')) return;
      // Con el foco en el test (el enunciado recibe el foco al avanzar) las flechas y el espacio no cambian de escena
      if (cercano(t, '#form-test') && !['PageDown', 'PageUp', 'Home', 'End'].includes(e.key)) return;
      const enBoton = !!cercano(t, 'button, a, summary');
      const sec = escenas[indice];
      let dir: 1 | -1;
      switch (e.key) {
        case 'ArrowDown':
        case 'PageDown':
          dir = 1; break;
        case 'ArrowUp':
        case 'PageUp':
          dir = -1; break;
        case ' ':
          if (enBoton) return;
          dir = e.shiftKey ? -1 : 1; break;
        case 'Home':
          e.preventDefault(); void ir(0); return;
        case 'End':
          e.preventDefault(); void ir(escenas.length - 1); return;
        default:
          return;
      }
      if (scrollInterno(sec, dir)) return;
      e.preventDefault();
      avanzar(dir);
    }, señal);

    // Táctil: deslizar en vertical, con poco movimiento horizontal
    addEventListener('touchstart', (e) => {
      if (e.touches.length > 1) { tacto = null; multitoque = true; return; }
      tacto = null;
      multitoque = false;
      // Un campo solo bloquea el gesto si es un textarea/select o un input que ya tiene el foco (escribiendo)
      const campo = cercano(e.target, 'input');
      if (!modo || cercano(e.target, 'textarea, select') || (campo && campo === document.activeElement)) return;
      if ((window.visualViewport?.scale ?? 1) > 1.01) return;
      const t = e.touches[0];
      tacto = { x: t.clientX, y: t.clientY };
      // Contenedor con scroll propio bajo el dedo: se anota si ya estaba en el tope al empezar el gesto
      tactoScroll = null;
      let o = e.target instanceof Element ? e.target : null;
      while (o) {
        if (o instanceof HTMLElement && o.scrollHeight > o.clientHeight + 1 && /(auto|scroll)/.test(getComputedStyle(o).overflowY)) {
          tactoScroll = { el: o, top: o.scrollTop, enTope: o.scrollTop <= 0, enFondo: o.scrollTop + o.clientHeight >= o.scrollHeight - 1 };
          break;
        }
        if (o.classList.contains('diapo')) break;
        o = o.parentElement;
      }
    }, { passive: true, ...señal });
    addEventListener('touchend', (e) => {
      if (!modo || !tacto) return;
      if (multitoque || e.touches.length > 0 || (window.visualViewport?.scale ?? 1) > 1.01) { tacto = null; return; }
      const t = e.changedTouches[0];
      const dx = t.clientX - tacto.x;
      const dy = tacto.y - t.clientY;
      tacto = null;
      if (Math.abs(dy) < UMBRAL || Math.abs(dx) > Math.abs(dy) * 0.5) return;
      // Si el gesto desplazó un contenedor, o este no estaba en su tope al empezar, no cambia de escena
      if (tactoScroll && (tactoScroll.el.scrollTop !== tactoScroll.top || (dy > 0 ? !tactoScroll.enFondo : !tactoScroll.enTope))) return;
      if (scrollInterno(escenas[indice], dy)) return;
      avanzar(dy > 0 ? 1 : -1);
    }, { passive: true, ...señal });

    // Enlaces internos (con "#" o con la ruta de esta página). Se atienden en fase de captura, antes que el
    // router de Astro (ClientRouter), que si no los resuelve él mismo con su propio preventDefault.
    addEventListener('click', (e) => {
      if (!modo || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      const a = cercano(e.target, 'a[href]') as HTMLAnchorElement | null;
      if (!a) return;
      const u = new URL(a.href, location.href);
      if (u.origin !== location.origin || u.pathname !== location.pathname || !u.hash) return;
      const destino = indiceDe(decodeURIComponent(u.hash.slice(1)));
      if (destino < 0) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      // "Quiero conocer a X" preselecciona el motivo antes de ir a contacto
      if (a.dataset.adoptar && motivo) motivo.value = `Quiero adoptar a ${a.dataset.adoptar}`;
      cerrarMenu();
      void ir(destino);
    }, { capture: true, ...señal });

    // Atrás/adelante del navegador o un hash que no pasó por ir(): activa la escena sin transición
    addEventListener('hashchange', () => {
      if (!modo || ocupado) return;
      const destino = indiceDe(decodeURIComponent(location.hash.slice(1)));
      if (destino < 0 || destino === indice) return;
      escenas[indice].classList.remove('activa');
      indice = destino;
      escenas[destino].classList.add('activa');
      fijarPaso(escenas[destino], 0, false);
      actualizarPuntos();
    }, señal);

    // Filtro de especie: recuenta las fichas y vuelve a la primera
    const tarjetas = [...document.querySelectorAll<HTMLElement>('#lista-peludos > li')];
    const cuenta = document.getElementById('cuenta-peludos');
    const filtrar = () => {
      const valor = document.querySelector<HTMLInputElement>('input[name="filtro"]:checked')?.value ?? 'todos';
      tarjetas.forEach((t) => { t.hidden = valor !== 'todos' && t.dataset.especie !== valor; });
      if (cuenta) cuenta.textContent = String(tarjetas.filter((t) => !t.hidden).length);
      if (pistaPasos) fijarPaso(pistaPasos, 0, false);
    };
    filtrar();
    document.querySelectorAll<HTMLInputElement>('input[name="filtro"]').forEach((r) => r.addEventListener('change', filtrar, señal));

    // Teclado dentro de la pista: enfocar una ficha lleva la pista hasta ella
    const vista = pistaPasos?.querySelector<HTMLElement>('.vista') ?? null;
    vista?.addEventListener('scroll', () => { vista.scrollLeft = 0; }, señal);
    pistaPasos?.addEventListener('focusin', (e) => {
      if (!modo) return;
      const li = cercano(e.target, '#lista-peludos > li') as HTMLElement | null;
      if (!li) return;
      const idx = tarjetas.filter((t) => !t.hidden).indexOf(li);
      if (idx >= 0 && idx !== pasoDe(pistaPasos)) fijarPaso(pistaPasos, idx, true);
    }, señal);

    // "Quiero conocer a X" preselecciona el motivo del formulario (después el enlace lleva a contacto)
    const motivo = document.querySelector<HTMLSelectElement>('#c-motivo');
    document.querySelectorAll<HTMLAnchorElement>('[data-adoptar]').forEach((a) =>
      a.addEventListener('click', () => { if (motivo) motivo.value = `Quiero adoptar a ${a.dataset.adoptar}`; }, señal),
    );

    // Test de compatibilidad por pasos (la rueda no responde preguntas: el test es parte de la escena #test)
    const formTest = document.querySelector<HTMLFormElement>('#form-test');
    if (formTest) iniciarTest(formTest);

    // Formulario de contacto (demo, no envía datos)
    const form = document.querySelector<HTMLFormElement>('#form-contacto');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const nombre = form.querySelector<HTMLInputElement>('#c-nombre')!;
      const correo = form.querySelector<HTMLInputElement>('#c-correo')!;
      const ok = nombre.value.trim().length > 1 && correo.checkValidity() && correo.value.length > 3;
      document.getElementById('c-error')!.classList.toggle('hidden', ok);
      if (!ok) return;
      document.getElementById('c-quien')!.textContent = nombre.value.trim().split(' ')[0];
      form.classList.add('hidden');
      document.getElementById('c-exito')!.classList.remove('hidden');
    });

    // Activación del modo mazo: requisitos de navegador, movimiento y altura
    // Histéresis: se activa desde 560 px de alto y solo se desactiva por debajo de 480 (en iOS el alto cambia al plegar las barras)
    const modoPosible = () =>
      !!doc.startViewTransition &&
      matchMedia('(prefers-reduced-motion: no-preference)').matches &&
      (modo ? innerHeight >= 480 : innerHeight >= 560);

    // Asigna --k en orden del DOM dentro de cada escena (cascada de 30 ms)
    escenas.forEach((sec) =>
      sec.querySelectorAll<HTMLElement>('.sube, .revela').forEach((el, k) => el.style.setProperty('--k', String(k))),
    );

    const activar = (on: boolean) => {
      modo = on;
      html.classList.toggle('escenas', on);
      if (on) {
        escenas.forEach((sec, i) => sec.classList.toggle('activa', i === indice));
        escenas.forEach((sec) => { if (subpasosDe(sec) > 0 && sec.dataset.subpasos) fijarPaso(sec, pasoDe(sec), false); });
        actualizarPuntos();
      } else {
        escenas.forEach((sec) => sec.classList.remove('activa'));
      }
    };
    const evaluar = () => {
      const quiere = modoPosible();
      if (quiere !== modo) activar(quiere);
    };
    // Si la escena inicial viene con #ancla, se activa sin transición
    if (procesoEl) fijarPaso(procesoEl, 0, false);
    evaluar();
    let anchoPrev = innerWidth;
    let altoPrev = innerHeight;
    addEventListener('resize', () => {
      // Las barras del navegador (mismo ancho, menos de 120 px de alto) no reevalúan el modo, pero las semillas sí se recolocan
      if (innerWidth !== anchoPrev || Math.abs(innerHeight - altoPrev) >= 120) {
        anchoPrev = innerWidth;
        altoPrev = innerHeight;
        evaluar();
      }
      colocarSemillas();
    }, señal);
  }

  // Al salir de la página se limpian listeners y el modo mazo
  const ventana = window as Window & { __peludoEnlazado?: boolean };
  if (!ventana.__peludoEnlazado) {
    ventana.__peludoEnlazado = true;
    document.addEventListener('astro:before-swap', () => {
      cancelar?.abort();
      cancelar = null;
      document.documentElement.classList.remove('escenas', 'abriendo');
      document.documentElement.removeAttribute('data-dir');
      document.documentElement.removeAttribute('data-fase');
      document.documentElement.removeAttribute('data-cabecera');
    });
    // Llegada por navegación de cliente: el <html> llega sin la clase; se vuelve a poner, con la escena inicial
    // (por hash o la portada), antes del primer pintado. La carga directa lo hace el script del <head>.
    document.addEventListener('astro:after-swap', () => {
      const html = document.documentElement;
      const mazo = !!(document as DocVT).startViewTransition &&
        matchMedia('(prefers-reduced-motion: no-preference)').matches && innerHeight >= 560;
      html.classList.toggle('escenas', mazo);
      if (!mazo) return;
      const secciones = [...document.querySelectorAll<HTMLElement>('main > section.diapo')];
      let destino: HTMLElement | null = secciones[0] ?? null;
      try {
        const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        destino = (el?.closest('main > section.diapo') as HTMLElement | null) ?? destino;
      } catch { /* hash mal codificado: se queda la portada */ }
      secciones.forEach((s) => s.classList.toggle('activa', s === destino));
    });
  }
  document.addEventListener('astro:page-load', iniciarPeludo);
</script>
