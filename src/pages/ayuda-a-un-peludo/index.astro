    html.escenas .ficha .desc { font-size: .88rem; line-height: 1.3; margin-top: .3rem; }
    html.escenas .ficha .desc .sube { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; padding-block: .14em .22em; margin-block: -.14em -.22em; }
    html.escenas .ficha dl { flex-wrap: nowrap; gap: .3rem .7rem; padding-top: .45rem; }
