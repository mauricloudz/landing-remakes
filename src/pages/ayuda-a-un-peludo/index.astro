---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import frauncesNormal from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import frauncesItalic from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';
import Base from '../../layouts/Base.astro';
import Retrato from '../../components/peludo/Retrato.astro';
import Logo from '../../components/peludo/Logo.astro';
import Huella from '../../components/Huella.astro';
import { peludos, equipo } from '../../data/peludos';

const base = import.meta.env.BASE_URL;
const perros = peludos.filter((p) => p.especie === 'perro').length;
const gatos = peludos.length - perros;
const fondos = ['var(--menta)', 'var(--rosa)', '#f3e6c4', '#dfe7f5', '#f6d6cf', '#cfe9e3'];

// "Hoy hay seis esperando…": el número sale de los datos
const numeros = ['cero', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez'];
const cuantos = numeros[peludos.length] ?? String(peludos.length);
const enAdopcion = peludos.length;

// Titular de la portada. El * marca el énfasis.
const titular = [['Cada', 'peludo'], ['merece', 'un', '*hogar'], ['donde', 'lo', '*esperen.']].map((l) =>
  l.map((w) => ({ t: w.replace('*', ''), e: w.startsWith('*') })),
);

// Manifiesto en tres líneas: la del medio es la banda que viaja (no puede ir dentro de una máscara que se mueve)
const manifiestoA = 'Los rescatamos de la calle, los sanamos y les buscamos la familia que merecen. No vendemos animales:';
const manifiestoB = 'acompañamos adopciones responsables,';
const manifiestoC = 'antes, durante y después.';

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'NGO', name: 'Ayuda a un Peludo',
  description: 'ONG de rescate y adopción responsable de perros y gatos.',
  url: new URL(`${base}ayuda-a-un-peludo/`, Astro.site).toString(),
};

const ayudas = [
  { titulo: 'Adopta', texto: 'Dale un hogar definitivo a uno de nuestros peludos. Te acompañamos antes, durante y después.', icono: 'M12 21s-7-4.4-9.3-9A5.4 5.4 0 0 1 12 6a5.4 5.4 0 0 1 9.3 6c-2.3 4.6-9.3 9-9.3 9z' },
  { titulo: 'Sé hogar temporal', texto: 'Recibe a un peludo unas semanas mientras encuentra familia. Nosotros cubrimos alimento y veterinario.', icono: 'M3 11 12 3l9 8v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z' },
  { titulo: 'Únete como voluntario', texto: 'Paseos, baños, jornadas de adopción o difusión. Cada hora suma.', icono: 'M7 11V7a5 5 0 0 1 10 0v4M5 11h14v10H5z' },
  { titulo: 'Dona', texto: 'Alimento, mantas, remedios o un aporte mensual. Todo llega directo a los peludos.', icono: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6' },
];

const pasos = [
  { t: 'Conócelo', d: 'Mira las fichas, haz el test y elige al peludo que calza con tu vida.' },
  { t: 'Postula', d: 'Cuéntanos de tu hogar y tu rutina. Respondemos en menos de 48 horas.' },
  { t: 'Visítalo', d: 'Coordinamos un encuentro para que se conozcan sin apuro.' },
  { t: 'Llévalo a casa', d: 'Firmamos un compromiso de adopción responsable y te acompañamos el primer mes.' },
];

const preguntas = [
  { p: '¿Adoptar tiene costo?', r: 'No. Solo pedimos un compromiso de tenencia responsable. Todos se entregan con vacunas al día y microchip.' },
  { p: '¿Qué pasa si no funciona?', r: 'Si la convivencia no resulta, el peludo vuelve con nosotros. Nunca debe quedar en la calle ni pasar a terceros sin avisarnos.' },
  { p: '¿Puedo adoptar si vivo en departamento?', r: 'Sí. En cada ficha indicamos qué peludos se adaptan bien a espacios pequeños.' },
  { p: '¿Por qué algunos no están esterilizados?', r: 'Son cachorros todavía muy pequeños. La esterilización se coordina con la familia cuando tienen la edad adecuada.' },
];

// Escenas del mazo, en orden. El nombre es el que lee el lector de pantalla en el navegador de escenas.
const secciones = [
  ['inicio', 'Portada'], ['mensaje', 'Mensaje'], ['nosotros', 'Quiénes somos'], ['adopta', 'Adopta'], ['test', 'Test'],
  ['proceso', 'Proceso'], ['ayuda', 'Cómo ayudar'], ['equipo', 'Equipo'], ['preguntas', 'Preguntas'], ['contacto', 'Contacto'],
];

const filtros = [['todos', `Todos (${peludos.length})`], ['perro', `Perros (${perros})`], ['gato', `Gatos (${gatos})`]];
const iniciales = (nombre: string) => nombre.split(' ').map((w) => w[0]).slice(0, 2).join('');
---
<Base titulo="Ayuda a un Peludo · Adopta un perro o un gato" descripcion="ONG de rescate de perros y gatos. Conoce a los peludos que buscan familia, descubre cuál calza contigo y aprende cómo ayudar." tema="peludo" jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preload" as="font" type="font/woff2" href={frauncesNormal} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={frauncesItalic} crossorigin />
    <!-- Decide el modo mazo antes del primer pintado (mismas condiciones que el script del módulo).
         Sin hash y con movimiento permitido, la portada se abre con su entrada (clase abriendo, 1,5 s). -->
    <script is:inline>
      (function () {
        var h = document.documentElement;
        var hash = location.hash.slice(1);
        h.dataset.inicio = hash;
        var mazo = !!document.startViewTransition && matchMedia('(prefers-reduced-motion: no-preference)').matches && innerHeight >= 560;
        if (!mazo) return;
        h.classList.add('escenas');
        if (!hash) {
          h.classList.add('abriendo');
          setTimeout(function () { h.classList.remove('abriendo'); }, 1500);
        }
      })();
    </script>
  </Fragment>
  <header class="cabecera fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-8">
    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-full border border-tinta/10 bg-fondo/90 py-2 pl-4 pr-2 backdrop-blur-md" aria-label="Principal">
      <a href={`${base}ayuda-a-un-peludo/`} class="flex items-center gap-2.5 font-display text-lg font-semibold">
        <Logo class="size-9" /> Ayuda a un Peludo
      </a>
      <div class="lw cab-lw hidden md:block">
        <ul class="flex items-center text-sm font-medium text-suave">
          <li><a class="hover:text-tinta" href="#adopta">Adopta</a></li>
          <li><a class="hover:text-tinta" href="#test">¿Cuál es para ti?</a></li>
          <li><a class="hover:text-tinta" href="#ayuda">Cómo ayudar</a></li>
          <li><a class="hover:text-tinta" href="#equipo">Equipo</a></li>
          <li><a class="hover:text-tinta" href="#preguntas">Preguntas</a></li>
        </ul>
      </div>
      <a id="cta-cabecera" href="#contacto" class="hidden rounded-full bg-tinta px-5 py-2.5 text-sm font-semibold text-fondo transition hover:bg-marca md:inline-flex"><span class="rotulo">Quiero adoptar</span></a>
      <button class="rounded-full bg-tinta px-5 py-2.5 text-sm font-semibold text-fondo md:hidden" popovertarget="menu-movil" aria-label="Abrir menú">Menú</button>
      <div id="menu-movil" popover class="menu-movil m-0 ml-auto h-dvh w-[min(84vw,320px)] bg-fondo p-6 shadow-2xl">
        <button popovertarget="menu-movil" popovertargetaction="hide" class="mb-8 text-sm font-medium text-suave">Cerrar ✕</button>
        <ul class="space-y-5 font-display text-2xl">
          <li><a href="#adopta">Adopta</a></li><li><a href="#test">¿Cuál es para ti?</a></li><li><a href="#ayuda">Cómo ayudar</a></li>
          <li><a href="#equipo">Equipo</a></li><li><a href="#preguntas">Preguntas</a></li><li><a href="#contacto" class="text-marca-fuerte">Quiero adoptar</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <main id="contenido">
    <!-- 1 · INICIO: portada con el arco que se abre hacia la siguiente escena -->
    <section id="inicio" class="diapo portada activa" aria-labelledby="t-inicio">
      <div class="plano">
        <div class="portada-grid">
          <div class="portada-texto">
            <p class="kick mini chip-etiqueta" data-ancla-sale="3"><Huella class="size-4" /><span class="rotulo">ONG de rescate de animalitos</span></p>
            <h1 id="t-inicio" class="disp" tabindex="-1">
              {titular.map((linea) => (
                <span class="mask l"><span class="sube">
                  {linea.map((w, j) => (<>{j > 0 ? ' ' : ''}<span class:list={[{ enf: w.e }]}>{w.t}</span></>))}
                </span></span>
              ))}
            </h1>
            <div class="cta-portada">
              <a href="#adopta" class="btn btn-lleno revela">Conocer a los peludos <span aria-hidden="true">→</span></a>
              <a href="#test" class="btn btn-borde revela">Hacer el test</a>
            </div>
          </div>
          <div class="escenario" aria-hidden="true">
            <div class="arco" data-ancla-sale="1"></div>
            <div class="retrato-hero" data-ancla-sale="2"><Retrato peludo={peludos[0]} sufijo="hero" fondo="var(--menta)" /></div>
          </div>
        </div>
        <p class="pista-hint mini revela" aria-hidden="true">Rueda, flechas o puntos para avanzar</p>
      </div>
    </section>

    <!-- 2 · MENSAJE: fondo menta completo; el arco llega aquí y el retrato queda centrado -->
    <section id="mensaje" class="diapo mensaje" aria-labelledby="t-mensaje">
      <div class="fondo-ancla" data-ancla-entra="1" data-ancla-sale="2" aria-hidden="true"><Huella class="motivo" /></div>
      <div class="plano centro">
        <p class="chip-etiqueta chip-mensaje mini" data-ancla-entra="3" data-ancla-sale="3"><span class="rotulo">Hoy · {enAdopcion} en adopción</span></p>
        <h2 id="t-mensaje" class="disp" tabindex="-1"><span class="mask"><span class="sube">Hoy hay <span class="enf">{cuantos}</span> esperando a alguien como tú.</span></span></h2>
        <div class="retrato-mensaje" data-ancla-entra="2" data-ancla-sale="1" aria-hidden="true"><Retrato peludo={peludos[0]} sufijo="mensaje" fondo="var(--superficie)" /></div>
      </div>
    </section>

    <!-- 3 · NOSOTROS: manifiesto con la insignia del retrato junto a la etiqueta -->
    <section id="nosotros" class="diapo manif" aria-labelledby="t-manif">
      <div class="plano">
        <div class="manif-cab">
          <span class="insignia" data-ancla-entra="1" data-ancla-sale="1" aria-hidden="true"><Retrato peludo={peludos[0]} sufijo="insignia" fondo="var(--menta)" /></span>
          <h2 id="t-manif" class="mini chip-etiqueta chip-manif" tabindex="-1" data-ancla-entra="3" data-ancla-sale="3"><span class="rotulo">Quiénes somos</span></h2>
        </div>
        <p class="txt disp">
          <span class="linea"><span class="mask"><span class="sube">{manifiestoA}</span></span></span>
          <span class="linea"><span class="banda" data-ancla-entra="2" data-ancla-sale="2"><span class="rotulo enf">{manifiestoB}</span></span></span>
          <span class="linea"><span class="mask"><span class="sube">{manifiestoC}</span></span></span>
        </p>
      </div>
    </section>

    <!-- 4 · ADOPTA: una ficha grande a la vez; cada paso desplaza la pista. Al final, el botón del test -->
    <section id="adopta" class="diapo galeria oscuro" data-subpasos="tarjetas" aria-labelledby="t-adopta">
      <div class="plano">
        <div class="galeria-cab">
          <p class="cab mini chip-etiqueta chip-adopta" data-ancla-entra="3"><span class="rotulo">En adopción · <span id="cuenta-peludos">{peludos.length}</span> peludos</span></p>
          <h2 id="t-adopta" class="disp" tabindex="-1"><span class="mask"><span class="sube">Ellos te <i>esperan</i></span></span></h2>
          <p class="bajada"><span class="mask"><span class="sube">Cada uno tiene su ficha completa. Elige a quien quieras conocer o descubre con el test quién calza contigo.</span></span></p>
          <p class="hint revela">Usa la rueda o las flechas: cada peludo toma el centro.</p>
          <fieldset class="filtros">
            <legend class="sr-only">Filtrar por especie</legend>
            {filtros.map(([v, l], i) => (
              <label data-ancla-entra="2" data-ancla-sale="3">
                <input type="radio" name="filtro" value={v} class="sr-only" checked={i === 0} /><span class="rotulo">{l}</span>
              </label>
            ))}
          </fieldset>
        </div>

        <div class="vista">
          <ul id="lista-peludos" class="pista-fichas" role="list">
            {peludos.map((p, i) => (
              <li data-especie={p.especie} class="ficha">
                <div class="img" data-ancla-entra="1" data-ancla-sale="2">
                  <span class="num" aria-hidden="true"><span class="rotulo">N.º {i + 1}</span></span>
                  <Retrato peludo={p} sufijo="gal" fondo={fondos[i]} class="retrato-ficha" />
                </div>
                <div class="dat revela">
                  <div>
                    <p class="mini esp">{p.especie === 'perro' ? 'Perro' : 'Gato'}</p>
                    <h3 class="disp"><span class="mask"><span class="sube">{p.nombre}</span></span></h3>
                    <p class="desc"><span class="mask"><span class="sube">{p.personalidad}</span></span></p>
                  </div>
                  <div class="pie">
                    <dl>
                      <div><dt>Edad</dt><dd>{p.edad}</dd></div>
                      <div><dt>Género</dt><dd>{p.genero}</dd></div>
                      <div><dt>Esterilizado</dt><dd>{p.esterilizado ? 'Sí' : 'Aún no'}</dd></div>
                    </dl>
                    <p class="chip">Chip N.º {p.chip}</p>
                    <a href="#contacto" data-adoptar={p.nombre} class="btn btn-tinta"><span class="rotulo">Quiero conocer a {p.nombre}</span> <span aria-hidden="true">→</span></a>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="fin">
          <p class="fin-texto disp"><span class="mask"><span class="sube">¿No sabes cuál es <i>para ti?</i></span></span></p>
          <a href="#test" class="btn btn-mostaza" data-ancla-sale="1"><span class="rotulo">Haz el test de 20 segundos</span></a>
        </div>
      </div>
    </section>

    <!-- 5 · TEST: el botón "Ver mi resultado" se convierte en la escena de los pasos -->
    <section id="test" class="diapo test" aria-labelledby="t-test">
      <div class="fondo-ancla" data-ancla-entra="1" aria-hidden="true"><Huella class="motivo" /></div>
      <div class="plano test-grid">
        <div class="test-texto">
          <p class="mini eyebrow"><span class="mask"><span class="sube">Test de 20 segundos</span></span></p>
          <span class="badge-test" data-ancla-entra="2" data-ancla-sale="2" aria-hidden="true"><Huella class="size-6" /></span>
          <h2 id="t-test" class="disp secc-h" tabindex="-1"><span class="mask"><span class="sube">¿Qué peludo es para ti?</span></span></h2>
          <p class="lead"><span class="mask"><span class="sube">Tres preguntas sobre tu vida y te mostramos con quién harías mejor equipo.</span></span></p>
        </div>
        <!-- Test por pasos (Stepper): una pregunta a la vez; el último paso es el resultado. Las tres preguntas y el resultado
             están en el HTML (sin JavaScript se leen todas); el script deja visible solo la actual. -->
        <form id="form-test" class="testform" data-peludos={JSON.stringify(peludos.map(({ id, especie, energia, espacio }) => ({ id, especie, energia, espacio })))}>
          <div class="st-prog">
            <span class="st-linea" aria-hidden="true"><span class="st-relleno"></span></span>
            <ol class="st-pasos" role="list" aria-label="Progreso del test">
              {['Hogar', 'Ritmo', 'Especie', 'Resultado'].map((t, i) => (
                <li class="st-paso" data-estado={i === 0 ? 'actual' : 'pendiente'} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="st-dot" data-ancla-sale={i === 0 ? 1 : undefined}><span class="st-pt"></span><svg class="st-chk" viewBox="0 0 24 24" aria-hidden="true"><path pathLength="1" d="M7 12.6l3.6 3.6L17.4 8.4" /></svg></span>
                  <span class="st-et"><span class="rotulo">{t}</span></span>
                </li>
              ))}
            </ol>
          </div>
          <div class="st-etapa" data-fase="reposo" data-dir="adelante">
            {[
              { n: 'espacio', q: '¿Dónde vives?', o: [['depto', 'Departamento'], ['casa', 'Casa con patio']] },
              { n: 'energia', q: '¿Cómo es tu ritmo?', o: [['tranquilo', 'Tranquilo, de sofá'], ['activo', 'Activo, de paseos']] },
              { n: 'especie', q: '¿Qué prefieres?', o: [['perro', 'Perro'], ['gato', 'Gato'], ['cualquiera', 'Me da igual']] },
            ].map((g, gi) => (
              <fieldset class:list={['preg', 'st-pane', { 'st-actual': gi === 0 }]} data-paso={gi}>
                <legend tabindex="-1"><span class="mask"><span class="sube"><span class="rise" style="--s:0"><span class="num">0{gi + 1}</span>{g.q}</span></span></span></legend>
                <div class="opciones">
                  {g.o.map(([v, l], oi) => (
                    <div class="op-mask">
                      <label class="opcion revela rise" style={`--s:${oi + 1}`} data-ancla-entra={oi === 0 ? 3 : undefined} data-ancla-sale={oi === 0 ? 3 : undefined}>
                        <input type="radio" name={g.n} value={v} required class="sr-only" /><span class="rotulo">{l}</span>
                      </label>
                    </div>
                  ))}
                </div>
              </fieldset>
            ))}
            <div id="resultado" class="st-pane res" data-paso="3" aria-live="polite">
              <p class="mini eyebrow" tabindex="-1"><span class="mask"><span class="sube"><span class="rise" style="--s:0">Tu mejor compañía</span></span></span></p>
              <div class="resultados">
                {peludos.map((p, i) => (
                  <div data-resultado={p.id} class="resultado hidden">
                    <Retrato peludo={p} sufijo="test" fondo={fondos[i]} class="w-full" />
                    <p class="nombre">{p.nombre}</p>
                    <p class="meta">{p.edad} · {p.especie === 'perro' ? 'Perro' : 'Gato'}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="st-pie">
            <button type="button" class="btn btn-borde" data-volver disabled><span class="rotulo">← Volver</span></button>
            <small class="revela" data-info>Paso 1 de 3</small>
          </div>
        </form>
      </div>
    </section>

    <!-- 6 · PROCESO: un paso a la vez, con su numeral grande -->
    <section id="proceso" class="diapo proceso" data-subpasos="pasos" aria-labelledby="t-proceso">
      <div class="plano">
        <h2 id="t-proceso" class="etiqueta-proceso" tabindex="-1"><span class="mask"><span class="sube">Adopción responsable en {numeros[pasos.length] ?? pasos.length} pasos</span></span></h2>
        <!-- Semillas de la división: cuatro círculos bajo la insignia del paso actual (solo modo mazo; su posición la fija colocarSemillas) -->
        <span class="semilla" data-ancla-sale="1" aria-hidden="true"></span>
        <span class="semilla" data-ancla-sale="2" aria-hidden="true"></span>
        <span class="semilla" data-ancla-sale="3" aria-hidden="true"></span>
        <span class="semilla" data-ancla-sale="4" aria-hidden="true"></span>
        <ol class="pasos" role="list">
          {pasos.map((s, i) => (
            <li class:list={['paso', { actual: i === 0 }]} data-n={i + 1}>
              <span class="fantasma" data-ancla-entra="2" aria-hidden="true"><span class="rotulo">{i + 1}</span></span>
              <span class="numeral" data-ancla-entra="1" aria-hidden="true"><span class="rotulo">{i + 1}</span></span>
              <div class="paso-texto">
                <h3 class="disp"><span class="mask"><span class="sube">{s.t}</span></span></h3>
                <p><span class="mask"><span class="sube">{s.d}</span></span></p>
              </div>
            </li>
          ))}
        </ol>
        <div class="barras" data-ancla-entra="3" aria-hidden="true">
          {pasos.map((_, i) => <i class:list={[{ hecha: i === 0 }]}></i>)}
        </div>
      </div>
    </section>

    <!-- 7 · CÓMO AYUDAR -->
    <section id="ayuda" class="diapo ayuda" aria-labelledby="t-ayuda">
      <div class="plano">
        <p class="mini eyebrow"><span class="mask"><span class="sube">Cómo ayudar</span></span></p>
        <h2 id="t-ayuda" class="disp secc-h" tabindex="-1" style="max-width:16ch"><span class="mask"><span class="sube">No necesitas adoptar para cambiarle la vida a un peludo</span></span></h2>
        <ul class="ayuda-lista" role="list">
          {ayudas.map((a, i) => (
            <li class="spot spot-claro">
              <span class="icono-ayuda" data-ancla-entra={i + 1} data-ancla-sale={i + 1} aria-hidden="true">
                <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={a.icono} /></svg>
              </span>
              <h3 class="disp"><span class="mask"><span class="sube">{a.titulo}</span></span></h3>
              <p><span class="mask"><span class="sube">{a.texto}</span></span></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8 · EQUIPO -->
    <section id="equipo" class="diapo equipo" aria-labelledby="t-equipo">
      <div class="plano">
        <p class="mini eyebrow"><span class="mask"><span class="sube">Nuestro equipo</span></span></p>
        <h2 id="t-equipo" class="disp secc-h" tabindex="-1" style="max-width:16ch"><span class="mask"><span class="sube">Las personas detrás de cada rescate</span></span></h2>
        <ul class="equipo-lista" role="list">
          {equipo.map((m, i) => (
            <li>
              <span class="avatar" style={`background:${m.color}`} data-ancla-entra={i < 4 ? i + 1 : undefined} data-ancla-sale={i < 4 ? i + 1 : undefined} aria-hidden="true"><span class="rotulo">{iniciales(m.nombre)}</span></span>
              <h3 class="disp"><span class="mask"><span class="sube">{m.nombre}</span></span></h3>
              <p class="rol mini"><span class="mask"><span class="sube">{m.rol}</span></span></p>
              <p class="texto"><span class="mask"><span class="sube">{m.texto}</span></span></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9 · PREGUNTAS: maestro-detalle en escritorio; acordeón en el móvil -->
    <section id="preguntas" class="diapo preguntas" aria-labelledby="t-preguntas">
      <div class="plano">
        <h2 id="t-preguntas" class="disp secc-h" tabindex="-1"><span class="mask"><span class="sube">Preguntas frecuentes</span></span></h2>
        <div class="preguntas-grid">
          <div class="faq">
              {preguntas.map((q, i) => (
                <details class="pregunta" name="faq" open={i === 0}>
                  <summary>
                    <span class="barra-activa" aria-hidden="true"></span>
                    <span class="mask"><span class="sube">{q.p}</span></span>
                    <span class="icono" aria-hidden="true" data-ancla-entra={i + 1} data-ancla-sale={i === 0 ? 2 : undefined}><span class="rotulo">+</span></span>
                  </summary>
                  <div class="respuesta">
                    <p class="resp-num mini"><span class="mask"><span class="sube">Respuesta {String(i + 1).padStart(2, '0')}</span></span></p>
                    <p class="resp-texto"><span class="mask"><span class="sube">{q.r}</span></span></p>
                  </div>
                </details>
              ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 10 · CONTACTO: el fondo terracota se abre desde el botón de la cabecera; el pie va al final de la escena -->
    <section id="contacto" class="diapo cierre" aria-labelledby="t-contacto">
      <div class="iris" data-ancla-entra="1" aria-hidden="true"><Huella class="motivo" /></div>
      <div class="plano">
        <h2 id="t-contacto" class="disp" tabindex="-1"><span class="mask"><span class="sube">Escríbenos</span></span></h2>
        <div class="cierre-grid">
          <div class="cierre-texto">
            <p><span class="mask"><span class="sube">Para adoptar, ser hogar temporal o sumarte como voluntario. Respondemos en menos de 48 horas.</span></span></p>
            <span class="huella-marca" data-ancla-entra="2" aria-hidden="true"><Huella class="huella-cierre" /></span>
          </div>
          <div class="tarjeta-form">
            <div class="tarjeta-cuerpo">
              <form id="form-contacto" novalidate>
                <div class="campos-fila">
                  <div class="campo" style="--c: 0">
                    <label for="c-nombre"><span class="mask"><span class="sube">Nombre</span></span></label>
                    <input id="c-nombre" name="nombre" required autocomplete="name" />
                  </div>
                  <div class="campo" style="--c: 1">
                    <label for="c-correo"><span class="mask"><span class="sube">Correo</span></span></label>
                    <input id="c-correo" name="correo" type="email" required autocomplete="email" />
                  </div>
                </div>
                <div class="campo" style="--c: 2">
                  <label for="c-motivo"><span class="mask"><span class="sube">Motivo</span></span></label>
                  <select id="c-motivo" name="motivo" class="campo-cierra">
                    <option>Quiero adoptar</option>
                    {peludos.map((p) => <option>Quiero adoptar a {p.nombre}</option>)}
                    <option>Hogar temporal</option><option>Voluntariado</option><option>Donaciones</option>
                  </select>
                </div>
                <div class="campo" style="--c: 3">
                  <label for="c-mensaje"><span class="mask"><span class="sube">Mensaje</span></span></label>
                  <textarea id="c-mensaje" name="mensaje" rows="2" class="campo-cierra"></textarea>
                </div>
                <p id="c-error" class="error hidden" role="alert">Revisa tu nombre y tu correo.</p>
                <button class="btn btn-tinta btn-ancho btn-enviar"><span class="mask"><span class="sube">Enviar</span></span></button>
                <p class="demo">Sitio de demostración: este formulario no envía datos.</p>
              </form>
              <div id="c-exito" class="exito-caja hidden" aria-live="polite">
                <svg viewBox="0 0 52 52" class="exito mx-auto size-20" aria-hidden="true"><circle cx="26" cy="26" r="24" fill="none" stroke="var(--acento)" stroke-width="3" /><path d="m15 27 7 7 15-15" fill="none" stroke="var(--acento)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <p class="gracias">¡Gracias, <span id="c-quien"></span>!</p>
                <p class="demo">En una ONG real, aquí te escribiríamos en menos de 48 horas.</p>
              </div>
            </div>
          </div>
        </div>
        <footer class="pie-cierre revela">
          <p class="flex items-center gap-3"><Logo class="size-9" /> Ayuda a un Peludo · Sitio de demostración. La ONG y las personas son ficticias.</p>
          <a href={base} class="font-semibold underline-offset-4 hover:underline">← Ver el antes y después</a>
        </footer>
      </div>
    </section>
  </main>
  <!-- Escena inicial por hash: mueve .activa antes del primer pintado, para que el modo mazo no muestre la escena equivocada -->
  <script is:inline>
    (function () {
      var h = document.documentElement;
      if (!h.classList.contains('escenas') || !h.dataset.inicio) return;
      var sec = null;
      try {
        var el = document.getElementById(decodeURIComponent(h.dataset.inicio));
        sec = el && el.closest('main > section.diapo');
      } catch (e) { sec = null; }
      if (!sec) return;
      document.querySelectorAll('main > section.diapo.activa').forEach(function (s) { s.classList.remove('activa'); });
      sec.classList.add('activa');
    })();
  </script>

  <nav class="puntos-nav" aria-label="Secciones">
    <ol>
      {secciones.map(([id, nombre]) => (
        <li><a href={`#${id}`}><span class="sr-only">{nombre}</span></a></li>
      ))}
    </ol>
  </nav>
</Base>

<style is:global>
  /* =====================================================================
     Editorial · Ayuda a un Peludo
     Orden: base (página normal, legible con scroll) → modo "mazo" (html.escenas).
     El modo mazo solo se activa con startViewTransition, movimiento permitido y alto >= 560 px.
     Ningún estilo del modo mazo aplica fuera de html.escenas.
     ===================================================================== */

  :root {
    --friccion: cubic-bezier(0.16, 1, 0.3, 1);
    --encastre: cubic-bezier(0.87, 0, 0.13, 1);
    --hueco-faq: 4rem;
    interpolate-size: allow-keywords;
  }

  /* Cabecera: los enlaces llevan 14 px de relleno a cada lado y el contenedor lo compensa con margen. El texto queda donde
     estaba y la píldora (que se desliza detrás del enlace activo) tiene cuerpo alrededor de cada palabra. */
  .cab-lw { margin-inline: -14px; --pill-bg: var(--marca); --pill-fg: #fff; }
  .cab-lw a { display: block; padding: 8px 14px; border-radius: 999px; }

  /* ---------- Tipografía y piezas comunes ---------- */
  .mini { font-family: var(--fuente-cuerpo); font-size: .72rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; line-height: 1.4; }
  .disp { font-family: var(--fuente-display); font-weight: 300; letter-spacing: -.04em; line-height: .95; }
  .enf { color: var(--marca); font-style: italic; }
  .secc-h { font-size: clamp(2.4rem, 6.2vw, 5.5rem); }
  .eyebrow { color: var(--marca-fuerte); margin-bottom: 1.1rem; }
  .wrap { max-width: 72rem; margin-inline: auto; padding-inline: clamp(18px, 5vw, 56px); }
  .oscuro :focus-visible { outline-color: var(--mostaza); }
  .oscuro .ficha :focus-visible { outline-color: var(--acento); }
  .plano { max-width: 72rem; margin-inline: auto; padding-inline: clamp(18px, 5vw, 56px); }
  .diapo h2[tabindex="-1"]:focus { outline: none; }
  .pista-hint, .hint { display: none; }
  /* Holgura vertical sin cambiar el diseño: el margen negativo compensa el relleno. Así las descendentes
     (g, p, y, q, j) y los acentos altos no quedan cortados por las máscaras ni por el recorte de los rótulos. */
  .rotulo { display: inline-block; padding-block: .14em .22em; margin-block: -.14em -.22em; }
  .chip-etiqueta { display: inline-flex; align-items: center; gap: .5rem; border-radius: 999px; padding: .5rem .95rem; }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; border-radius: 999px; padding: .95rem 1.6rem; font-size: .95rem; font-weight: 600; line-height: 1.2; text-align: center; border: 2px solid transparent; transition: background-color .3s var(--friccion), color .3s var(--friccion), border-color .3s var(--friccion), transform .3s var(--friccion); cursor: pointer; }
  .btn:hover { transform: translateY(-2px); }
  .btn-lleno { background: var(--marca); color: #fff; }
  .btn-lleno:hover { background: var(--marca-fuerte); }
  .btn-borde { border-color: color-mix(in srgb, var(--tinta) 30%, transparent); color: var(--tinta); }
  .btn-borde:hover { border-color: var(--tinta); }
  .btn-tinta { background: var(--tinta); color: var(--fondo); }
  .btn-tinta:hover { background: var(--marca-fuerte); }
  .btn-mostaza { background: var(--mostaza); color: var(--ciruela); }
  .btn-mostaza:hover { background: #f3c961; }
  .btn-ancho { width: 100%; }

  .menu-movil:popover-open { animation: menu-entra .4s var(--friccion); }
  .menu-movil::backdrop { background: rgb(43 29 43 / .4); backdrop-filter: blur(4px); }
  @keyframes menu-entra { from { transform: translateX(100%); } }
  /* Respaldo sin Popover API (Safari 16): el panel se muestra con la clase .abierto */
  @supports not selector(:popover-open) {
    .menu-movil { display: none; position: fixed; inset: 0 0 0 auto; z-index: 60; }
    .menu-movil.abierto { display: block; animation: menu-entra .4s var(--friccion); }
  }

  /* ---------- Base · 1 Inicio ---------- */
  .portada { background: var(--fondo); padding: 7.5rem 0 4.5rem; }
  .portada .plano { display: grid; justify-items: center; }
  .portada-grid { display: grid; justify-items: center; gap: 2rem; text-align: center; width: 100%; }
  .portada .kick { color: var(--marca-fuerte); margin: 0; background: color-mix(in srgb, var(--marca) 12%, transparent); }
  .portada h1 { font-size: clamp(2.7rem, 11vw, 7rem); line-height: .95; letter-spacing: -.045em; margin: 0; }
  .portada h1 .l { display: block; }
  .escenario { position: relative; width: min(74vw, 340px); aspect-ratio: 4 / 5; overflow: clip; }
  .arco { position: absolute; inset: 0; background: var(--menta); border-radius: 999px 999px 0 0; }
  .retrato-hero { position: absolute; left: 50%; bottom: -2%; width: 90%; translate: -50% 0; transform-origin: 50% 100%; }
  .retrato-hero svg { width: 100%; height: auto; }
  .cta-portada { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; }

  /* ---------- Base · 2 Mensaje ---------- */
  .mensaje { background: var(--menta); padding: clamp(5rem, 12vw, 9rem) 0; }
  .mensaje .plano { display: grid; justify-items: center; gap: 2.5rem; text-align: center; }
  .mensaje h2 { font-size: clamp(2.2rem, 5.4vw, 4.6rem); line-height: 1.02; letter-spacing: -.03em; max-width: 16ch; margin: 0; }
  .chip-mensaje { background: var(--fondo); color: var(--tinta); }
  .retrato-mensaje { width: min(60vw, 300px); aspect-ratio: 1; }
  .retrato-mensaje svg { width: 100%; height: 100%; display: block; }
  .fondo-ancla { display: none; }

  /* ---------- Base · 3 Nosotros ---------- */
  .manif { background: var(--fondo); padding: clamp(5rem, 12vw, 9rem) 0; }
  .manif-cab { display: flex; align-items: center; gap: 1.1rem; margin-bottom: 2rem; }
  .manif h2 { color: var(--marca); margin: 0; font-weight: 600; background: color-mix(in srgb, var(--marca) 12%, transparent); }
  .insignia { display: block; flex: none; width: 4.5rem; aspect-ratio: 1; border-radius: 50%; overflow: hidden; }
  .insignia svg { width: 100%; height: 100%; display: block; }
  .manif .txt { font-size: clamp(1.9rem, 4.3vw, 4.5rem); line-height: 1.12; letter-spacing: -.025em; margin: 0; }
  .manif .linea { display: block; }
  .banda { display: inline-block; background: var(--menta); color: var(--tinta); border-radius: .14em; padding: 0 .16em; font-style: italic; }

  /* ---------- Base · 4 Adopta (galería) ---------- */
  .galeria { background: var(--ciruela); color: var(--fondo); padding: clamp(5rem, 12vw, 9rem) 0; }
  .galeria .cab { color: var(--mostaza); margin: 0 0 1.5rem; background: color-mix(in srgb, var(--mostaza) 20%, transparent); justify-self: start; }
  .galeria h2 { font-size: clamp(3.2rem, 9vw, 8rem); line-height: .9; letter-spacing: -.045em; margin: 0; }
  .galeria h2 i { color: var(--mostaza); }
  .galeria .bajada { margin: 1.6rem 0 0; color: #d9cbd6; max-width: 34ch; font-size: 1.05rem; line-height: 1.5; }
  .filtros { display: inline-flex; flex-wrap: wrap; margin: 2rem 0 0; padding: 4px; border: 1px solid rgb(255 255 255 / .3); border-radius: 999px; min-width: 0; }
  .filtros label { cursor: pointer; border-radius: 999px; padding: .55rem 1.1rem; font-size: .875rem; font-weight: 600; transition: background-color .3s var(--friccion), color .3s var(--friccion); }
  .filtros label:has(:checked) { background: var(--mostaza); color: var(--ciruela); }
  .filtros label:has(:focus-visible) { outline: 3px solid var(--mostaza); outline-offset: 2px; }
  .vista { margin-top: 3.5rem; }
  #lista-peludos { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  #lista-peludos > li[hidden] { display: none; }
  .ficha { position: relative; display: flex; flex-direction: column; background: var(--fondo); color: var(--tinta); border-radius: 28px; overflow: hidden; }
  .ficha .img { position: relative; background: var(--bg); aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha .retrato-ficha { position: absolute; left: 50%; bottom: -6%; width: min(72%, 15rem); height: auto; translate: -50% 0; transform-origin: 50% 100%; }
  .ficha .num { position: absolute; top: 1rem; left: 1.25rem; font-family: var(--fuente-display); font-style: italic; font-size: 1.15rem; z-index: 1; }
  .ficha .dat { display: flex; flex: 1; flex-direction: column; justify-content: space-between; gap: 1.25rem; padding: clamp(1.25rem, 2.4vw, 2.25rem); }
  .ficha .esp { color: var(--marca); margin: 0 0 .5rem; }
  .ficha h3 { font-size: clamp(2.6rem, 5vw, 4.4rem); line-height: .9; margin: 0; }
  .ficha .desc { font-family: var(--fuente-display); font-size: clamp(1.05rem, 1.5vw, 1.45rem); line-height: 1.3; margin: .9rem 0 0; letter-spacing: -.005em; }
  .ficha dl { display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; margin: 0; padding-top: 1rem; border-top: 1px solid var(--linea); }
  .ficha dt { color: var(--suave); font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; }
  .ficha dd { margin: 0; font-weight: 600; font-size: .875rem; }
  .ficha .chip { margin: .75rem 0 0; font-family: var(--font-mono); font-size: .68rem; color: var(--suave); }
  .ficha .btn { margin-top: 1.1rem; }
  .fin { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.5rem 2rem; margin-top: 3.5rem; text-align: center; }
  .fin-texto { font-size: clamp(2.2rem, 5vw, 4.5rem); line-height: .95; letter-spacing: -.035em; margin: 0; }
  .fin-texto i { color: var(--mostaza); }

  /* ---------- Base · 5 Test ---------- */
  .test { background: var(--rosa); color: var(--tinta); padding: clamp(5rem, 12vw, 9rem) 0; }
  .test .plano { display: grid; gap: 3.5rem; }
  .test .lead { margin: 1.4rem 0 0; max-width: 30ch; font-size: 1.15rem; line-height: 1.5; }
  .badge-test { display: grid; place-items: center; width: 4.5rem; aspect-ratio: 1; border-radius: 50%; background: var(--mostaza); color: var(--ciruela); margin: 0 0 1.4rem; }
  .badge-test svg { width: 2rem; height: 2rem; }
  .testform { display: grid; gap: 2.4rem; }
  .preg { border: 0; margin: 0; padding: 0; min-width: 0; }
  .preg legend { padding: 0; margin-bottom: 1rem; font-family: var(--fuente-display); font-weight: 300; font-size: clamp(1.5rem, 2.6vw, 2rem); letter-spacing: -.02em; }
  .preg legend .num { margin-right: .7rem; color: var(--marca-fuerte); font-style: italic; }
  .opciones { display: flex; flex-wrap: wrap; gap: .6rem; }
  .opcion { cursor: pointer; border: 1.5px solid var(--suave); border-radius: 999px; padding: .65rem 1.25rem; font-size: .9rem; font-weight: 600; transition: background-color .25s var(--friccion), color .25s var(--friccion), border-color .25s var(--friccion); }
  .opcion:hover { border-color: var(--tinta); }
  .opcion:has(:checked) { background: var(--tinta); border-color: var(--tinta); color: var(--fondo); }
  .opcion:has(:focus-visible) { outline: 3px solid var(--tinta); outline-offset: 3px; }
  .test :focus-visible { outline-color: var(--tinta); }
  .resultados { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .resultado { background: var(--fondo); border-radius: 24px; padding: 1rem; }
  .resultado .nombre { margin: .75rem 0 0; font-family: var(--fuente-display); font-weight: 300; font-size: 1.6rem; letter-spacing: -.02em; }
  .resultado .meta { margin: 0; font-size: .875rem; color: var(--suave); }

  /* ---------- Test por pasos (Stepper) ----------
     Arriba, el indicador: puntos unidos por una línea que se llena (--friccion), el punto actual crece y los hechos dibujan
     su check con stroke-dashoffset. La pregunta sale por su máscara (240 ms, --encastre) y la nueva sube (900 ms, --friccion)
     con las opciones en cascada de 30 ms; "Volver" hace la reversa simétrica. Con .st-on (lo pone el script) solo se ve el paso actual. */
  .st-prog { position: relative; }
  .st-linea { position: absolute; left: 12.5%; right: 12.5%; top: 13px; height: 2px; background: color-mix(in srgb, var(--tinta) 16%, transparent); }
  .st-relleno { display: block; height: 100%; background: var(--marca); transform-origin: 0 50%; transform: scaleX(var(--p, 0)); transition: transform .9s var(--friccion); }
  .st-pasos { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .st-paso { position: relative; z-index: 1; display: grid; justify-items: center; gap: 8px; }
  .st-dot { position: relative; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; border: 2px solid color-mix(in srgb, var(--tinta) 38%, transparent); background: var(--rosa); transition: transform .7s var(--friccion), background-color .5s var(--friccion), border-color .5s var(--friccion); }
  .st-pt { width: 8px; height: 8px; border-radius: 50%; background: #fff; transform: scale(0); transition: transform .6s var(--friccion); }
  .st-chk { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 1; stroke-dashoffset: 1; transition: stroke-dashoffset .55s var(--friccion); }
  .st-et { font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--suave); transition: color .5s var(--friccion); }
  .st-paso[data-estado="actual"] .st-dot { transform: scale(1.32); background: var(--marca); border-color: var(--marca); }
  .st-paso[data-estado="actual"] .st-pt { transform: scale(1); }
  .st-paso[data-estado="actual"] .st-et { color: var(--tinta); }
  .st-paso[data-estado="hecho"] .st-dot { background: var(--tinta); border-color: var(--tinta); }
  .st-paso[data-estado="hecho"] .st-chk { stroke-dashoffset: 0; transition-delay: .18s; }
  .st-on .st-pane:not(.st-actual) { display: none; }
  .st-etapa { position: relative; --sal: -170%; --ent: 170%; --cps: 0 0 100% 0; --cpe: 100% 0 0 0; }
  .st-etapa[data-dir="atras"] { --sal: 170%; --ent: -170%; --cps: 100% 0 0 0; --cpe: 0 0 100% 0; }
  .st-etapa .rise { display: block; transform: none; transition: transform .9s var(--friccion) calc(var(--s, 0) * 30ms); }
  .st-etapa[data-fase="sale"] .rise { transform: translateY(var(--sal)); transition: transform .24s var(--encastre) calc(min(var(--s, 0), 8) * 12ms); }
  .st-etapa[data-fase="llega"] .rise { transform: translateY(var(--ent)); transition: none; }
  .st-etapa .rise.activo { will-change: transform; }
  /* Cada opción sube dentro de su propia máscara (el relleno deja ver el borde y el aro de foco) */
  .op-mask { overflow: hidden; padding: 4px; margin: -4px; }
  .op-mask > .opcion { display: block; }
  .st-etapa .resultado { clip-path: inset(0 round 24px); transition: clip-path .9s var(--friccion) calc(var(--s, 0) * 30ms); }
  .st-etapa[data-fase="sale"] .resultado { clip-path: inset(var(--cps) round 24px); transition: clip-path .24s var(--encastre); }
  .st-etapa[data-fase="llega"] .resultado { clip-path: inset(var(--cpe) round 24px); transition: none; }
  .preg legend:focus, .res .eyebrow:focus { outline: none; }
  .st-pie { display: flex; align-items: center; gap: 12px; }
  .st-pie .btn { padding: .7rem 1.3rem; font-size: .88rem; }
  .st-pie .btn[disabled] { color: color-mix(in srgb, var(--tinta) 38%, transparent); border-color: color-mix(in srgb, var(--tinta) 14%, transparent); cursor: default; transform: none; }
  .st-pie small { color: var(--suave); font-size: .8rem; }

  /* ---------- Base · 6 Proceso ---------- */
  .proceso { background: var(--fondo); padding: clamp(5rem, 12vw, 9rem) 0; }
  .proceso .etiqueta-proceso { font-family: var(--fuente-cuerpo); font-size: .72rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--marca-fuerte); margin: 0; }
  .pasos { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .paso { position: relative; background: var(--superficie); border: 1px solid var(--linea); border-radius: 28px; padding: 1.75rem; isolation: isolate; }
  .numeral { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--marca); color: #fff; font-family: var(--fuente-display); font-style: italic; font-size: 1.5rem; line-height: 1; }
  .paso h3 { margin: 1.2rem 0 0; font-size: 2.1rem; }
  .paso p { margin: .7rem 0 0; color: var(--suave); line-height: 1.5; }
  .fantasma { display: none; }
  .barras { display: none; }

  /* ---------- Base · 7 Cómo ayudar ---------- */
  .ayuda { background: var(--fondo); padding: clamp(5rem, 12vw, 9rem) 0; }
  /* Tarjetas (con foco que sigue al puntero: src/scripts/foco.ts, variante terracota .spot-claro) */
  .ayuda-lista { list-style: none; margin: 4rem 0 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
  .ayuda-lista li { min-width: 0; border: 1px solid var(--linea); border-radius: 24px; background: var(--superficie); padding: 1.5rem 1.5rem 1.75rem; }
  .icono-ayuda { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: color-mix(in srgb, var(--marca) 12%, transparent); color: var(--marca-fuerte); }
  .ayuda-lista h3 { margin: 1.5rem 0 0; font-size: 2rem; line-height: 1; overflow-wrap: break-word; }
  .ayuda-lista p { margin: .8rem 0 0; color: var(--suave); line-height: 1.55; overflow-wrap: break-word; }

  /* ---------- Base · 8 Equipo ---------- */
  .equipo { background: var(--superficie); padding: clamp(5rem, 12vw, 9rem) 0; }
  .equipo-lista { list-style: none; margin: 4rem 0 0; padding: 0; display: grid; gap: 2.5rem 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .equipo-lista li { min-width: 0; }
  .avatar { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 50%; color: #fff; font-family: var(--fuente-display); font-weight: 600; font-size: 1.5rem; }
  .equipo-lista h3 { margin: 1.4rem 0 0; font-size: 1.9rem; line-height: 1; }
  .equipo-lista .rol { margin: .6rem 0 0; color: var(--marca-fuerte); }
  .equipo-lista .texto { margin: .8rem 0 0; color: var(--suave); line-height: 1.55; }

  /* ---------- Base · 9 Preguntas ----------
     Escritorio (>= 900 px): maestro-detalle. La lista va a la izquierda y cada respuesta
     se coloca, en posición absoluta, en el panel de la derecha: abrir una pregunta no mueve la columna.
     Móvil: acordeón anclado arriba; la altura se anima con interpolate-size. */
  .preguntas-grid { position: relative; display: grid; gap: 3rem; }
  .faq { border-top: 1px solid var(--tinta); }
  .pregunta { border-bottom: 1px solid var(--linea); }
  /* Fila: el fondo tintado es un ::before con clip-path (crece al abrirse); el texto y el icono van por encima.
     El relleno lateral es fijo en todas las filas, así abrir una pregunta no mueve el texto ni la columna. */
  .pregunta summary { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; cursor: pointer; list-style: none; padding: 1.6rem 1.25rem; font-family: var(--fuente-display); font-weight: 300; font-size: clamp(1.3rem, 2.4vw, 1.9rem); letter-spacing: -.02em; line-height: 1.15; }
  .pregunta summary::-webkit-details-marker { display: none; }
  .pregunta summary::before { content: ""; position: absolute; inset: 0; border-radius: 16px; background: color-mix(in srgb, var(--marca) 8%, transparent); clip-path: inset(0 100% 0 0 round 16px); transition: clip-path .5s var(--friccion); }
  .pregunta[open] summary::before { clip-path: inset(0 0 0 0 round 16px); }
  .pregunta summary .mask, .pregunta summary .icono { position: relative; }
  .pregunta summary .mask { flex: 1; transition: color .4s var(--friccion); }
  .pregunta[open] summary .mask { color: var(--marca-fuerte); font-weight: 400; }
  .barra-activa { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; border-radius: 4px 0 0 4px; background: var(--marca); transform: scaleY(0); transform-origin: 50% 0; transition: transform .5s var(--friccion); }
  .pregunta[open] .barra-activa { transform: scaleY(1); }
  .pregunta .icono { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: color-mix(in srgb, var(--marca) 12%, transparent); color: var(--marca-fuerte); font-size: 1.6rem; line-height: 1; transition: background-color .4s var(--friccion), color .4s var(--friccion); }
  .pregunta[open] .icono { background: var(--marca); color: #fff; }
  details.pregunta .icono { transition: transform .6s var(--friccion), background-color .4s var(--friccion), color .4s var(--friccion); }
  details.pregunta[open] .icono { transform: rotate(45deg); }
  .respuesta { color: var(--suave); font-size: clamp(.9rem, 1vw, 1rem); line-height: 1.6; }
  .respuesta p { margin: 0; }
  .respuesta .resp-num { margin: 0 0 .9rem; color: var(--marca-fuerte); }
  .respuesta .mask { display: block; overflow: hidden; padding-block: .14em .22em; margin-block: -.14em -.22em; }
  .respuesta .sube { display: block; }
  .pregunta .respuesta .sube { transform: translateY(-170%); transition: transform .25s var(--encastre); }
  .pregunta[open] .respuesta .sube { transform: none; transition: transform .6s var(--friccion); }
  @starting-style { .pregunta[open] .respuesta .sube { transform: translateY(110%); } }
  /* details.pregunta (no solo .pregunta): iguala la especificidad de la hoja global de FAQ y gana en el orden */
  details.pregunta::details-content { transition: content-visibility .3s allow-discrete, block-size .5s var(--friccion); overflow: clip; }
  details.pregunta[open]::details-content { block-size: auto; }
  details.pregunta:not([open])::details-content { block-size: 0; }
  @starting-style { details.pregunta[open]::details-content { block-size: 0; } }
  .pregunta .respuesta { padding: 0 3.5rem 1.8rem 0; }

  /* ---------- Base · 10 Contacto ---------- */
  .cierre { background: var(--marca); color: #fff; padding: clamp(5rem, 12vw, 8rem) 0 2rem; }
  .iris { display: none; }
  .cierre .plano { display: grid; gap: clamp(2.5rem, 6vw, 4.5rem); }
  .cierre h2 { font-size: clamp(3.5rem, 13vw, 11rem); letter-spacing: -.05em; line-height: .9; text-align: center; margin: 0; }
  .cierre-grid { display: grid; gap: 2.5rem; align-items: start; }
  .cierre-texto { position: relative; }
  .cierre-texto p { margin: 0; max-width: 24ch; font-family: var(--fuente-display); font-weight: 300; font-size: clamp(1.5rem, 2.6vw, 2.2rem); line-height: 1.2; letter-spacing: -.02em; }
  .huella-marca { display: none; }
  .huella-cierre { width: 100%; height: auto; opacity: .2; }
  .tarjeta-form { background: var(--fondo); color: var(--tinta); border-radius: 28px; padding: clamp(1.5rem, 4vw, 2.75rem); }
  .tarjeta-form form > * + * { margin-top: 1.4rem; }
  .campos-fila { display: grid; gap: 1.4rem; }
  .campo label { display: block; margin-bottom: .35rem; font-size: .7rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--suave); }
  .campo input, .campo select, .campo textarea { width: 100%; border: 0; border-bottom: 1.5px solid var(--suave); border-radius: 0; background: transparent; padding: .5rem 0; font: inherit; font-size: 1.05rem; color: var(--tinta); transition: border-color .25s var(--friccion); }
  .campo textarea { resize: vertical; }
  .campo input:focus, .campo select:focus, .campo textarea:focus { border-bottom-color: var(--marca-fuerte); }
  .campo input:focus-visible, .campo select:focus-visible, .campo textarea:focus-visible { outline-offset: 4px; border-radius: 4px; }
  .error { margin: 0; font-size: .875rem; font-weight: 600; color: var(--marca-fuerte); }
  .demo { margin: 0; text-align: center; font-size: .75rem; color: var(--suave); }
  .exito-caja { padding: 2.5rem 0; text-align: center; }
  .gracias { margin: 1.25rem 0 .5rem; font-family: var(--fuente-display); font-weight: 300; font-size: 2rem; letter-spacing: -.02em; }
  .exito circle { stroke-dasharray: 151; stroke-dashoffset: 151; animation: trazo .7s var(--friccion) forwards; }
  .exito path { stroke-dasharray: 36; stroke-dashoffset: 36; animation: trazo .4s .55s var(--friccion) forwards; }
  @keyframes trazo { to { stroke-dashoffset: 0; } }
  .pie-cierre { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 1.5rem; padding-top: 1.25rem; border-top: 1px solid rgb(255 255 255 / .3); font-size: .85rem; color: rgb(255 255 255 / .9); }
  .pie-cierre p { margin: 0; }

  /* ---------- Base · pantallas anchas ---------- */
  @media (min-width: 820px) {
    .portada-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); text-align: left; justify-items: start; }
    .portada .kick { justify-content: flex-start; }
    .cta-portada { justify-content: flex-start; }
    .escenario { justify-self: center; }
    .retrato-mensaje { width: min(30vw, 300px); }
  }
  @media (min-width: 900px) {
    .preguntas-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); column-gap: var(--hueco-faq); min-height: 18rem; }
    /* Panel de respuesta: columna derecha, desde la primera fila hasta el final de la lista (misma banda vertical).
       El porcentaje sale del ancho del grid (fr = 1 y 1.2). Una regla fina marca su borde izquierdo. */
    .pregunta .respuesta {
      position: absolute; top: 0; bottom: 0;
      left: calc((100% - var(--hueco-faq)) / 2.2 + var(--hueco-faq));
      width: calc((100% - var(--hueco-faq)) * 1.2 / 2.2);
      padding: clamp(.6rem, 1.8svh, 1.2rem) 0 0 2.2rem;
      border-left: 1px solid color-mix(in srgb, var(--tinta) 35%, transparent);
    }
    .respuesta .resp-num { margin-bottom: 1.1rem; }
    .respuesta .resp-texto { font-family: var(--fuente-display); font-weight: 300; font-size: clamp(1.35rem, 2vw, 1.9rem); line-height: 1.3; letter-spacing: -.015em; color: var(--tinta); max-width: 30ch; }
    .pregunta::details-content { block-size: auto; }
    .pregunta:not([open])::details-content { block-size: auto; }
    /* Hilo fino desde la fila abierta hasta el panel de respuesta (ocupa exactamente el hueco entre columnas) */
    .pregunta summary::after { content: ""; position: absolute; left: 100%; top: 50%; width: var(--hueco-faq); height: 1px; background: var(--marca); transform: scaleX(0); transform-origin: 0 50%; transition: transform .5s var(--friccion); }
    .pregunta[open] summary::after { transform: scaleX(1); }
  }
  @media (min-width: 1024px) {
    .test .plano { grid-template-columns: 1fr 1.1fr; align-items: start; gap: 5rem; }
    .cierre-grid { grid-template-columns: 1fr 1.15fr; }
    .campos-fila { grid-template-columns: 1fr 1fr; gap: 0 1.5rem; }
    .huella-marca { display: block; width: 6rem; margin-top: 2.5rem; }
  }

  /* =====================================================================
     MODO MAZO · html.escenas
     Una escena a la vez, a pantalla completa. Tres fases por cambio:
     1 despedida (los textos suben y se cierran) → 2 morph (anclas) → 3 llegada (los textos suben).
     ===================================================================== */


  /* Documento fijo: el desplazamiento lo hacen las escenas, no la página */
  html.escenas, html.escenas body { overflow: hidden; height: 100%; overscroll-behavior: none; }
  html.escenas .cabecera { view-transition-name: cabecera; }
  html.escenas .diapo { position: fixed; inset: 0; overflow: hidden auto; overscroll-behavior: contain; scrollbar-width: thin; padding: 84px 0 0; box-sizing: border-box; margin: 0; }
  html.escenas .diapo:not(.activa) { display: none; }
  html.escenas .diapo.activa { display: block; }
  html.escenas .diapo > .plano { height: 100%; box-sizing: border-box; display: flex; flex-direction: column; justify-content: safe center; gap: clamp(1rem, 3svh, 2.2rem); max-width: none; padding-block: clamp(12px, 3svh, 36px) clamp(18px, 4svh, 44px); }
  html.escenas .diapo h2[tabindex="-1"], html.escenas .diapo h1[tabindex="-1"] { outline: none; }
  html.escenas .pista-hint { display: block; position: absolute; left: 50%; bottom: 22px; translate: -50% 0; color: var(--suave); white-space: nowrap; }
  html.escenas .hint { display: block; margin: 1rem 0 0; color: #d9cbd6; font-size: .9rem; max-width: 34ch; }
  html.escenas .galeria .hint { display: none; }
  html.escenas .mask { display: block; overflow: hidden; padding-block: .14em .22em; padding-inline: .3em; margin-block: -.14em -.22em; margin-inline: -.3em; }
  html.escenas .sube { display: block; }
  html.escenas .mask > .sube { will-change: transform; }
  html.escenas .fondo-ancla { display: block; position: absolute; inset: 0; background: var(--menta); overflow: hidden; }
  html.escenas .test .fondo-ancla { background: var(--rosa); }
  html.escenas .iris { display: block; position: absolute; inset: 0; background: var(--marca); overflow: hidden; }
  html.escenas .motivo { position: absolute; width: min(90vmin, 52rem); right: -14%; bottom: -18%; color: color-mix(in srgb, #fff 7%, transparent); transform: rotate(-16deg); pointer-events: none; }
  html.escenas .fondo-ancla .motivo, html.escenas .iris .motivo { color: color-mix(in srgb, currentColor 7%, transparent); }
  html.escenas .mensaje .fondo-ancla .motivo { color: color-mix(in srgb, var(--tinta) 7%, transparent); }
  html.escenas .test .fondo-ancla .motivo { color: color-mix(in srgb, var(--ciruela) 8%, transparent); }
  html.escenas .cierre { background: var(--marca); color: #fff; }

  /* ---- Fase 1 · despedida (antes de startViewTransition) ----
     Los .sube salen hacia arriba dentro de su máscara; los .revela se cierran; los rótulos (texto dentro de anclas) se borran.
     Las anclas no tienen .sube ni .revela: se quedan como formas. */
  /* Fase 1 dura 240 ms en total: cada .sube empieza con 12 ms de retraso (máximo 8 pasos) y acaba a los 240 ms */
  html.escenas .diapo.saliendo .sube { transform: translateY(-170%); transition: transform calc(240ms - min(var(--k, 0), 8) * 12ms) var(--encastre) calc(min(var(--k, 0), 8) * 12ms); }
  html.escenas .diapo.saliendo .revela { clip-path: inset(0 0 100% 0); transition: clip-path .24s var(--encastre); }
  html.escenas .diapo.saliendo .rotulo { clip-path: inset(0 100% 0 0); transition: clip-path .24s var(--encastre); }
  html.escenas .rotulo { clip-path: inset(0 0 0 0); }

  /* ---- Fase 2 · morph: la escena que llega queda en "llegando": solo formas, sin texto en la captura ---- */
  /* 160 % (no 110 %): con líneas de interlineado ajustado, a 110 % quedaban restos de trazos bajo el borde de la máscara */
  html.escenas .diapo.llegando .sube { transform: translateY(170%); }
  html.escenas .diapo.llegando .revela { clip-path: inset(100% 0 0 0); }
  html.escenas .diapo.llegando .rotulo { clip-path: inset(0 100% 0 0); }
  html.escenas[data-fase="morph"] .diapo .rotulo { clip-path: inset(0 100% 0 0); }

  /* ---- Fase 3 · llegada: los textos suben desde sus máscaras; los rótulos se abren desde el lado de la ancla ---- */
  html.escenas .diapo.entrando .sube { animation: sube .9s var(--friccion) both; animation-delay: calc(var(--k, 0) * 30ms); }
  html.escenas .diapo.entrando .revela { animation: revela .9s var(--friccion) both; animation-delay: calc(var(--k, 0) * 30ms); }
  html.escenas .diapo.entrando .rotulo { animation: rotulo-abre .6s var(--friccion) both; }
  html[data-dir="atras"] .diapo.entrando .rotulo { animation-name: rotulo-abre-der; }
  @keyframes sube { from { transform: translateY(170%); } }
  @keyframes revela { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rotulo-abre { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rotulo-abre-der { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0 0 0 0); } }

  /* ---- Apertura de la portada · html.abriendo (solo carga directa en #inicio, una vez; el script del <head> la activa antes del primer pintado) ----
     Arco: su máscara sube desde abajo. Retrato: sube dentro del arco. Titular: la primera línea empieza en 0 ms; 40 ms entre líneas.
     Rótulo, botones y pista siguen con 30 ms. Cabecera y puntos entran desde sus bordes (solo transform). */
  @keyframes abre-sube { from { transform: translateY(170%); } }
  /* El arco conserva su curva superior durante toda la apertura: el recorte lleva el mismo radio que el arco */
  @keyframes abre-arco { from { clip-path: inset(100% 0 0 0 round 999px 999px 0 0); } to { clip-path: inset(0 0 0 0 round 999px 999px 0 0); } }
  @keyframes abre-retrato { from { transform: translateY(60%); } }
  @keyframes abre-cabecera { from { transform: translateY(-110%); } }
  @keyframes abre-puntos { from { transform: translateX(160%); } }
  html.escenas.abriendo .portada .arco { animation: abre-arco 1s var(--friccion) both; }
  html.escenas.abriendo .portada .retrato-hero { animation: abre-retrato .9s var(--friccion) .3s both; }
  html.escenas.abriendo .portada h1 .mask > .sube { animation: abre-sube .62s var(--friccion) both; }
  html.escenas.abriendo .portada h1 .mask:nth-child(2) > .sube { animation-delay: 40ms; }
  html.escenas.abriendo .portada h1 .mask:nth-child(3) > .sube { animation-delay: 80ms; }
  html.escenas.abriendo .portada .kick .rotulo { animation: rotulo-abre .6s var(--friccion) .24s both; }
  html.escenas.abriendo .portada .cta-portada > a:nth-child(1) { animation: revela .6s var(--friccion) .27s both; }
  html.escenas.abriendo .portada .cta-portada > a:nth-child(2) { animation: revela .6s var(--friccion) .30s both; }
  html.escenas.abriendo .portada .pista-hint { animation: revela .6s var(--friccion) .33s both; }
  html.escenas.abriendo .cabecera { animation: abre-cabecera .8s var(--friccion) both; }
  html.escenas.abriendo .puntos-nav { animation: abre-puntos .8s var(--friccion) .15s both; }

  /* ---- Morph: raíz y anclas ---- */
  html.escenas::view-transition-group(root), html.escenas::view-transition-image-pair(root) { animation: none; inset: 0; width: 100%; height: 100%; }
  html.escenas::view-transition-old(root) { animation: none; opacity: 1; transform: none; inset: 0; width: 100%; height: 100%; mix-blend-mode: normal; }
  html.escenas::view-transition-new(root) { animation: funde-raiz .45s var(--encastre) both; inset: 0; width: 100%; height: 100%; mix-blend-mode: normal; }
  /* Sin figuras: el fondo del destino se funde bajo las anclas (ambas capturas ya no tienen texto) */
  @keyframes funde-raiz { from { opacity: 0; } }

  /* Cuatro pares de anclas: cada uno con su retardo (45 ms; 60 ms en la división y la unión de #proceso/#ayuda) y su curva */
  html.escenas { --escalon: 45ms; }
  html.escenas[data-division] { --escalon: 60ms; }
  html.escenas::view-transition-group(ancla-1) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: calc((1 - 1) * var(--escalon)); z-index: 5; }
  html.escenas::view-transition-group(ancla-2) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: calc((2 - 1) * var(--escalon)); z-index: 5; }
  html.escenas::view-transition-group(ancla-3) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: calc((3 - 1) * var(--escalon)); z-index: 5; }
  html.escenas::view-transition-group(ancla-4) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: calc((4 - 1) * var(--escalon)); z-index: 5; }

  html.escenas::view-transition-image-pair(ancla-1) { isolation: isolate; overflow: hidden; animation: radio-1 .8s var(--friccion) both; }
  html.escenas::view-transition-image-pair(ancla-2) { isolation: isolate; overflow: hidden; animation: radio-2 .8s var(--friccion) both; }
  html.escenas::view-transition-image-pair(ancla-3) { isolation: isolate; overflow: hidden; animation: radio-3 .8s var(--friccion) both; }
  html.escenas::view-transition-image-pair(ancla-4) { isolation: isolate; overflow: hidden; animation: radio-4 .8s var(--friccion) both; }
  @keyframes radio-1 { from { border-radius: var(--ar-sale-1, 0px); } to { border-radius: var(--ar-entra-1, 0px); } }
  @keyframes radio-2 { from { border-radius: var(--ar-sale-2, 0px); } to { border-radius: var(--ar-entra-2, 0px); } }
  @keyframes radio-3 { from { border-radius: var(--ar-sale-3, 0px); } to { border-radius: var(--ar-entra-3, 0px); } }
  @keyframes radio-4 { from { border-radius: var(--ar-sale-4, 0px); } to { border-radius: var(--ar-entra-4, 0px); } }

  html.escenas::view-transition-old(ancla-1), html.escenas::view-transition-new(ancla-1),
  html.escenas::view-transition-old(ancla-2), html.escenas::view-transition-new(ancla-2),
  html.escenas::view-transition-old(ancla-3), html.escenas::view-transition-new(ancla-3),
  html.escenas::view-transition-old(ancla-4), html.escenas::view-transition-new(ancla-4) { animation: none; height: 100%; width: 100%; object-fit: cover; mix-blend-mode: normal; }
  html.escenas::view-transition-old(ancla-1), html.escenas::view-transition-old(ancla-2),
  html.escenas::view-transition-old(ancla-3), html.escenas::view-transition-old(ancla-4) { opacity: 0; }
  html.escenas::view-transition-new(ancla-1), html.escenas::view-transition-new(ancla-2),
  html.escenas::view-transition-new(ancla-3), html.escenas::view-transition-new(ancla-4) { opacity: 1; }

  /* División y unión (#proceso ↔ #ayuda): las semillas conservan su color mientras viajan y se funden en el icono
     hacia el final (60 % → 40 % de la curva). */
  @keyframes fundido-sale { 0%, 60% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes fundido-entra { 0%, 40% { opacity: 0; } 100% { opacity: 1; } }
  html.escenas[data-division]::view-transition-old(ancla-1) { opacity: 1; animation: fundido-sale .8s var(--friccion) calc((1 - 1) * var(--escalon)) both; }
  html.escenas[data-division]::view-transition-old(ancla-2) { opacity: 1; animation: fundido-sale .8s var(--friccion) calc((2 - 1) * var(--escalon)) both; }
  html.escenas[data-division]::view-transition-old(ancla-3) { opacity: 1; animation: fundido-sale .8s var(--friccion) calc((3 - 1) * var(--escalon)) both; }
  html.escenas[data-division]::view-transition-old(ancla-4) { opacity: 1; animation: fundido-sale .8s var(--friccion) calc((4 - 1) * var(--escalon)) both; }
  html.escenas[data-division]::view-transition-new(ancla-1) { opacity: 1; animation: fundido-entra .8s var(--friccion) calc((1 - 1) * var(--escalon)) both; }
  html.escenas[data-division]::view-transition-new(ancla-2) { opacity: 1; animation: fundido-entra .8s var(--friccion) calc((2 - 1) * var(--escalon)) both; }
  html.escenas[data-division]::view-transition-new(ancla-3) { opacity: 1; animation: fundido-entra .8s var(--friccion) calc((3 - 1) * var(--escalon)) both; }
  html.escenas[data-division]::view-transition-new(ancla-4) { opacity: 1; animation: fundido-entra .8s var(--friccion) calc((4 - 1) * var(--escalon)) both; }

  html.escenas::view-transition-group(cabecera), html.escenas::view-transition-group(puntos) { animation: none; z-index: 10; }
  html.escenas::view-transition-old(cabecera), html.escenas::view-transition-new(cabecera),
  html.escenas::view-transition-old(puntos), html.escenas::view-transition-new(puntos) { animation: none; }
  /* La captura nueva de la cabecera es en vivo (la píldora se desliza en ella); la vieja se oculta para que no se transparente su píldora */
  html.escenas::view-transition-old(cabecera) { opacity: 0; }

  /* Escena 1 · Portada: texto a la izquierda, arco a la derecha */
  html.escenas .portada { background: var(--fondo); }
  html.escenas .portada .plano { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); align-items: center; gap: clamp(1.5rem, 3vw, 3.5rem); justify-items: stretch; text-align: left; }
  html.escenas .portada-grid { display: contents; }
  html.escenas .portada-texto { display: grid; gap: clamp(1rem, 3svh, 2.2rem); justify-items: start; text-align: left; }
  html.escenas .portada .kick { margin: 0; justify-content: flex-start; }
  html.escenas .portada h1 { font-size: clamp(2.6rem, min(7vw, 12.5svh), 6.6rem); line-height: .95; letter-spacing: -.045em; margin: 0; }
  html.escenas .portada h1 .l { display: block; }
  html.escenas .cta-portada { justify-content: flex-start; }
  html.escenas .escenario { width: min(100%, calc(min(66svh, 620px) * .8)); aspect-ratio: 4 / 5; justify-self: center; overflow: clip; }

  /* Escena 2 · Mensaje: fondo menta, texto y retrato centrados */
  html.escenas .mensaje { background: var(--menta); }
  html.escenas .mensaje .plano { align-items: center; text-align: center; position: relative; z-index: 1; }
  html.escenas .mensaje h2 { font-size: clamp(2.2rem, min(5.6vw, 9svh), 5rem); line-height: 1.02; letter-spacing: -.03em; max-width: 16ch; margin: 0; }
  html.escenas .retrato-mensaje { width: min(30vw, 36svh); aspect-ratio: 1; }
  html.escenas .retrato-mensaje svg, html.escenas .insignia svg { width: 100%; height: 100%; display: block; }
  html.escenas .chip-mensaje { font-size: .72rem; }

  /* Escena 3 · Nosotros: insignia y etiqueta arriba, manifiesto grande */
  html.escenas .manif { background: var(--fondo); }
  html.escenas .manif .plano { justify-content: safe center; gap: clamp(1.5rem, 4svh, 3rem); padding-inline: clamp(22px, 8vw, 150px); max-width: none; }
  html.escenas .manif-cab { margin: 0; }
  html.escenas .insignia { width: clamp(3.75rem, 8svh, 5.5rem); }
  html.escenas .manif .txt { font-size: clamp(1.6rem, min(3.8vw, 6.4svh), 3.8rem); line-height: 1.12; max-width: 30ch; }

  /* Escena 4 · Adopta: una ficha grande; la pista se desplaza por pasos */
  html.escenas .galeria { color: var(--fondo); background: var(--ciruela); }
  html.escenas .galeria .plano { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr) auto; gap: clamp(.6rem, 2svh, 1.4rem); max-width: 72rem; }
  html.escenas .galeria .galeria-cab { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(.4rem, 1.2svh, .9rem); }
  html.escenas .galeria .cab { margin: 0; }
  html.escenas .galeria h2 { font-size: clamp(2.4rem, min(6vw, 8.5svh), 5rem); line-height: .9; }
  html.escenas .galeria .bajada { margin: 0; font-size: clamp(.95rem, 1.2vw, 1.05rem); max-width: 60ch; }
  html.escenas .galeria .filtros { margin: clamp(.4rem, 1.2svh, .8rem) 0 0; justify-self: start; }
  html.escenas .galeria .vista { margin-top: 0; height: 100%; min-height: 0; overflow: hidden; min-width: 0; }
  /* Pista: cada paso desplaza exactamente el ancho de la vista (una ficha = el 100 % de la pista) */
  html.escenas #lista-peludos { display: flex; height: 100%; width: 100%; margin: 0; padding: 0; gap: 0; list-style: none; transform: translateX(calc(var(--paso, 0) * -100%)); transition: transform .8s var(--friccion); will-change: transform; }
  html.escenas #lista-peludos.quieta { transition: none; }
  html.escenas #lista-peludos > li { flex: 0 0 100%; width: 100%; min-width: 0; height: 100%; min-height: 0; }
  html.escenas #lista-peludos > li[hidden] { display: none; }
  html.escenas .ficha { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); height: 100%; min-height: 0; border-radius: 30px; }
  html.escenas .ficha .img { height: 100%; aspect-ratio: auto; min-height: 0; }
  html.escenas .ficha .retrato-ficha { width: 84%; }
  html.escenas .ficha .dat { min-height: 0; overflow: hidden auto; overscroll-behavior: contain; scrollbar-width: thin; padding: clamp(1rem, 2.6svh, 2rem) clamp(1.2rem, 2.4vw, 2.4rem); gap: clamp(.6rem, 1.8svh, 1.2rem); }
  html.escenas .ficha h3 { font-size: clamp(2.4rem, min(5vw, 9svh), 5rem); }
  html.escenas .ficha .desc { font-size: clamp(.95rem, min(1.4vw, 2.8svh), 1.3rem); margin-top: .5rem; }
  html.escenas .ficha .chip { margin-top: .5rem; }
  html.escenas .ficha .btn { margin-top: .6rem; }
  html.escenas .fin { margin-top: 0; justify-content: space-between; justify-self: stretch; text-align: left; }
  html.escenas .fin-texto { font-size: clamp(1.8rem, min(3.6vw, 6svh), 3.4rem); }

  /* Escena 5 · Test: texto y formulario lado a lado */
  html.escenas .test { background: var(--rosa); }
  html.escenas .test .plano { display: grid; grid-template-columns: 1fr; align-content: safe center; gap: clamp(1.2rem, 3svh, 2rem); position: relative; z-index: 1; }
  html.escenas .test .lead { margin-top: clamp(.6rem, 1.6svh, 1.2rem); font-size: clamp(1rem, 1.3vw, 1.15rem); }
  html.escenas .test .secc-h { font-size: clamp(2.2rem, min(5vw, 8.5svh), 5rem); }
  html.escenas .test .eyebrow { margin-bottom: clamp(.5rem, 1.4svh, 1rem); }
  html.escenas .badge-test { width: clamp(3.2rem, min(5vw, 8svh), 4.5rem); margin: 0 0 clamp(.6rem, 1.6svh, 1.2rem); }
  html.escenas .testform { gap: clamp(1rem, 2.8svh, 2rem); }
  html.escenas .preg legend { font-size: clamp(1.3rem, min(2.4vw, 3.8svh), 2rem); margin-bottom: clamp(.5rem, 1.4svh, .9rem); }
  html.escenas .opcion { padding: clamp(.45rem, 1.2svh, .65rem) 1.1rem; }
  /* La etapa reserva el alto del resultado (la pila más alta): al pasar de pregunta a resultado nada se mueve */
  html.escenas .st-etapa { min-height: calc(19svh + 6.8rem); }
  html.escenas #resultado .mini { margin-bottom: .6rem; }
  html.escenas .resultados { gap: .7rem; }
  html.escenas .resultado { padding: .6rem; border-radius: 20px; }
  html.escenas .resultado svg { display: block; width: min(100%, 19svh); height: auto; margin-inline: auto; }
  html.escenas .resultado .nombre { font-size: clamp(1.1rem, 2.2svh, 1.5rem); margin-top: .4rem; }

  /* Escena 6 · Proceso: un paso a la vez, con el numeral de la marca y el numeral fantasma detrás */
  html.escenas .proceso { background: var(--fondo); }
  html.escenas .proceso .plano { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto minmax(0, 1fr) auto; position: relative; }
  html.escenas .proceso .etiqueta-proceso { text-align: center; }
  /* Los cuatro pasos comparten una sola celda (grid-area 1 / 1): la pila va centrada y cada paso empieza arriba,
     así título y párrafo quedan en la misma altura en todos (la celda reserva la altura del texto más largo). */
  html.escenas .pasos { position: relative; display: grid; align-content: center; justify-items: stretch; overflow: clip; margin: 0; padding: 0; min-height: 0; height: 100%; }
  html.escenas .paso { grid-area: 1 / 1; position: relative; visibility: hidden; display: grid; grid-template-rows: auto auto; align-content: start; justify-items: center; background: none; border: 0; border-radius: 0; padding: 0; text-align: center; }
  html.escenas .paso.actual, html.escenas .paso.sale { visibility: visible; }
  /* El paso que llega va por encima del que sale: al retroceder, la insignia que sale (en el orden del DOM, después)
     no debe tapar el dígito que entra desde arriba */
  html.escenas .paso.actual { z-index: 1; }
  /* Caja fija del numeral fantasma: el dígito que rueda queda recortado dentro de ella (no pisa el título ni las barras) */
  html.escenas .fantasma { display: flex; align-items: center; justify-content: center; height: 1.2em; padding-inline: .3em; overflow: clip; position: absolute; z-index: -1; left: 50%; top: 50%; translate: -50% -50%; font-family: var(--fuente-display); font-style: italic; font-weight: 300; font-size: min(60vw, 62svh); line-height: 1; color: color-mix(in srgb, var(--marca) 9%, transparent); pointer-events: none; }
  /* La insignia recorta a su propio círculo: el dígito que sale o entra no se ve fuera de ella */
  html.escenas .numeral { width: clamp(4.5rem, min(9vw, 14svh), 8.5rem); height: auto; aspect-ratio: 1; font-size: clamp(2.2rem, min(4.6vw, 7svh), 4.5rem); justify-self: center; overflow: clip; }
  /* Semillas de la división (#proceso → #ayuda): círculos del color de la insignia, detrás de ella (solo son visibles al dividirse) */
  .semilla { display: none; }
  html.escenas .semilla { display: block; position: absolute; left: 0; top: 0; width: 0; height: 0; border-radius: 50%; background: var(--marca); pointer-events: none; }
  /* Italic sin cortar: el rótulo de cada numeral tiene holgura horizontal (compensada con margen) */
  html.escenas .numeral .rotulo, html.escenas .fantasma .rotulo { padding-inline: .14em; margin-inline: -.14em; }
  html.escenas .paso-texto { width: min(100%, 46rem); text-align: center; }
  html.escenas .paso-texto .mask { width: 100%; }
  html.escenas .paso h3 { margin: clamp(.8rem, 2.4svh, 1.6rem) 0 0; font-size: clamp(2.6rem, min(7vw, 11svh), 6.5rem); line-height: .95; }
  html.escenas .paso p { margin: clamp(.6rem, 1.8svh, 1rem) auto 0; max-width: 34ch; font-size: clamp(1rem, 1.5vw, 1.35rem); color: var(--suave); }
  html.escenas .barras { display: flex; justify-content: center; gap: 10px; }
  html.escenas .barras i { position: relative; overflow: hidden; width: 34px; height: 3px; border-radius: 3px; background: rgb(43 29 43 / .15); }
  /* Relleno de la barra: scaleX desde la izquierda; al retroceder se vacía hacia la izquierda */
  html.escenas .barras i::before { content: ""; position: absolute; inset: 0; background: var(--tinta); transform: scaleX(0); transform-origin: 0 50%; transition: transform .6s var(--friccion); }
  html.escenas .barras i.hecha::before { transform: scaleX(1); }

  /* Cambio de paso (cambiarPaso en el script): el saliente sube (o baja al retroceder) dentro de su máscara; el entrante
     sube desde abajo (o desde arriba). Numeral: el dígito "rueda" dentro de su rótulo, que hace de máscara. */
  @keyframes paso-sube { from { transform: translateY(170%); } }
  @keyframes paso-sube-atras { from { transform: translateY(-170%); } }
  @keyframes paso-sale { to { transform: translateY(-170%); } }
  @keyframes paso-sale-atras { to { transform: translateY(170%); } }
  @keyframes odo-entra { from { transform: translateY(100%); } }
  @keyframes odo-entra-atras { from { transform: translateY(-100%); } }
  @keyframes odo-sale { to { transform: translateY(-100%); } }
  @keyframes odo-sale-atras { to { transform: translateY(100%); } }
  html.escenas .paso.llega .paso-texto h3 .sube { animation: paso-sube .6s var(--friccion) both; }
  html.escenas .paso.llega .paso-texto p .sube { animation: paso-sube .6s var(--friccion) 40ms both; }
  html.escenas .paso.llega.atras .paso-texto h3 .sube { animation-name: paso-sube-atras; }
  html.escenas .paso.llega.atras .paso-texto p .sube { animation-name: paso-sube-atras; }
  html.escenas .paso.sale .paso-texto h3 .sube { animation: paso-sale .22s var(--encastre) both; }
  html.escenas .paso.sale .paso-texto p .sube { animation: paso-sale .22s var(--encastre) both; }
  html.escenas .paso.sale.atras .paso-texto h3 .sube { animation-name: paso-sale-atras; }
  html.escenas .paso.sale.atras .paso-texto p .sube { animation-name: paso-sale-atras; }
  html.escenas .paso.llega .numeral .rotulo { animation: odo-entra .6s var(--friccion) both; }
  html.escenas .paso.llega.atras .numeral .rotulo { animation-name: odo-entra-atras; }
  html.escenas .paso.sale .numeral .rotulo { animation: odo-sale .4s var(--encastre) both; }
  html.escenas .paso.sale.atras .numeral .rotulo { animation-name: odo-sale-atras; }
  html.escenas .paso.llega .fantasma .rotulo { animation: odo-entra .8s var(--friccion) both; }
  html.escenas .paso.llega.atras .fantasma .rotulo { animation-name: odo-entra-atras; }
  html.escenas .paso.sale .fantasma .rotulo { animation: odo-sale .5s var(--encastre) both; }
  html.escenas .paso.sale.atras .fantasma .rotulo { animation-name: odo-sale-atras; }

  /* Escena 7 · Cómo ayudar: cuatro tarjetas en fila */
  html.escenas .ayuda { background: var(--fondo); }
  html.escenas .ayuda .plano { justify-content: safe center; }
  html.escenas .ayuda .secc-h { font-size: clamp(2.2rem, min(5.4vw, 9svh), 5rem); }
  html.escenas .ayuda-lista { margin-top: clamp(1rem, 4svh, 3rem); grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(.7rem, 2svh, 1.25rem); }
  html.escenas .ayuda-lista li { padding: clamp(.9rem, 2.6svh, 1.5rem) clamp(1rem, 1.6vw, 1.5rem); }
  html.escenas .ayuda-lista h3 { margin-top: clamp(.8rem, 2.2svh, 1.4rem); font-size: clamp(1.6rem, min(2.6vw, 4.6svh), 2.2rem); }
  html.escenas .ayuda-lista p { font-size: clamp(.9rem, min(1.1vw, 2.2svh), 1rem); margin-top: .5rem; }

  /* Escena 8 · Equipo: fila de cuatro (dos por dos en el móvil) */
  html.escenas .equipo { background: var(--superficie); }
  html.escenas .equipo .plano { justify-content: safe center; }
  html.escenas .equipo .secc-h { font-size: clamp(2.2rem, min(5.4vw, 9svh), 5rem); }
  html.escenas .equipo-lista { margin-top: clamp(1rem, 4svh, 3rem); grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  html.escenas .avatar { width: clamp(3.5rem, min(5.4vw, 9svh), 5rem); height: clamp(3.5rem, min(5.4vw, 9svh), 5rem); font-size: clamp(1.2rem, 2.4svh, 1.5rem); }
  html.escenas .equipo-lista h3 { margin-top: clamp(.8rem, 2.2svh, 1.3rem); font-size: clamp(1.4rem, min(2.2vw, 3.8svh), 1.9rem); }
  html.escenas .equipo-lista .texto { font-size: clamp(.88rem, min(1vw, 2.2svh), 1rem); margin-top: .5rem; }

  /* Escena 9 · Preguntas: título a la izquierda, respuesta a la derecha (maestro-detalle) */
  html.escenas .preguntas { background: var(--fondo); }
  html.escenas .preguntas .plano { justify-content: safe center; }
  html.escenas .preguntas .secc-h { font-size: clamp(2.2rem, min(5.4vw, 9svh), 4.6rem); }
  html.escenas .pregunta summary { padding-block: clamp(.6rem, 1.8svh, 1.2rem); font-size: clamp(1.1rem, min(1.9vw, 3.4svh), 1.5rem); }
  html.escenas .pregunta .icono { width: 2.2rem; height: 2.2rem; font-size: 1.4rem; }

  /* Escena 10 · Contacto: fondo terracota; formulario de dos columnas; pie al final */
  html.escenas .cierre .plano { display: flex; flex-direction: column; justify-content: safe center; gap: clamp(.8rem, 2.6svh, 2rem); position: relative; z-index: 1; }
  html.escenas .cierre h2 { font-size: clamp(2.8rem, min(8vw, 13svh), 7.5rem); text-align: left; }
  html.escenas .cierre-grid { align-items: center; gap: clamp(1.5rem, 3vw, 3.5rem); }
  html.escenas .cierre-texto p { font-size: clamp(1.2rem, min(2.2vw, 4svh), 2rem); }
  html.escenas .huella-marca { display: block; width: clamp(3.5rem, 9svh, 6rem); margin-top: clamp(.6rem, 2svh, 1.5rem); }
  html.escenas .tarjeta-form { padding: clamp(1rem, 2.6svh, 2.2rem) clamp(1.2rem, 2.6vw, 2.4rem); }
  html.escenas .tarjeta-form form > * + * { margin-top: clamp(.6rem, 1.8svh, 1.2rem); }
  html.escenas .campo input, html.escenas .campo select, html.escenas .campo textarea { font-size: 1rem; }
  html.escenas .campo label { margin-bottom: .2rem; }
  html.escenas .pie-cierre { padding-top: clamp(.6rem, 1.6svh, 1rem); font-size: .8rem; }
  html.escenas .cierre-texto { display: grid; gap: 0; }

  /* Formulario: la tarjeta llega como una hoja de papel puesta sobre el terracota (desde abajo, girada y recortada),
     y luego el formulario se construye dentro: subrayado, etiqueta, select/textarea y, al final, el botón.
     Sin ancla de morph: la tarjeta entra por su propia animación al empezar la fase 3 (.entrando). */
  html.escenas .campo { position: relative; }
  html.escenas .campo input, html.escenas .campo select, html.escenas .campo textarea { border-bottom-color: transparent; }
  html.escenas .campo::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 1.5px; background: var(--suave); transform-origin: 0 50%; transition: background-color .25s var(--friccion); }
  html.escenas .campo:focus-within::after { background: var(--marca-fuerte); }
  /* Llegando: la hoja y el formulario quedan aparcados (no se ven en la captura del morph) */
  html.escenas .diapo.llegando .tarjeta-form { transform: translateY(18%) rotate(-3.5deg); clip-path: inset(100% 0 0 0 round 28px); }
  html.escenas .diapo.llegando .campo::after { transform: scaleX(0); }
  html.escenas .diapo.llegando .campo-cierra { clip-path: inset(0 0 100% 0); }
  html.escenas .diapo.llegando .btn-enviar { clip-path: inset(0 100% 0 0 round 999px); }
  /* Salida (fase 1, 240 ms como máximo): los campos se cierran y la hoja baja */
  html.escenas .diapo.saliendo .tarjeta-form { transform: translateY(18%) rotate(-3.5deg); clip-path: inset(100% 0 0 0 round 28px); transition: transform .24s var(--encastre), clip-path .24s var(--encastre); }
  html.escenas .diapo.saliendo .campo::after { transform: scaleX(0); transition: transform .2s var(--encastre); }
  html.escenas .diapo.saliendo .campo-cierra { clip-path: inset(0 0 100% 0); transition: clip-path .2s var(--encastre); }
  html.escenas .diapo.saliendo .btn-enviar { clip-path: inset(0 100% 0 0 round 999px); transition: clip-path .2s var(--encastre); }
  /* Llegada (fase 3) */
  @keyframes hoja { from { transform: translateY(18%) rotate(-3.5deg); clip-path: inset(100% 0 0 0 round 28px); } to { transform: none; clip-path: inset(0 round 28px); } }
  @keyframes linea { from { transform: scaleX(0); } }
  @keyframes recorte { from { clip-path: inset(0 0 100% 0); } }
  @keyframes pastilla { from { clip-path: inset(0 100% 0 0 round 999px); } to { clip-path: inset(0 round 999px); } }
  /* Tiempos: la hoja se asienta en 0,6 s; los campos empiezan a 120 ms con 40 ms entre ellos (dura 0,45 s cada uno);
     el botón crece desde su borde izquierdo a 360 ms. Todo el formulario queda listo unos 0,8 s después de empezar la fase 3. */
  html.escenas .diapo.entrando .tarjeta-form { animation: hoja .6s var(--friccion) both; }
  html.escenas .diapo.entrando .campo::after { animation: linea .45s var(--friccion) both; animation-delay: calc(120ms + var(--c, 0) * 40ms); }
  html.escenas .diapo.entrando .campo .sube { animation: sube .45s var(--friccion) both; animation-delay: calc(120ms + var(--c, 0) * 40ms); }
  html.escenas .diapo.entrando .campo-cierra { animation: recorte .45s var(--encastre) both; animation-delay: calc(120ms + var(--c, 0) * 40ms); }
  html.escenas .diapo.entrando .btn-enviar { animation: pastilla .4s var(--friccion) .36s both; }
  html.escenas .diapo.entrando .btn-enviar .sube { animation: sube .4s var(--friccion) .4s both; }

  /* Puntos de navegación: píldora fija a la derecha (abajo al centro en el móvil) */
  .puntos-nav { display: none; }
  html.escenas .puntos-nav { display: block; position: fixed; z-index: 40; right: clamp(10px, 1.6vw, 22px); top: 50%; translate: 0 -50%; view-transition-name: puntos; background: var(--fondo); border: 1px solid var(--linea); border-radius: 999px; padding: 10px 6px; box-shadow: 0 6px 20px rgb(0 0 0 / .12); }
  /* Cada enlace es un área de 24 px; el punto visible se dibuja centrado dentro con ::before */
  html.escenas .puntos-nav ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  html.escenas .puntos-nav a { position: relative; display: block; width: 24px; height: 24px; border-radius: 50%; }
  html.escenas .puntos-nav a::before { content: ""; position: absolute; inset: 6px; border-radius: 50%; border: 1.5px solid var(--tinta); background: transparent; transition: background-color .4s var(--friccion), transform .4s var(--friccion); }
  html.escenas .puntos-nav a:hover::before { transform: scale(1.2); }
  html.escenas .puntos-nav a[aria-current="true"]::before { background: var(--tinta); transform: scale(1.25); }
  html.escenas .puntos-nav a:focus-visible { outline: 2px solid var(--marca); outline-offset: 3px; }

  /* Cabecera: el botón "Quiero adoptar" viaja solo entre preguntas y contacto (data-cabecera); su texto se borra y se abre */
  html.escenas #cta-cabecera .rotulo { transition: clip-path .5s var(--friccion); }
  html[data-fase="salida"][data-cabecera] #cta-cabecera .rotulo { clip-path: inset(0 100% 0 0); transition: clip-path .24s var(--encastre); }
  html[data-fase="morph"][data-cabecera] #cta-cabecera .rotulo { clip-path: inset(0 100% 0 0); transition: none; }

  /* ---------- Modo mazo · móvil (< 820 px) ---------- */
  @media (max-width: 819px) {
    /* Reserva abajo para la píldora de puntos (40 px + 16 px) en todas las escenas */
    html.escenas .diapo { padding-bottom: 64px; }
    html.escenas .portada .plano { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    html.escenas .portada-texto { justify-items: center; text-align: center; }
    html.escenas .portada h1 { font-size: clamp(2.4rem, min(11vw, 9svh), 3.6rem); }
    html.escenas .cta-portada { justify-content: center; }
    html.escenas .escenario { width: min(56vw, calc(min(30svh, 300px) * .8)); }
