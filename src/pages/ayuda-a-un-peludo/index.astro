    /* Cómo ayudar en el móvil: cuatro tarjetas compactas en 2×2, arriba de la píldora de puntos (alto = píldora + 16 px) */
    html.escenas .ayuda { padding-bottom: 56px; }
    html.escenas .ayuda .plano { gap: clamp(.5rem, 1.6svh, 1rem); }
