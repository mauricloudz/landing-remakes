    /* "Haz el test" apilado: la pregunta arriba y el botón debajo, todo por encima de la píldora */
    html.escenas .fin { flex-direction: column; flex-wrap: nowrap; justify-content: center; align-items: stretch; gap: .4rem; text-align: center; }
