  .filete { display: block; width: 100%; height: 2px; margin-top: clamp(16px, 4svh, 36px); background: var(--marcaclara); }
  .pie .sub { margin: 28px 0 0; color: var(--claro2); font-size: 17px; }
  .pie .enl { display: flex; flex-wrap: wrap; gap: 12px; margin: 32px 0 0; font-size: clamp(18px, 2vw, 26px); font-weight: 600; letter-spacing: -.03em; }
  .pie .enl a { display: inline-block; padding: 12px 26px; border: 1px solid rgb(255 255 255 / .3); border-radius: 999px; transition: border-color .25s var(--friccion), color .25s var(--friccion); }
  .pie .enl a:hover { border-color: var(--marcaclara); color: var(--marcaclara); }

  /* ---------- Semillas y navegador de puntos: solo existen en modo escenas ---------- */
  .semilla, .puntos-nav { display: none; }

  /* =====================================================================
     MODO ESCENAS · html.escenas
     Una escena a la vez, a pantalla completa. Tres fases por cambio:
     1 despedida (los textos suben y se cierran) → 2 transformación (anclas) → 3 llegada (los textos suben).
     ===================================================================== */

  html.escenas, html.escenas body { overflow: hidden; height: 100%; }
  html.escenas .nav { view-transition-name: cabecera; }
  html.escenas, html.escenas body { overscroll-behavior: none; }
  html.escenas .diapo { position: fixed; inset: 0; overflow: hidden auto; overscroll-behavior: contain; scrollbar-width: thin; padding: var(--nav) 0 0; box-sizing: border-box; margin: 0; display: none; background: var(--fondo); }
  html.escenas .diapo.activa { display: block; }
  html.escenas .como, html.escenas .autor { background: var(--noche); color: var(--claro); }
  html.escenas .diapo > .plano { height: 100%; box-sizing: border-box; display: flex; flex-direction: column; justify-content: safe center; gap: clamp(.6rem, 2svh, 1.6rem); max-width: none; margin: 0; padding: clamp(8px, 2svh, 24px) calc(var(--gut) + 36px) clamp(14px, 3svh, 36px) var(--gut); }
  html.escenas .puntos-nav { display: block; position: fixed; z-index: 40; top: 50%; right: calc(clamp(10px, 1.6vw, 22px) + var(--sb, 0px)); translate: 0 -50%; view-transition-name: puntos; background: var(--fondo); border: 1px solid var(--linea); border-radius: 999px; padding: 10px 6px; box-shadow: 0 6px 20px rgb(0 0 0 / .18); }
  html.escenas .puntos-nav ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  html.escenas .puntos-nav a { position: relative; display: block; width: 24px; height: 24px; border-radius: 50%; }
  html.escenas .puntos-nav a::before { content: ""; position: absolute; inset: 6px; border-radius: 50%; border: 1.5px solid var(--tinta); transition: background-color .4s var(--friccion), transform .4s var(--friccion); }
