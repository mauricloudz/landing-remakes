  @keyframes revela { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rotulo-abre { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rotulo-abre-der { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0 0 0 0); } }

