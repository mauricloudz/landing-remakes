  /* ---------- Base · lo que no existía (columna izquierda), botón y teléfonos ---------- */
  .col-izq .nt-h { margin: 0; font-size: clamp(30px, 4vw, 52px); font-weight: 700; line-height: 1; letter-spacing: -.05em; }
  /* Las siete filas miden lo mismo (la más alta manda), aunque alguna pase a dos líneas en una pantalla estrecha */
  .col-izq ul { display: grid; grid-auto-rows: 1fr; margin: 24px 0 0; padding: 0; list-style: none; }
  .col-izq li { display: flex; align-items: center; padding: 15px 0; border-top: 1px solid var(--linea); font-size: clamp(16px, 1.35vw, 19px); line-height: 1.4; letter-spacing: -.01em; }
  .col-izq li:last-child { border-bottom: 1px solid var(--linea); }
  .col-izq .rl { display: flex; gap: 16px; width: 100%; }
  .col-izq .ni { flex: none; width: 22px; color: var(--marca); font-size: 12px; font-weight: 600; line-height: 1.9; font-variant-numeric: tabular-nums; }
  /* Botón: marca sólida, texto blanco (contraste 5,5:1), 48 px o más de alto. La sombra va en el contenedor: el clip-path del botón no la corta */
  .accion { align-self: flex-start; margin-top: 40px; filter: drop-shadow(0 10px 12px rgb(47 91 234 / .3)); }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 30px; border-radius: 999px; background: var(--marca); color: #fff; font-size: 16px; font-weight: 600; letter-spacing: -.01em; transition: background-color .25s var(--friccion); }
  .btn .fl { display: inline-block; margin-left: .15em; transition: transform .25s var(--friccion); }
  .btn:hover { background: var(--marca-fuerte); }
  .btn:hover .fl { transform: translateX(5px); }
  .tels { display: flex; align-items: flex-start; justify-content: center; gap: clamp(18px, 3vw, 44px); }
  .tel { width: clamp(130px, 16vw, 230px); margin: 0; }
  .tel.t2 { margin-top: clamp(28px, 6vw, 80px); }
  /* Teléfono tipo iPhone 17 Pro Max, todo en CSS. Medidas en cqw (ancho del teléfono = 100): marco de aluminio 1,7,
     bisel negro 2,2 y pantalla de 92,2 con proporción 440:956 y esquinas de 12,5 % de su ancho. Alto total = 2,081 × ancho. */
  .tel, .tel-giro { container-type: inline-size; position: relative; --alu: linear-gradient(135deg, #8fa3c7 0%, #3d5280 13%, #1f2e4f 36%, #2a3c63 62%, #4a5f8c 86%, #a3b5d6 100%); --bt: linear-gradient(90deg, #5d6f94, #1a2644); }
  .cuerpo { position: relative; padding: 1.7cqw; border-radius: 15.4cqw; background: var(--alu); box-shadow: inset 0 0 0 .22cqw rgb(200 214 240 / .5), inset 0 0 .8cqw .2cqw rgb(255 255 255 / .14), 0 12cqw 18cqw -12cqw rgb(22 24 29 / .55); }
  .bisel { padding: 2.2cqw; border-radius: 13.7cqw; background: #000; box-shadow: 0 0 0 .18cqw rgb(0 0 0 / .55); }
  .pantalla { position: relative; overflow: hidden; aspect-ratio: 440 / 956; border-radius: 11.5cqw; background: #0b0b0d; }
  .pantalla > img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .pantalla::after { content: ""; position: absolute; inset: 0; background: linear-gradient(155deg, rgb(255 255 255 / .1), transparent 34%); pointer-events: none; }
  .isla { position: absolute; z-index: 1; top: 2.4cqw; left: 50%; width: 28%; height: 3.6%; translate: -50% 0; border-radius: 999px; background: #000; }
  /* Botones laterales: acción y volumen a la izquierda; encendido y control de cámara a la derecha */
  .tel::before, .tel::after, .tel-giro::before, .tel-giro::after { content: ""; position: absolute; top: 0; width: 1cqw; height: 100%; pointer-events: none; }
  .tel::before, .tel-giro::before { left: -.75cqw; border-radius: .6cqw 0 0 .6cqw; background: var(--bt) 0 19cqw / 100% 5.5cqw no-repeat, var(--bt) 0 30cqw / 100% 10cqw no-repeat, var(--bt) 0 43cqw / 100% 10cqw no-repeat; }
  .tel::after, .tel-giro::after { right: -.75cqw; transform: scaleX(-1); background: var(--bt) 0 40cqw / 100% 16cqw no-repeat, var(--bt) 0 100cqw / 100% 11cqw no-repeat; }
  .tel.vuela .cuerpo, .tel.vuela::before, .tel.vuela::after { visibility: hidden; }
  /* Copia real (DOM) del teléfono "Después" que gira a horizontal antes del cambio de escena */
  .tel-giro { position: fixed; margin: 0; transform-origin: 50% 50%; }
  /* Vista previa dentro de la pantalla del teléfono que gira: un clon de la escena vecina, en una caja del tamaño del viewport,
     contra-rotada +90° (el teléfono queda a -90°) y escalada para cubrir la pantalla; el controlador pone su tamaño y escala */
  /* En pantallas estrechas el teléfono no gira: la vista previa va derecha (sin la contra-rotación) */
  .tel-giro.vertical .vista-previa { rotate: none; }
  .tel-giro .vp { position: absolute; inset: 0; pointer-events: none; clip-path: inset(100% 0 0 0); }
  .tel-giro .vista-previa { position: absolute; left: 50%; top: 50%; translate: -50% -50%; rotate: 90deg; transform-origin: 50% 50%; overflow: hidden; pointer-events: none; }
  html.escenas .vista-previa > .diapo { display: block; position: absolute; inset: 0; }
  /* Al entrar en la pantalla (giro hacia la escena vecina) la isla y el brillo se retiran: la captura nueva no los lleva */
  .tel-giro .isla { transition: scale .3s var(--encastre); }
  .tel-giro .pantalla::after { transition: opacity .3s var(--encastre); }
  .tel-giro.cierra .isla { scale: 0; }
  .tel-giro.cierra .pantalla::after { opacity: 0; }
  .tel figcaption { margin-top: 14px; color: var(--suave); font-size: 11px; letter-spacing: .12em; text-align: center; text-transform: uppercase; }
  /* ---------- Base · cómo está hecho y autor (fondo oscuro) ---------- */
  .como, .autor { background: var(--noche); color: var(--claro); }
  .como .plano { padding-top: calc(var(--nav) + 32px); padding-bottom: 56px; }
  .como h2 { margin: 0; font-size: clamp(44px, 8vw, 128px); font-weight: 700; line-height: .92; letter-spacing: -.06em; }
  .pista-h { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin: 48px 0 0; padding: 0; list-style: none; }
  .card { padding: 28px; border: 1px solid rgb(255 255 255 / .12); border-radius: 20px; background: var(--noche2); }
