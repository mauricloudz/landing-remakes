  html.escenas::view-transition-image-pair(ancla-3) { isolation: isolate; overflow: hidden; animation: radio-3 .8s var(--friccion) both; }
  html.escenas::view-transition-image-pair(ancla-4) { isolation: isolate; overflow: hidden; animation: radio-4 .8s var(--friccion) both; }
  @keyframes radio-1 { from { border-radius: var(--ar-sale-1, 0px); } to { border-radius: var(--ar-entra-1, 0px); } }
  @keyframes radio-2 { from { border-radius: var(--ar-sale-2, 0px); } to { border-radius: var(--ar-entra-2, 0px); } }
  @keyframes radio-3 { from { border-radius: var(--ar-sale-3, 0px); } to { border-radius: var(--ar-entra-3, 0px); } }
  @keyframes radio-4 { from { border-radius: var(--ar-sale-4, 0px); } to { border-radius: var(--ar-entra-4, 0px); } }
  html.escenas::view-transition-old(ancla-1), html.escenas::view-transition-new(ancla-1),
  html.escenas::view-transition-old(ancla-2), html.escenas::view-transition-new(ancla-2),
  html.escenas::view-transition-old(ancla-3), html.escenas::view-transition-new(ancla-3),
  html.escenas::view-transition-old(ancla-4), html.escenas::view-transition-new(ancla-4) { animation: none; height: 100%; width: 100%; object-fit: cover; mix-blend-mode: normal; }
  html.escenas::view-transition-old(ancla-1), html.escenas::view-transition-old(ancla-2),
  html.escenas::view-transition-old(ancla-3), html.escenas::view-transition-old(ancla-4) { opacity: 0; }
  html.escenas::view-transition-new(ancla-1), html.escenas::view-transition-new(ancla-2),
  html.escenas::view-transition-new(ancla-3), html.escenas::view-transition-new(ancla-4) { opacity: 1; }

  /* ---- Movimiento direccional (data-sale / data-entra): el elemento sale o entra de la pantalla trasladándose, 45 ms entre elementos.
