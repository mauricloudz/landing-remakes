  html.escenas::view-transition-group(ancla-3) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: calc(2 * var(--escalon)); z-index: 5; }
  html.escenas::view-transition-group(ancla-4) { animation-duration: .8s; animation-timing-function: var(--friccion); animation-delay: calc(3 * var(--escalon)); z-index: 5; }
