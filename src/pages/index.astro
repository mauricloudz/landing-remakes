---
import Base from '../layouts/Base.astro';
import Comparador from '../components/galeria/Comparador.astro';
import Marco from '../components/galeria/Marco.astro';
import Metricas from '../components/galeria/Metricas.astro';
import { Image } from 'astro:assets';
import { proyectos, decisiones, tecnologias } from '../data/galeria';
import peludoAntesD from '../assets/galeria/peludo-antes-desktop.png';
import peludoDespuesD from '../assets/galeria/peludo-despues-desktop.png';
import peludoAntesM from '../assets/galeria/peludo-antes-movil.png';
import peludoDespuesM from '../assets/galeria/peludo-despues-movil.png';
import meetAntesD from '../assets/galeria/meet-antes-desktop.png';
import meetDespuesD from '../assets/galeria/meet-despues-desktop.png';
import meetAntesM from '../assets/galeria/meet-antes-movil.png';
import meetDespuesM from '../assets/galeria/meet-despues-movil.png';

const base = import.meta.env.BASE_URL;
const imagenes = {
  peludo: { ad: peludoAntesD, dd: peludoDespuesD, am: peludoAntesM, dm: peludoDespuesM },
  meet: { ad: meetAntesD, dd: meetDespuesD, am: meetAntesM, dm: meetDespuesM },
} as const;
// Mismos anchos en todas las capturas de escritorio: el navegador reutiliza los archivos entre escenas.
const anchosD = [640, 960, 1440];
const anchosM = [230, 460, 780];
const sizesVentana = '(min-width: 901px) min(26vw, 420px), 60vw';
const sizesMarco = '(min-width: 1024px) 42vw, 94vw';
const sizesMovil = '(min-width: 901px) min(15vw, 250px), 36vw';

// Cinco escenas, en orden. El nombre lo lee el lector de pantalla en el navegador de escenas.
const escenas = [
  ['inicio', 'Portada'], ['peludo', 'Ayuda a un Peludo'], ['meet', 'Meet & Coffee'], ['como', 'Cómo está hecho'], ['autor', 'Autor'],
];
---
<Base titulo="Mauricio Poblete · Landing remakes de desarrollo web y UX/UI" descripcion="Portafolio de Mauricio Poblete: desarrollo web, diseño UX/UI y AI engineering. Dos landings rehechas con Astro y comparadas con métricas Lighthouse." tema="galeria" tipo="CollectionPage">
  <Fragment slot="head">
    <!-- Decide el modo escenas antes del primer pintado (mismas condiciones que el script del módulo: alto >= 560; el módulo añade histéresis al redimensionar).
         Sin hash y con movimiento permitido, la portada se abre con su entrada (clase abriendo, 1,5 s). -->
    <script is:inline>
      (function () {
        var h = document.documentElement;
        var hash = location.hash.slice(1);
        h.dataset.inicio = hash;
        var mazo = !!document.startViewTransition && matchMedia('(prefers-reduced-motion: no-preference)').matches && innerHeight >= 560;
        if (!mazo) return;
        h.classList.add('escenas');
        if (!hash) {
          h.classList.add('abriendo');
          setTimeout(function () { h.classList.remove('abriendo'); }, 1500);
        }
      })();
    </script>
  </Fragment>

  <nav class="nav" aria-label="Principal">
    <a class="brand" href="#inicio"><i aria-hidden="true"></i>Landing remakes</a>
    <div class="lw">
      <ul role="list">
        <li><a href="#peludo"><span class="ext">Ayuda a un </span>Peludo</a></li>
        <li><a href="#meet">Meet<span class="ext"> &amp; Coffee</span></a></li>
        <li><a href="#como">Cómo<span class="ext"> está hecho</span></a></li>
      </ul>
    </div>
  </nav>

  <main id="contenido">
    <!-- 1 · INICIO: texto a la izquierda y dos ventanas inclinadas a la derecha. La píldora y cada ventana son anclas -->
    <section id="inicio" class="diapo inicio activa" aria-labelledby="t-intro" data-reticula-viva>
      <!-- Fondo: la retícula de puntos fija es de todas las escenas (.diapo::before); aquí solo va la capa de marca que se ve cerca del puntero (ver reticula.ts) -->
      <div class="retic" aria-hidden="true"><i class="r2"></i></div>
      <div class="plano">
        <div class="in-texto">
          <p class="pill" data-ancla-sale="2" data-hacia="peludo meet" data-sale="arriba"><i aria-hidden="true"></i><span class="rotulo">Proyecto de <a href="https://github.com/mauricloudz">Mauricio Poblete</a></span></p>
          <h1 id="t-intro" class="h1" tabindex="-1">
            <span class="hl"><span class="mask"><span class="sube">Mis landings de</span></span></span>
            <span class="hl"><span class="mask"><span class="sube">estudiante, rehechas</span></span></span>
            <span class="hl"><span class="mask"><span class="sube">y mejoradas.</span></span></span>
          </h1>
          <p class="lead revela">Tomé dos sitios que hice mientras aprendía y los reconstruí con un stack moderno y un flujo de desarrollo asistido por IA. Mismo contenido de base, mucho más sitio. Avanza para comparar.</p>
        </div>
        <div class="rise">
          {proyectos.map((p, i) => (
            <figure class={`fr fr${i + 1}`}>
              <figcaption class="cap"><span class="rotulo"><b>0{i + 1}</b> {p.nombre}</span></figcaption>
              <Marco url={p.ruta} data-ancla-sale="1" data-hacia={p.id} data-sale={i === 0 ? 'izquierda' : 'derecha'}>
                <div class="comp solo">
                  <Image src={imagenes[p.id as keyof typeof imagenes].dd} alt="" widths={anchosD} sizes={sizesVentana} width={1440} loading="eager" fetchpriority="low" decoding="async" />
                </div>
              </Marco>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Cada proyecto es UNA escena con dos pasos: "Lo que no existía" a la izquierda,
     el marco con el comparador al centro y las métricas a la derecha; luego el marco sube y entran los teléfonos. -->
    {proyectos.map((p, i) => {
      const img = imagenes[p.id as keyof typeof imagenes];
      return (
        <section class="diapo proy" id={p.id} aria-labelledby={`t-${p.id}`} data-paso="0">
          <div class="plano">
            <header class="cab">
              <p class="estado" data-ancla-entra="2" data-desde="inicio" data-sale="arriba" data-entra="arriba"><span class="rotulo">0{i + 1} · {p.tipo} · original de {p.anio}</span></p>
              <h2 id={`t-${p.id}`} tabindex="-1"><span class="mask"><span class="sube">{p.nombre}</span></span></h2>
            </header>
            <div class="zona">
              <!-- Panel de foco: una tarjeta blanca que envuelve la columna activa y se desplaza a la otra; su borde lleva un haz que gira (solo escritorio) -->
              <i class="pf" aria-hidden="true"><i class="haz"></i></i>
              <div class="col col-izq" data-sale="izquierda" data-entra="izquierda">
                <h3 class="nt-h">Lo que no existía</h3>
                <ul role="list">
                  {p.novedades.map((n, j) => <li><div class="rl"><span class="ni" aria-hidden="true">0{j + 1}</span><span class="nt">{n}</span></div></li>)}
                </ul>
              </div>
              <div class="centro">
                <div class="stage">
                  <p class="mini leyenda"><span class="rotulo"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 8l-4 4 4 4M17 8l4 4-4 4M3 12h18" /></svg>Desliza para ver el antes y el después</span></p>
                  <Marco url={p.ruta} data-ancla-entra="1" data-desde="inicio" data-sale="arriba" data-entra="arriba">
                    <Comparador antes={img.ad} despues={img.dd} nombre={p.nombre} anio={p.anio} sizes={sizesMarco} />
                  </Marco>
                </div>
                <div class="tels">
                  <figure class="tel t1" data-sale="abajo" data-entra="abajo"><div class="cuerpo"><div class="bisel"><div class="pantalla"><Image src={img.am} alt={`${p.nombre} original en un teléfono`} widths={anchosM} sizes={sizesMovil} width={460} loading="lazy" decoding="async" /><i class="isla" aria-hidden="true"></i></div></div></div><figcaption class="revela">Antes, en móvil</figcaption></figure>
                  <figure class="tel t2" data-sale="abajo" data-entra="abajo"><div class="cuerpo"><div class="bisel"><div class="pantalla"><Image src={img.dm} alt={`${p.nombre} nuevo en un teléfono`} widths={anchosM} sizes={sizesMovil} width={460} loading="lazy" decoding="async" /><i class="isla" aria-hidden="true"></i></div></div></div><figcaption class="revela">Después, en móvil</figcaption></figure>
                </div>
              </div>
              <div class="col col-der panel" data-sale="derecha" data-entra="derecha">
                <Metricas nombre={p.nombre} antes={p.antes} despues={p.despues} />
              </div>
            </div>
            <div class="accion"><a class="btn" href={`${base}${p.ruta}`}><span class="rotulo">Ver el sitio nuevo<span class="sr-only"> de {p.nombre}</span> <span class="fl" aria-hidden="true">→</span></span></a></div>
          </div>
        </section>
      );
    })}

    <!-- 6 · CÓMO ESTÁ HECHO: fondo oscuro; seis decisiones, una por paso. El título no se mueve -->
    <section class="diapo como" id="como" aria-labelledby="t-como" data-paso="0">
      <div class="plano">
        <h2 id="t-como" tabindex="-1"><span class="mask"><span class="sube">Cómo está hecho</span></span></h2>
        <div class="pistaw" data-sale="izquierda" data-entra="derecha">
          <ul class="pista-h" role="list">
            {decisiones.map((d, i) => (
              <li class:list={['card', 'spot', { actual: i === 0 }]}><span class="cn" aria-hidden="true"><span class="rotulo">0{i + 1}</span></span><div class="ct"><h3><span class="mask"><span class="sube">{d.t}</span></span></h3><p class="revela">{d.d}</p></div></li>
            ))}
          </ul>
        </div>
        <ul class="chips" role="list" data-sale="abajo" data-entra="abajo">
          {tecnologias.map((t, i) => <li class="chip"><span class="rotulo">{t}</span></li>)}
        </ul>
        <div class="riel" aria-hidden="true" data-ancla-sale="4" data-hacia="autor" data-sale="derecha" data-entra="izquierda"><i></i></div>
      </div>
      <span class="semilla" data-clon="forma" data-modelo=".card.actual" data-ancla-sale="1" data-hacia="autor" aria-hidden="true"></span>
      <span class="semilla" data-clon="forma" data-modelo=".card.actual" data-ancla-sale="2" data-hacia="autor" aria-hidden="true"></span>
      <span class="semilla" data-clon="forma" data-modelo=".card.actual" data-ancla-sale="3" data-hacia="autor" aria-hidden="true"></span>
    </section>

    <!-- 7 · AUTOR: el pie de la página, como escena final -->
    <section class="diapo autor" id="autor" aria-label="Autor" data-reticula-viva>
      <div class="retic" aria-hidden="true"><i class="r2"></i></div>
      <div class="plano">
        <footer class="pie">
          <h2 tabindex="-1"><span class="hecho revela">Creado por</span><span class="mask"><span class="sube">Mauricio Poblete</span></span></h2>
          <i class="filete" aria-hidden="true" data-ancla-entra="4" data-desde="como" data-entra="izquierda"></i>
          <p class="sub revela">Desarrollo web, diseño UX/UI y AI engineering</p>
          <p class="enl">
            <a href="https://github.com/mauricloudz" data-ancla-entra="1" data-desde="como" data-entra="abajo"><span class="rotulo">GitHub</span></a>
            <a href="https://www.linkedin.com/in/mauricio-poblete-saez-b089569a" data-ancla-entra="2" data-desde="como" data-entra="abajo"><span class="rotulo">LinkedIn</span></a>
            <a href="mailto:mpoblete.s3@gmail.com" data-ancla-entra="3" data-desde="como" data-entra="abajo"><span class="rotulo">Correo</span></a>
          </p>
        </footer>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      var h = document.documentElement;
      if (!h.classList.contains('escenas') || !h.dataset.inicio) return;
      var sec = null;
      try {
        var el = document.getElementById(decodeURIComponent(h.dataset.inicio));
        sec = el && el.closest('main > section.diapo');
      } catch (e) { sec = null; }
      if (!sec) return;
      document.querySelectorAll('main > section.diapo.activa').forEach(function (s) { s.classList.remove('activa'); });
      sec.classList.add('activa');
    })();
  </script>

  <nav class="puntos-nav" aria-label="Escenas">
    <ol>
      {escenas.map(([id, nombre]) => (
        <li><a href={`#${id}`}><span class="sr-only">{nombre}</span></a></li>
      ))}
    </ol>
  </nav>
  <p id="aviso" class="sr-only" role="status" aria-live="polite"></p>
</Base>

<style is:global>
  /* =====================================================================
     Caso de estudio · galería
     Orden: base (documento normal, todo legible, sin nada fijo salvo la barra) → modo escenas (html.escenas).
     El modo escenas solo se activa con startViewTransition, movimiento permitido y alto >= 560 px (una vez activo, solo se apaga por debajo de 480 px).
     Curvas permitidas: --friccion (llegadas) y --encastre (salidas y cortes). Sin otras curvas.
     ===================================================================== */
  :root {
    --nav: 72px; --gut: clamp(18px, 5vw, 72px); --noche: #16181d; --noche2: #1f2229; --claro: #f6f5f1; --claro2: #b7bbc7; --marcaclara: #9db4ff;
    --friccion: cubic-bezier(0.16, 1, 0.3, 1);
    --encastre: cubic-bezier(0.87, 0, 0.13, 1);
  }
  main a:focus-visible, .nav a:focus-visible, .puntos-nav a:focus-visible { outline: 3px solid var(--marca); outline-offset: 3px; }
  .como a:focus-visible, .autor a:focus-visible { outline-color: var(--marcaclara); }
  .mini { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: var(--suave); }
  .diapo { position: relative; scroll-margin-top: var(--nav); }
  .rotulo { display: inline-block; padding-block: .14em .22em; margin-block: -.14em -.22em; }
  .mask { display: block; overflow: hidden; padding-block: .14em .22em; padding-inline: .3em; margin-block: -.14em -.22em; margin-inline: -.3em; }
  .sube, .revela { display: block; }
  .diapo h1[tabindex="-1"]:focus, .diapo h2[tabindex="-1"]:focus { outline: none; }

  /* ---------- Barra superior ---------- */
  .nav { position: fixed; z-index: 50; top: 10px; left: clamp(10px, 2.4vw, 32px); right: clamp(10px, 2.4vw, 32px); display: flex; align-items: center; justify-content: space-between; height: 50px; padding: 0 8px 0 20px; border: 1px solid rgb(22 24 29 / .12); border-radius: 999px; background: rgb(246 245 241 / .92); backdrop-filter: blur(12px); }
  .nav .brand { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; letter-spacing: -.01em; }
  .nav .brand i { width: 9px; height: 9px; border-radius: 50%; background: var(--marca); }
  .nav ul { display: flex; gap: 4px; margin: 0; padding: 0; list-style: none; font-size: 13px; font-weight: 500; }
  .nav ul a { display: block; padding: 8px 10px; border-radius: 999px; }
  .nav ul a:hover { background: rgb(22 24 29 / .06); }
  .nav .ext { display: none; }
  .nav .lw { --pill-bg: var(--tinta); --pill-fg: var(--fondo); }
  @media (min-width: 700px) { .nav ul a { padding: 8px 14px; } .nav .ext { display: inline; } }

  /* ---------- Marco de navegador ---------- */
  .frame { overflow: clip; border: 1px solid rgb(22 24 29 / .12); border-radius: 14px; background: #fff; box-shadow: 0 50px 90px -40px rgb(22 24 29 / .4), 0 12px 30px -18px rgb(22 24 29 / .27); }
  .frame .bar { display: flex; align-items: center; gap: 6px; height: 34px; padding: 0 14px; border-bottom: 1px solid rgb(22 24 29 / .08); background: #efede7; }
  .frame .bar i { width: 10px; height: 10px; border-radius: 50%; background: rgb(22 24 29 / .18); }
  .frame .bar span { flex: 0 1 260px; height: 20px; margin-left: 12px; padding: 0 12px; overflow: hidden; border-radius: 10px; background: #fff; color: var(--suave); font-size: 11px; line-height: 20px; white-space: nowrap; }
  .frame img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }

  /* ---------- Base · inicio ---------- */
  .plano { position: relative; padding: 0 var(--gut); }
  .inicio .plano { padding-top: calc(var(--nav) + 40px); padding-bottom: 72px; }
  .pill { display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 7px 16px; border: 1px solid var(--linea); border-radius: 999px; background: #fff; color: var(--suave); font-size: 13px; font-weight: 500; }
  .pill i { width: 8px; height: 8px; border-radius: 50%; background: var(--marca); }
  .pill a { color: var(--tinta); font-weight: 600; }
  .pill a:hover { text-decoration: underline; }
  /* Retícula de fondo de TODA la galería (escenas y respaldo): puntos de 26 px, siempre en el mismo sitio del viewport.
     Es un pseudoelemento de cada .diapo (no cuenta como fondo de los textos ni pide red, así no toca el LCP ni el contraste medido).
     En el respaldo con scroll va fija al viewport (background-attachment: fixed); en el modo escenas cada escena ocupa el viewport entero
     y el patrón arranca en el mismo punto, así las View Transitions no la ven saltar. */
  :root { --punto: rgb(22 24 29 / .1); }
  .como, .autor { --punto: rgb(246 245 241 / .1); }
  .diapo::before { content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(circle, var(--punto) 1.1px, transparent 1.8px) 13px 13px / 26px 26px; background-attachment: fixed; }
  .diapo > .plano { z-index: 1; }
  html.escenas .diapo::before { position: fixed; background-attachment: scroll; }
  /* Capa de marca de la portada: solo se ve cerca del puntero */
  .retic { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .retic i { position: absolute; inset: 0; display: block; background-size: 26px 26px; background-position: 13px 13px; }
  .retic .r2 { display: none; background-image: radial-gradient(circle, rgb(47 91 234 / .45) 1.4px, transparent 2.1px); }
  .in-texto { display: flex; flex-direction: column; align-items: flex-start; }
  .h1 { max-width: 15ch; margin: 28px 0 0; font-size: clamp(36px, min(6vw, 10svh), 96px); font-weight: 700; line-height: .94; letter-spacing: -.05em; }
  .hl { display: block; }
  .lead { max-width: 58ch; margin: 28px 0 0; color: var(--suave); font-size: clamp(17px, 1.5vw, 21px); line-height: 1.55; }
  .rise { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin: 56px 0 0; }
  .fr { margin: 0; }
  .cap { margin: 0 0 12px; color: var(--suave); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
  .cap b { margin-right: 8px; color: var(--marca); font-weight: 600; }
  @media (max-width: 900px) { .rise { grid-template-columns: 1fr; } }

  /* ---------- Base · escena de proyecto (documento normal: todo el contenido, una cosa bajo otra) ---------- */
  .proy { border-top: 1px solid var(--linea); }
  .proy .plano { display: flex; flex-direction: column; max-width: 1240px; margin: 0 auto; padding: calc(var(--nav) + 32px) var(--gut) 64px; }
  .cab h2 { margin: 12px 0 0; font-size: clamp(32px, 4vw, 52px); font-weight: 700; line-height: 1; letter-spacing: -.045em; }
  .estado { display: inline-flex; margin: 0; padding: 6px 14px; border: 1px solid var(--linea); border-radius: 999px; background: #fff; color: var(--suave); font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  .zona { display: flex; flex-direction: column; gap: 44px; margin-top: 32px; }
  .centro { display: contents; }
  .stage { order: 0; width: 100%; max-width: 1100px; margin: 0 auto; }
  .col-izq { order: 1; }
  .tels { order: 2; }
  .col-der { order: 3; max-width: 680px; }
  .comp { display: grid; grid-template-columns: 1fr 1fr; background: #fff; }
  .comp.solo { display: block; }
  .pf { display: none; }
  /* Leyenda sobre el marco, fuera de la captura: el rótulo se abre y se cierra por máscara con la escena */
  .leyenda { display: flex; align-items: center; justify-content: center; height: 18px; margin: 0 0 10px; line-height: 1.4; letter-spacing: .14em; }
  .leyenda .rotulo { display: inline-flex; align-items: center; gap: 8px; }
  .leyenda svg { flex: none; color: var(--marca); }

  /* Tabla de métricas: la tabla real (Métrica | Antes | Después) siempre está; en el modo escenas solo se ve una columna de valores
     (odómetro) y el rótulo de la cabecera rueda de «Antes» a «Después» */
  .met { width: 100%; border-collapse: separate; border-spacing: 0; font-variant-numeric: tabular-nums; }
  .met caption { padding-bottom: 12px; text-align: left; caption-side: top; }
  .met thead th { padding: 0 0 8px 16px; color: var(--suave); font-size: 11px; font-weight: 600; letter-spacing: .14em; text-align: right; text-transform: uppercase; }
  .met thead th:first-child { padding-left: 0; text-align: left; }
  .fila > th, .fila > td { border-top: 1px solid var(--linea); padding-top: clamp(4px, 1.2svh, 13px); padding-bottom: clamp(4px, 1.2svh, 13px); vertical-align: middle; }
  .fila .et { padding-right: 12px; color: var(--suave); font-size: 11px; font-weight: 600; letter-spacing: .14em; line-height: 1.4; text-align: left; text-transform: uppercase; }
  .col-ant { padding-left: 16px; color: var(--suave); font-size: 14px; text-align: right; white-space: nowrap; }
  .h-rot { display: none; }
  .viejo { text-decoration: line-through; text-decoration-thickness: 1px; }
  .col-des { min-width: 8.5rem; padding-left: 16px; text-align: right; white-space: nowrap; }
  .vd { position: relative; display: inline-block; color: var(--acento); font-weight: 600; letter-spacing: -.03em; }
  .grande .vd { font-size: clamp(30px, min(4vw, 5svh), 60px); line-height: 1; letter-spacing: -.05em; }
  .det .vd { font-size: clamp(18px, min(1.9vw, 2.8svh), 26px); }
  .barra { display: block; height: 3px; margin-top: clamp(3px, .8svh, 10px); overflow: clip; background: rgb(22 24 29 / .08); }
  .barra i { display: block; height: 100%; background: var(--acento); transform-origin: 0 50%; transform: scaleX(var(--r)); }
  /* Odómetro: una columna por cifra, recortada por su celda (1em de alto); solo se ve en el modo escenas */
  .cnt { display: none; }
  .cnt .rod { display: inline-flex; height: 1em; overflow: hidden; vertical-align: top; }
  .cnt .rc { display: block; transform: translateY(calc(var(--p) * -1em)); }
